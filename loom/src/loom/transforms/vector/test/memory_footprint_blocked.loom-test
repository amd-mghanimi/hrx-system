// ====

// floor(coordinate/4) < floor(extent/8) implies 2*coordinate+2 <= extent.
func.def @different_quotient_scales(%input: buffer, %coordinate_input: index, %extent_input: index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 511)] : index
  %extent = index.assume %extent_input [range(%extent_input, 8, 1023)] : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %base = index.constant 0 : offset
  %left = index.div %coordinate, %c4 : index
  %right = index.div %extent, %c8 : index
  %in_bounds = index.cmp slt, %left, %right : index
  scf.if %in_bounds {
    %origin = index.mul %coordinate, %c2 : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<2xi32>
    test.use %value : vector<2xi32>
  }
  func.return
}

// ----
