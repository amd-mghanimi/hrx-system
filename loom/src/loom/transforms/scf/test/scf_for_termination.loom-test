  %count_increment = scalar.constant 1 : i32
  %result = scf.for %counter = [%begin to %end step %step](%count = %seed : i32) -> (i32) {
    test.use %counter : index
    %next_count = scalar.addi %count, %count_increment : i32
    scf.yield %next_count : i32
  }
  func.return %result : i32
}

