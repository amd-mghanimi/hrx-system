// Writes through a returned byte alias are visible through the selected word
// view and through the independently addressed backing buffer.
func.def inline @packet_byte_alias(%packet: view<4xi32>) -> (view<16xi8>) {
  %bytes = view.bitcast %packet : view<4xi32> -> view<16xi8>
  func.return %bytes : view<16xi8>
}

func.def public @update_packet_byte(%slot: i32, %replacement: i8) -> (i8, i32, i32) {
  %first_slot = scalar.constant 0 : i32
  %second_slot = scalar.cmpi ne, %slot, %first_slot : i32
  %length = index.constant 128 : offset
  %origin = index.constant 16 : offset
  %storage = buffer.alloca<private> align(16) %length : buffer
  %words = buffer.view %storage[%origin] : buffer -> view<24xi32>
  %first = view.subview %words[3] : view<24xi32> -> view<4xi32>
  %second = view.subview %words[8] : view<24xi32> -> view<4xi32>
  %packet = scf.select %second_slot, %second, %first : view<4xi32>
  %pattern = scalar.constant 16909060 : i32
  view.store %pattern, %packet[0] : i32, view<4xi32>
  view.store %pattern, %packet[1] : i32, view<4xi32>
  %bytes = func.call @packet_byte_alias(%packet) : (view<4xi32>) -> (view<16xi8>)
  view.store %replacement, %bytes[5] : i8, view<16xi8>
  %byte = view.load %bytes[0] : view<16xi8> -> i8
  %word = view.load %packet[1] : view<4xi32> -> i32
  %first_address = index.constant 33 : offset
  %second_address = index.constant 53 : offset
  %address = scf.select %second_slot, %second_address, %first_address : offset
  %raw = buffer.load.i8.u %storage[%address]
  func.return %byte, %word, %raw : i8, i32, i32
}

check.case @update_packet_byte_slots {
  %slot = check.param.choice values([0, 1]) : i32
  %replacement = check.literal value(-128) : i8
  %byte, %word, %raw = func.call @update_packet_byte(%slot, %replacement) : (i32, i8) -> (i8, i32, i32)
  %expected_byte = check.literal value(4) : i8
  %expected_word = check.literal value(16941060) : i32
  %expected_raw = check.literal value(128) : i32
  check.expect.equal actual(%byte) expected(%expected_byte) : i8
  check.expect.equal actual(%word) expected(%expected_word) : i32
  check.expect.equal actual(%raw) expected(%expected_raw) : i32
  check.return
}
