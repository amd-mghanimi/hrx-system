// RUN: emit source-low target=amdgpu:gfx942 output=low

// Uniform f64 values retain SGPR storage until a packet requires a VGPR source.
func.def @float64_uniform_add(%lhs_bits: i64, %rhs_bits: i64) -> (f64) {
  %lhs = scalar.bitcast %lhs_bits : i64 to f64
  %rhs = scalar.bitcast %rhs_bits : i64 to f64
  %sum = scalar.addf %lhs, %rhs : f64
  func.return %sum : f64
}

// ----
low.func.def target<amdgpu.cdna3.core> abi(hal_kernel) @float64_uniform_add(%lhs: reg<amdgpu.sgpr x2>, %rhs: reg<amdgpu.sgpr x2>) -> (reg<amdgpu.vgpr x2>) asm {
  %9 = slice %rhs[0] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %10 = v_mov_b32_copy %9
  %11 = slice %rhs[1] : reg<amdgpu.sgpr x2> -> reg<amdgpu.sgpr>
  %12 = v_mov_b32_copy %11
  %13 = concat(%10, %12) : (reg<amdgpu.vgpr>, reg<amdgpu.vgpr>) -> reg<amdgpu.vgpr x2>
  %sum = v_add_f64 %lhs, %13
  return %sum
}
