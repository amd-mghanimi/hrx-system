// RUN: emit source-low target=wasm:simd128 output=low

// Exact Wasm arithmetic contracts not exercised by its kernel-less corpus profile.

func.def @signed_dynamic_stride(%input: buffer, %bias0: index, %stride0: index, %table: buffer) -> (i32) {
  %source_origin = index.constant 0 : offset
  %source = buffer.view %input[%source_origin] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %coordinate = index.cast %signed : i32 to index
  %bias = index.assume %bias0 [range(%bias0, 128, 256)] : index
  %stride = index.assume %stride0 [range(%stride0, 1, 16)] : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [%stride] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<512xi32, %layout>
  %value = view.load %view[%position] : view<512xi32, %layout> -> i32
  func.return %value : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @signed_dynamic_stride(%input: reg<wasm.i32>, %bias: reg<wasm.i32>, %stride: reg<wasm.i32>, %table: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %signed = i32.load %input
  %23 = i32.mul %bias, %stride
  %24 = i32.const 4
  %25 = i32.mul %23, %24
  %26 = i32.mul %signed, %stride
  %28 = i32.mul %26, %24
  %29 = i32.add %25, %28
  %30 = i32.add %table, %29
  %value = i32.load %30
  return %value
}

// ====

// RUN: with-checks emit source-low target=wasm:simd128 output=low
func.def @dynamic_stride_static_bias(%table: buffer, %position0: index, %stride0: index) -> (i8) {
  %position = index.assume %position0 [range(%position0, 0, 31)] : index
  %stride = index.assume %stride0 [range(%stride0, 1, 16)] : index
  %base = index.constant 128 : offset
  %layout = encoding.layout.strided [%stride] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<32xi8, %layout>
  %value = view.load %view[%position] : view<32xi8, %layout> -> i8
  func.return %value : i8
}

// ----
// The dynamic stride product remains separate from the folded byte bias.
CHECK: * = i32.mul %position, %stride
CHECK: * = i32.add %table, *
CHECK: *%value = i32.load8_u * {offset = 128}
CHECK: *return %value

// ====

func.def @signed_wide_source(%input: i64, %table: buffer) -> (i32) {
  %signed = scalar.assume %input [range(%input, -128, 127)] : i64
  %bias = scalar.constant 128 : i64
  %ordinal = scalar.addi %signed, %bias : i64
  %position = index.cast %ordinal : i64 to index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @signed_wide_source(%signed: reg<wasm.i64>, %table: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %13 = i32.const 512
  %14 = i32.wrap_i64 %signed
  %15 = i32.const 4
  %16 = i32.mul %14, %15
  %17 = i32.add %16, %13
  %18 = i32.add %table, %17
  %value = i32.load %18
  return %value
}

// ====

func.def @negative_varying_coefficient(%input: buffer, %table: buffer) -> (i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -1, 0)] : i32
  %coordinate = index.cast %signed : i32 to index
  %c0 = index.constant 0 : index
  %position = index.sub %c0, %coordinate : index
  %word_bytes = index.constant 4 : offset
  %origin = index.scale %position, %word_bytes : index, offset -> offset
  %view = buffer.view %table[%origin] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<wasm.core.simd128> abi(wasm_function) @negative_varying_coefficient(%input: reg<wasm.i32>, %table: reg<wasm.i32>) -> (reg<wasm.i32>) asm {
  %coordinate = i32.load %input
  %c0 = i32.const 0
  %position = i32.sub %c0, %coordinate
  %word_bytes = i32.const 4
  %origin = i32.mul %position, %word_bytes
  %22 = i32.add %table, %origin
  %value = i32.load %22
  return %value
}
