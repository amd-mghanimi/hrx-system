// ====

// A state writer orders earlier readers but does not consume their results.
// RUN: emit low-schedule-query @state_is_not_a_value_consumer kind=order consumer=0,2 per-user-placement-values=%left,%right

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @state_is_not_a_value_consumer(%a: reg<test.i32>, %b: reg<test.i32>, %c: reg<test.i32>) -> (reg<test.i32>) asm {
  %left = test.state.read.i32 %a
  %late = test.mul.i32 %b, %c
  %right = test.state.read.i32 %late
  test.state.assign.i32.immediate 1
  low.br ^consume
^consume:
  %sum = test.add.i32 %left, %right
  return %sum
}

