// Fixing any member constrains the complete required storage chain.
// RUN: emit low-allocation-query @fixed_tied_chain values=%seed,%first,%last fixed=%last:target_id:6:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_tied_chain(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %first = test.tied.any %seed
  %last = test.tied.any %first
  return %last
}

// ----
value %seed: test.i32 -> target_id[6:1]
value %first: test.i32 -> target_id[6:1]
value %last: test.i32 -> target_id[6:1]

// ====

// An offset slice may share fixed storage with its wider source and a tie.
// RUN: emit low-allocation-query @fixed_offset_slice values=%wide,%middle,%last fixed=%wide:target_id:4:4 fixed=%last:target_id:6:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_offset_slice(%wide: reg<test.i32 x4>) -> (reg<test.i32>) asm {
  %middle = slice %wide[2] : reg<test.i32 x4> -> reg<test.i32>
  %last = test.tied.any %middle
  return %last
}

// ----
value %wide: test.i32 -> target_id[4:4]
value %middle: test.i32 -> target_id[6:1]
value %last: test.i32 -> target_id[6:1]

// ====

// Optional transfers stop fixed propagation and preserve a live copy source.
// RUN: emit low-allocation-query @fixed_copy_continuation values=%source,%copy,%last copies=%copy fixed=%source:target_id:2:1 fixed=%last:target_id:6:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_copy_continuation(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %copy = copy %source : reg<test.i32> -> reg<test.i32>
  %last = test.tied.any %copy
  return %source, %last
}

// ----
value %source: test.i32 -> target_id[2:1]
value %copy: test.i32 -> target_id[6:1]
value %last: test.i32 -> target_id[6:1]
copy %source -> %copy: materialized

// ====

// The fixed aggregate constrains concat reservation as well as its own tie.
// RUN: emit low-allocation-query @fixed_concat_continuation values=%left,%right,%packed,%last fixed=%last:target_id:4:4

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fixed_concat_continuation(%left: reg<test.i32 x2>, %right: reg<test.i32 x2>) -> (reg<test.i32 x4>) asm {
  %packed = concat(%left, %right) : (reg<test.i32 x2>, reg<test.i32 x2>) -> reg<test.i32 x4>
  %last = test.early_tied.v4i32 %packed
  return %last
}

// ----
value %left: test.i32 -> target_id[4:2]
value %right: test.i32 -> target_id[6:2]
value %packed: test.i32 -> target_id[4:4]
value %last: test.i32 -> target_id[4:4]

// ====

// Distinct fixed locations cannot split a required chain, even transitively.
// RUN: emit low-allocation-query @conflicting_fixed_chain fixed=%seed:target_id:6:1 fixed=%last:target_id:7:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @conflicting_fixed_chain(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %first = test.tied.any %seed
  // ERROR@+1: BACKEND/049 {first_value_name="seed", first_location_base="6", second_value_name="last", second_location_base="7"}
  %last = test.tied.any %first
  return %last
}

// ====

// Binding diagnostics preserve request order even when the origin is last.
// RUN: emit low-allocation-query @conflicting_origin_last fixed=%last:target_id:6:1 fixed=%first:target_id:6:1 fixed=%seed:target_id:7:1

test.target<low_core> @target

// ERROR@+1: BACKEND/049 {first_value_name="last", first_location_base="6", second_value_name="seed", second_location_base="7"}
low.func.def target<test.low.core>(@target) @conflicting_origin_last(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  %first = test.tied.any %seed
  %last = test.tied.any %first
  return %last
}

// ====

// Each conflicting member is compared against the first request, not the
// required storage origin's later request.
// RUN: emit low-allocation-query @conflicting_members fixed=%last:target_id:6:1 fixed=%seed:target_id:7:1 fixed=%first:target_id:8:1

test.target<low_core> @target

// ERROR@+1: BACKEND/049 {first_value_name="last", first_location_base="6", second_value_name="seed", second_location_base="7"}
low.func.def target<test.low.core>(@target) @conflicting_members(%seed: reg<test.i32>) -> (reg<test.i32>) asm {
  // ERROR@+1: BACKEND/049 {first_value_name="last", first_location_base="6", second_value_name="first", second_location_base="8"}
  %first = test.tied.any %seed
  %last = test.tied.any %first
  return %last
}

// ====

// An optional copy does not authorize overwriting its still-live input.
// RUN: emit low-allocation-query @fixed_copy_live_conflict fixed=%source:target_id:2:1 fixed=%last:target_id:2:1

test.target<low_core> @target

// ERROR@+1: BACKEND/050 {value_name="source", location_kind="target_id", location_base="2", location_count="1"}
low.func.def target<test.low.core>(@target) @fixed_copy_live_conflict(%source: reg<test.i32>) -> (reg<test.i32>, reg<test.i32>) asm {
  %copy = copy %source : reg<test.i32> -> reg<test.i32>
  %last = test.tied.any %copy
  return %source, %last
}
