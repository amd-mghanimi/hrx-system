global.rodata.def @vector_unary_trials = align(4) bytes("00000000010000001100000037000000380000007f000000ff000000ff010000ff7f000000800000ffff000000000100ffffff7f00000080f0ffffffffffffff")

global.rodata.def @vector_signed_trials = align(4) bytes("0080ffff80ffffff81ffffffffffffff00000000010000007f000000ff7f0000")

global.rodata.def @vector_pair_trials = align(4) bytes("000000000000000000000000ffffffffffffffff0000000000000080ffffff7f00000000000000800000003f000080bf0000807f000080ff0000c07f0000c07f0000803f000000400000807f0000807f")

global.rodata.def @vector_control_values = align(4) bytes("00000000ffffffffffffff7f")

global.rodata.def @vector_control_counts = align(4) bytes("00000000010000000300000007000000")

global.rodata.def @vector_mask_trials = align(4) bytes("00000000ffffffff00000080070000000000000000000000ffffff7f0700000000000000000000800000c07f0000807f00000080000000000000803f0000807f0000803f000080ff0000c07f000080bf000000400000807f0000c07f000000c0")

func.def @vector_unary_input(%trial: index) -> (i32) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 15)] : index
  %trial_buffer = global.load @vector_unary_trials : buffer
  %trials = buffer.view %trial_buffer[%origin] : buffer -> view<16xi32>
  %input = view.load %trials[%bounded_trial] : view<16xi32> -> i32
  func.return %input : i32
}

func.def @vector_signed_input(%trial: index) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %pair = index.constant 2 : index
  %bounded_trial = index.assume %trial [range(%trial, 0, 15)] : index
  %input_index = index.div %bounded_trial, %pair : index
  %divisor_index = index.rem %bounded_trial, %pair : index
  %divisor_selector = index.cast %divisor_index : index to i32
  %c0 = scalar.constant 0 : i32
  %negative_divisor = scalar.constant -3 : i32
  %positive_divisor = scalar.constant 3 : i32
  %negative = scalar.cmpi eq, %divisor_selector, %c0 : i32
  %divisor = scf.select %negative, %negative_divisor, %positive_divisor : i32
  %trial_buffer = global.load @vector_signed_trials : buffer
  %trials = buffer.view %trial_buffer[%origin] : buffer -> view<8xi32>
  %input = view.load %trials[%input_index] : view<8xi32> -> i32
  func.return %input, %divisor : i32, i32
}

func.def @vector_pair_input(%trial: index) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %pair = index.constant 2 : index
  %step = index.constant 1 : index
  %bounded_trial = index.assume %trial [range(%trial, 0, 9)] : index
  %first_index = index.mul %bounded_trial, %pair : index
  %second_index = index.add %first_index, %step : index
  %trial_buffer = global.load @vector_pair_trials : buffer
  %trials = buffer.view %trial_buffer[%origin] : buffer -> view<20xi32>
  %first = view.load %trials[%first_index] : view<20xi32> -> i32
  %second = view.load %trials[%second_index] : view<20xi32> -> i32
  func.return %first, %second : i32, i32
}

func.def @vector_control_config(%trial: index) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %count_span = index.constant 4 : index
  %bounded_trial = index.assume %trial [range(%trial, 0, 11)] : index
  %value_index = index.div %bounded_trial, %count_span : index
  %count_index = index.rem %bounded_trial, %count_span : index
  %value_buffer = global.load @vector_control_values : buffer
  %values = buffer.view %value_buffer[%origin] : buffer -> view<3xi32>
  %count_buffer = global.load @vector_control_counts : buffer
  %counts = buffer.view %count_buffer[%origin] : buffer -> view<4xi32>
  %input = view.load %values[%value_index] : view<3xi32> -> i32
  %count = view.load %counts[%count_index] : view<4xi32> -> i32
  func.return %input, %count : i32, i32
}

func.def @vector_mask_input(%trial: index, %input: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %row_size = index.constant 8 : index
  %bounded_trial = index.assume %trial [range(%trial, 0, 2)] : index
  %row = index.mul %bounded_trial, %row_size : index
  %trial_buffer = global.load @vector_mask_trials : buffer
  %trials = buffer.view %trial_buffer[%origin] : buffer -> view<24xi32>
  %values = buffer.view %input[%origin] : buffer -> view<8xi32>
  scf.for %lane = [%begin to %end step %step] {
    %position = index.add %row, %lane : index
    %value = view.load %trials[%position] : view<24xi32> -> i32
    view.store %value, %values[%lane] : i32, view<8xi32>
  }
  func.return
}

func.def @vector_unary_observations(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %word_lanes = index.constant 4 : index
  %byte_lanes = index.constant 16 : index
  %half_lanes = index.constant 8 : index
  %step = index.constant 1 : index
  %narrow_base = index.constant 4 : index
  %half_base = index.constant 20 : index
  %splat_base = index.constant 28 : index
  %results = buffer.view %output[%origin] : buffer -> view<32xi32>
  scf.for %lane = [%begin to %word_lanes step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %unsigned = func.call @vector_unsigned(%input, %lane_i32) : (i32, i32) -> (i32)
    %splat = func.call @vector_ext_splat(%input, %lane_i32) : (i32, i32) -> (i32)
    %splat_index = index.add %splat_base, %lane : index
    view.store %unsigned, %results[%lane] : i32, view<32xi32>
    view.store %splat, %results[%splat_index] : i32, view<32xi32>
  }
  scf.for %lane = [%begin to %byte_lanes step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %value = func.call @vector_narrow(%input, %lane_i32) : (i32, i32) -> (i32)
    %index = index.add %narrow_base, %lane : index
    view.store %value, %results[%index] : i32, view<32xi32>
  }
  scf.for %lane = [%begin to %half_lanes step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %value = func.call @vector_unsigned_short(%input, %lane_i32) : (i32, i32) -> (i32)
    %index = index.add %half_base, %lane : index
    view.store %value, %results[%index] : i32, view<32xi32>
  }
  func.return
}

func.def @vector_unary_reference(%input: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %word_lanes = index.constant 4 : index
  %byte_lanes = index.constant 16 : index
  %half_lanes = index.constant 8 : index
  %step = index.constant 1 : index
  %narrow_base = index.constant 4 : index
  %half_base = index.constant 20 : index
  %splat_base = index.constant 28 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c3_i32 = scalar.constant 3 : i32
  %c7_i32 = scalar.constant 7 : i32
  %c17_i32 = scalar.constant 17 : i32
  %word_high_bit = scalar.constant -2147483648 : i32
  %word_maximum = scalar.constant -1 : i32
  %c0_i8 = scalar.constant 0 : i8
  %c1_i8 = scalar.constant 1 : i8
  %byte_bias = scalar.constant -56 : i8
  %byte_high_bit = scalar.constant -128 : i8
  %byte_maximum = scalar.constant -1 : i8
  %c0_i16 = scalar.constant 0 : i16
  %c5_i16 = scalar.constant 5 : i16
  %half_factor = scalar.constant 257 : i16
  %half_bias = scalar.constant -5536 : i16
  %half_high_bit = scalar.constant -32768 : i16
  %half_maximum = scalar.constant -1 : i16
  %narrow_input = scalar.trunci %input : i32 to i8
  %half_input = scalar.trunci %input : i32 to i16
  %results = buffer.view %output[%origin] : buffer -> view<32xi32>
  scf.for %lane = [%begin to %word_lanes step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0_i32 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1_i32 : i32
    %is_third = scalar.cmpi eq, %lane_i32, %c2_i32 : i32
    %tail0 = scf.select %is_third, %word_maximum, %c7_i32 : i32
    %tail1 = scf.select %is_second, %word_high_bit, %tail0 : i32
    %value = scf.select %is_first, %input, %tail1 : i32
    %biased = scalar.addi %value, %c17_i32 : i32
    %shifted = scalar.shrui %biased, %c3_i32 : i32
    %unsigned = scalar.divui %shifted, %c3_i32 : i32
    %splat_index = index.add %splat_base, %lane : index
    view.store %unsigned, %results[%lane] : i32, view<32xi32>
    view.store %input, %results[%splat_index] : i32, view<32xi32>
  }
  scf.for %lane = [%begin to %byte_lanes step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0_i32 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1_i32 : i32
    %is_third = scalar.cmpi eq, %lane_i32, %c2_i32 : i32
    %tail0 = scf.select %is_third, %byte_high_bit, %c0_i8 : i8
    %tail1 = scf.select %is_second, %byte_maximum, %tail0 : i8
    %value = scf.select %is_first, %narrow_input, %tail1 : i8
    %biased = scalar.addi %value, %byte_bias : i8
    %shifted = scalar.shrui %biased, %c1_i8 : i8
    %result = scalar.extui %shifted : i8 to i32
    %index = index.add %narrow_base, %lane : index
    view.store %result, %results[%index] : i32, view<32xi32>
  }
  scf.for %lane = [%begin to %half_lanes step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0_i32 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1_i32 : i32
    %is_third = scalar.cmpi eq, %lane_i32, %c2_i32 : i32
    %tail0 = scf.select %is_third, %half_high_bit, %c0_i16 : i16
    %tail1 = scf.select %is_second, %half_maximum, %tail0 : i16
    %value = scf.select %is_first, %half_input, %tail1 : i16
    %product = scalar.muli %value, %half_factor : i16
    %biased = scalar.addi %product, %half_bias : i16
    %shifted = scalar.shrui %biased, %c5_i16 : i16
    %result = scalar.extui %shifted : i16 to i32
    %index = index.add %half_base, %lane : index
    view.store %result, %results[%index] : i32, view<32xi32>
  }
  func.return
}

func.def @vector_signed_observations(%input: i32, %divisor: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %short_base = index.constant 4 : index
