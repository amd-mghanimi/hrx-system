// ----
func.def @different_quotient_scales_after_cfg(%input: buffer, %coordinate_input: index, %extent_input: index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 511)] : index
  %extent = index.assume %extent_input [range(%extent_input, 8, 1023)] : index
