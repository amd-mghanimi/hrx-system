  %rows = index.assume %rows_input [range(%rows_input, 8, 255)] : index
  %block = index.assume %block_input [range(%block_input, 0, 127)] : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %base = index.constant 0 : offset
  %extent = index.madd %rows, %c2, %c3 : index
  %count = index.div %extent, %c4 : index
  %in_bounds = index.cmp slt, %block, %count : index
  cfg.cond_br %in_bounds, ^_bb1, ^_bb2
^_bb1:
  %origin = index.mul %block, %c4 : index
  %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
  %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
