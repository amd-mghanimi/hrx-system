// Masking a multiple of three does not preserve divisibility by three.
// With runtime input three, the masked value and its remainder are both two.
func.def device inline @compute_masked_multiple_remainder(%input: index) -> (i32) {
  %value = index.assume %input [range(%input, 3, 9), multiple_of(%input, 3)] : index
  %mask = index.constant 6 : index
  %masked = index.andi %value, %mask : index
  %remainder = index.rem %masked, %mask : index
  %result = index.cast %remainder : index to i32
  func.return %result : i32
}

kernel.def @masked_multiple_remainder() {
  %unit = index.constant 1 : index
  %width = index.constant 32 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: index, %output: buffer) {
  %result = func.call pure @compute_masked_multiple_remainder(%input) : (index) -> (i32)
  %base = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %view = buffer.view %output[%base] : buffer -> view<32xi32>
  view.store %result, %view[%lane] : i32, view<32xi32>
  kernel.return
}

func.def @masked_multiple_remainder_oracle(%input: index, %output: buffer) {
  %result = func.call pure @compute_masked_multiple_remainder(%input) : (index) -> (i32)
  %base = index.constant 0 : offset
  %view = buffer.view %output[%base] : buffer -> view<32xi32>
  %begin = index.constant 0 : index
  %end = index.constant 32 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    view.store %result, %view[%lane] : i32, view<32xi32>
  }
  func.return
}

check.scenario @masked_multiple_remainder_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.literal value(3) : index
    %output = check.generate.fill value(-1) : tensor<32xi32>
    check.compare<@masked_multiple_remainder, @masked_multiple_remainder_oracle>(%input, %output) : (index, tensor<32xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<32xi32>
    }
  }
  check.return
}
