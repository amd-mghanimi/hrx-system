// RUN: pass vector-memory-footprint

// An inclusive block-end guard licenses the preceding packet, not the next.
func.def @inclusive_block_end(%input: buffer, %extent_input: index, %block_end_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %block_end = index.assume %block_end_input [range(%block_end_input, 1, 63)] : index
  %block_width = index.constant 16 : index
  %packet_width = index.constant 4 : index
  %base = index.constant 0 : offset
  %count = index.div %extent, %block_width : index
  %in_bounds = index.cmp sge, %count, %block_end : index
  scf.if %in_bounds {
    %end = index.mul %block_end, %block_width : index
    %origin = index.sub %end, %packet_width : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

// ----
func.def @inclusive_block_end(%input: buffer, %extent_input: index, %block_end_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %block_end = index.assume %block_end_input [range(%block_end_input, 1, 63)] : index
  %block_width = index.constant 16 : index
  %packet_width = index.constant 4 : index
  %base = index.constant 0 : offset
  %count = index.div %extent, %block_width : index
  %in_bounds = index.cmp sge, %count, %block_end : index
  scf.if %in_bounds {
    %end = index.mul %block_end, %block_width : index
    %origin = index.sub %end, %packet_width : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

