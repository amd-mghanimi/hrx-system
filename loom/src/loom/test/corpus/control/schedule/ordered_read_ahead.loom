kernel.def @ordered_guarded_else_depth_3() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%mask: index, %input: buffer, %output: buffer) {
  %depth = index.constant 3 : index
  template.apply<@ordered_guarded_else_rows>(%mask, %input, %output, %depth) : (index, buffer, buffer, index)
  kernel.return
}

// This reference evaluates each output lane independently. Cluster sums use
// serial global reads instead of subgroup operations or workgroup storage.
func.def @ordered_guarded_oracle(%mask: index, %input: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %rows = index.constant 4 : index
  %width = index.constant 128 : index
  %last = index.constant 127 : index
  %cluster_width = index.constant 16 : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<4x2x128xi32>
  %destination = buffer.view %output[%base] : buffer -> view<2x128xi32>
  %identity = scalar.constant 0 : i32
  %multiplier = scalar.constant 3 : i32
  scf.for %lane = [%begin to %width step %step] {
    %peer = index.sub %last, %lane : index
    %cluster = index.div %lane, %cluster_width : index
    %cluster_begin = index.mul %cluster, %cluster_width : index
    %cluster_end = index.add %cluster_begin, %cluster_width : index
    %scalar_result, %reduced_result = scf.for %row = [%begin to %rows step %step](%sum = %identity : i32, %reduced_sum = %identity : i32) -> (i32, i32) {
      %row_bits = index.shrui %mask, %row : index
      %selected_bit = index.andi %row_bits, %step : index
      %active = index.cmp ne, %selected_bit, %begin : index
      %next, %next_reduced = scf.if %active -> (i32, i32) {
        %first = view.load %source[%row, 0, %peer] : view<4x2x128xi32> -> i32
        %second = view.load %source[%row, 1, %peer] : view<4x2x128xi32> -> i32
        %pair = scalar.addi %first, %second : i32
        %cluster_sum = scf.for %member = [%cluster_begin to %cluster_end step %step](%total = %identity : i32) -> (i32) {
          %source_lane = index.sub %last, %member : index
          %first_member = view.load %source[%row, 0, %source_lane] : view<4x2x128xi32> -> i32
          %second_member = view.load %source[%row, 1, %source_lane] : view<4x2x128xi32> -> i32
          %member_pair = scalar.addi %first_member, %second_member : i32
          %next_total = scalar.addi %total, %member_pair : i32
          scf.yield %next_total : i32
        }
        %scaled = scalar.muli %sum, %multiplier : i32
        %scaled_reduced = scalar.muli %reduced_sum, %multiplier : i32
        %updated = scalar.addi %scaled, %pair : i32
        %updated_reduced = scalar.addi %scaled_reduced, %cluster_sum : i32
        scf.yield %updated, %updated_reduced : i32, i32
      } else {
        scf.yield %sum, %reduced_sum : i32, i32
      }
      scf.yield %next, %next_reduced : i32, i32
    }
    view.store %scalar_result, %destination[0, %lane] : i32, view<2x128xi32>
    view.store %reduced_result, %destination[1, %lane] : i32, view<2x128xi32>
  }
  func.return
}

check.scenario @ordered_read_ahead_guarded_consumers {
  // All sixteen masks cover none, all, alternating, and startup/drain-only
  // consumers without ever changing the loop's exact four-row bound.
  check.trial[16](%mask: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%mask] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1024 to 1024) : tensor<1024xi32>
    %output = check.generate.fill value(37) : tensor<2x128xi32>
    check.compare<@ordered_guarded_then_depth_2, @ordered_guarded_oracle>(%mask, %input, %output) : (index, tensor<1024xi32>, tensor<2x128xi32>) -> () {
      check.expect.equal actual(%input) expected(%input) : tensor<1024xi32>
      check.expect.equal actual(%output) expected(%output) : tensor<2x128xi32>
    }
  }
  check.trial[16](%mask: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%mask] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1024 to 1024) : tensor<1024xi32>
    %output = check.generate.fill value(37) : tensor<2x128xi32>
    check.compare<@ordered_guarded_then_depth_3, @ordered_guarded_oracle>(%mask, %input, %output) : (index, tensor<1024xi32>, tensor<2x128xi32>) -> () {
      check.expect.equal actual(%input) expected(%input) : tensor<1024xi32>
      check.expect.equal actual(%output) expected(%output) : tensor<2x128xi32>
    }
  }
  check.trial[16](%mask: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%mask] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1024 to 1024) : tensor<1024xi32>
    %output = check.generate.fill value(37) : tensor<2x128xi32>
    check.compare<@ordered_guarded_else_depth_2, @ordered_guarded_oracle>(%mask, %input, %output) : (index, tensor<1024xi32>, tensor<2x128xi32>) -> () {
      check.expect.equal actual(%input) expected(%input) : tensor<1024xi32>
      check.expect.equal actual(%output) expected(%output) : tensor<2x128xi32>
    }
  }
  check.trial[16](%mask: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%mask] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-1024 to 1024) : tensor<1024xi32>
    %output = check.generate.fill value(37) : tensor<2x128xi32>
    check.compare<@ordered_guarded_else_depth_3, @ordered_guarded_oracle>(%mask, %input, %output) : (index, tensor<1024xi32>, tensor<2x128xi32>) -> () {
      check.expect.equal actual(%input) expected(%input) : tensor<1024xi32>
      check.expect.equal actual(%output) expected(%output) : tensor<2x128xi32>
    }
  }
  check.return
}

