// RUN: pass target-legalize{mode=eager,policy=reference-only}

test.target<low_core> @target {subgroup_size = 8}

// Compact rank validity guards each step. The final broadcast selects the last
// active rank, which exists even when the executing lane is alone in its cluster.
kernel.def target(@target) @sparse_clustered_wide_reduce() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch(%value: i64) {
  %lane = kernel.subgroup.lane.id : index
  %c7 = index.constant 7 : index
  %participates = index.cmp ult, %lane, %c7 : index
  %result = scf.if %participates -> (i64) {
    %total = kernel.subgroup.reduce<addi> %value {cluster_size = 4, cluster_stride = 2} : i64
    scf.yield %total : i64
  } else {
    scf.yield %value : i64
  }
  test.use %result : i64
  kernel.return
}

