kernel.decl @call_lifetimes_kernel() launch(%parameters: buffer, %output: buffer)

check.case @repeated_storage {
  %parameters = check.generate.iota offset(15) step(-14) : tensor<2xi32>
  %output = check.generate.fill value(99) : tensor<30xi32>
  kernel.launch @call_lifetimes_kernel(%parameters, %output) : (tensor<2xi32>, tensor<30xi32>)
  %selected = check.tensor.view %output offset(0) : tensor<30xi32> -> tensor<15xi32>
  %counters = check.tensor.view %output offset(60) : tensor<30xi32> -> tensor<15xi32>
  %expected_selected = check.generate.iota offset(7) step(1) : tensor<15xi32>
  %expected_counters = check.generate.iota offset(2) step(2) : tensor<15xi32>
  check.expect.bitwise actual(%selected) expected(%expected_selected) : tensor<15xi32>
  check.expect.bitwise actual(%counters) expected(%expected_counters) : tensor<15xi32>
  check.return
}
