// RUN: pass cse,cse

// CSE rewrites an entire carrier once when both dimensions and nested function
// children refer to the replaced provider. The retained provider already occurs
// in the same type, so replacement also merges their dependency membership.
func.def @shared_value_type_references(%extent: index, %increment: index, %seed: i32) {
  %width = index.add %extent, %increment : index
  %duplicate_width = index.add %extent, %increment : index
  %callback = test.convert %seed : i32 -> (vector<[%duplicate_width]x[%width]xf32>, vector<[%duplicate_width]x[%duplicate_width]xf32>) -> ()
  test.use %callback : (vector<[%duplicate_width]x[%width]xf32>, vector<[%duplicate_width]x[%duplicate_width]xf32>) -> ()
  func.return
}

// ----
func.def @shared_value_type_references(%extent: index, %increment: index, %seed: i32) {
  %width = index.add %extent, %increment : index
  %callback = test.convert %seed : i32 -> (vector<[%width]x[%width]xf32>, vector<[%width]x[%width]xf32>) -> ()
  test.use %callback : (vector<[%width]x[%width]xf32>, vector<[%width]x[%width]xf32>) -> ()
  func.return
}

// ====
// RUN: pass dce,dce

// A carrier is the last use of a computed dimension. Erasing that carrier drops
// its shared ownership, allowing DCE to erase the dimension as well.
func.def @dead_shared_type_owner(%extent: index, %increment: index, %seed: i32) {
  %width = index.add %extent, %increment : index
  %unused_callback = test.convert %seed : i32 -> (vector<[%width]x[%width]xf32>, vector<[%width]xf32>) -> ()
  func.return
}

// ----
func.def @dead_shared_type_owner(%extent: index, %increment: index, %seed: i32) {
  func.return
}

// ====
// RUN: pass cse,cse

// Replacing a repeated expression updates independent predicate owners and
// nested type attributes. CSE then erases a duplicate attribute owner; a second
// pass consumes the surviving references without stale ownership.
func.def @shared_attribute_references(%extent: index, %increment: index, %value: f32) -> (f32, f32, index, index) {
  %width = index.add %extent, %increment : index
  %duplicate_width = index.add %extent, %increment : index
  %even_width = index.assume %duplicate_width [multiple_of(%duplicate_width, 2)] : index
  %aligned_width = index.assume %duplicate_width [multiple_of(%duplicate_width, 4)] : index
  %annotated = test.attrs %value {nested = {tile = #test.options<mode = precise, element_type = vector<[%duplicate_width]xf32>>}, shape = #test.options<mode = fast, element_type = vector<[%duplicate_width]xf32>>} : f32
  %duplicate_annotation = test.attrs %value {nested = {tile = #test.options<mode = precise, element_type = vector<[%duplicate_width]xf32>>}, shape = #test.options<mode = fast, element_type = vector<[%duplicate_width]xf32>>} : f32
  func.return %annotated, %duplicate_annotation, %even_width, %aligned_width : f32, f32, index, index
}

// ----
func.def @shared_attribute_references(%extent: index, %increment: index, %value: f32) -> (f32, f32, index, index) {
  %width = index.add %extent, %increment : index
  %even_width = index.assume %width [multiple_of(%width, 2)] : index
  %aligned_width = index.assume %width [multiple_of(%width, 4)] : index
  %annotated = test.attrs %value {nested = {tile = #test.options<mode = precise, element_type = vector<[%width]xf32>>}, shape = #test.options<mode = fast, element_type = vector<[%width]xf32>>} : f32
  func.return %annotated, %annotated, %even_width, %aligned_width : f32, f32, index, index
}

// ====
// RUN: pass cse,cse

// Replacement merges duplicate references with an already-present canonical
// value while preserving other dimensions inside nested parameterized arrays.
func.def @mixed_attribute_references(%extent: index, %increment: index, %batch: index, %value: f32) -> (f32) {
  %width = index.add %extent, %increment : index
  %duplicate_width = index.add %extent, %increment : index
  %annotated = test.attrs %value {options = #test.options<mode = fast, element_type = test.variant_set<[#test.options<mode = precise, element_type = vector<[%duplicate_width]x[%width]x[%batch]x[%duplicate_width]xf32>>, #test.options<mode = fast, element_type = vector<[%batch]xf32>>]>>} : f32
  func.return %annotated : f32
}

// ----
func.def @mixed_attribute_references(%extent: index, %increment: index, %batch: index, %value: f32) -> (f32) {
  %width = index.add %extent, %increment : index
  %annotated = test.attrs %value {options = #test.options<mode = fast, element_type = test.variant_set<[#test.options<mode = precise, element_type = vector<[%width]x[%width]x[%batch]x[%width]xf32>>, #test.options<mode = fast, element_type = vector<[%batch]xf32>>]>>} : f32
  func.return %annotated : f32
}

// ====
// RUN: pass cse,cse

// The same parameterized function type belongs to independent value carriers
// and a nested attribute owner. Replacing its provider preserves that canonical
// sharing across both ownership paths and keeps the ordinary operand live.
func.def @value_and_attribute_owners(%extent: index, %increment: index, %left_seed: i32, %right_seed: i32, %value: f32) -> (f32) {
  %width = index.add %extent, %increment : index
  %duplicate_width = index.add %extent, %increment : index
  %left_callback = test.convert %left_seed : i32 -> test.array<(vector<[%duplicate_width]xf32>, vector<[%duplicate_width]xf32>) -> ()>
  %right_callback = test.convert %right_seed : i32 -> test.array<(vector<[%duplicate_width]xf32>, vector<[%duplicate_width]xf32>) -> ()>
  test.use %left_callback, %right_callback : test.array<(vector<[%duplicate_width]xf32>, vector<[%duplicate_width]xf32>) -> ()>, test.array<(vector<[%duplicate_width]xf32>, vector<[%duplicate_width]xf32>) -> ()>
  %annotated = test.attrs %value {nested = {options = #test.options<mode = precise, element_type = test.array<(vector<[%duplicate_width]xf32>, vector<[%duplicate_width]xf32>) -> ()>>}} : f32
  func.return %annotated : f32
}

// ----
func.def @value_and_attribute_owners(%extent: index, %increment: index, %left_seed: i32, %right_seed: i32, %value: f32) -> (f32) {
  %width = index.add %extent, %increment : index
  %left_callback = test.convert %left_seed : i32 -> test.array<(vector<[%width]xf32>, vector<[%width]xf32>) -> ()>
  %right_callback = test.convert %right_seed : i32 -> test.array<(vector<[%width]xf32>, vector<[%width]xf32>) -> ()>
  test.use %left_callback, %right_callback : test.array<(vector<[%width]xf32>, vector<[%width]xf32>) -> ()>, test.array<(vector<[%width]xf32>, vector<[%width]xf32>) -> ()>
  %annotated = test.attrs %value {nested = {options = #test.options<mode = precise, element_type = test.array<(vector<[%width]xf32>, vector<[%width]xf32>) -> ()>>}} : f32
  func.return %annotated : f32
}

// ====
// RUN: pass cse,cse

// Repeated paths through a shared nested type and duplicate predicate operands
// retain exact owners without multiplying references. Both follow replacement.
func.def @shared_attribute_membership(%extent: index, %increment: index, %input: f32) -> (f32) {
  %width = index.add %extent, %increment : index
  %duplicate_width = index.add %extent, %increment : index
  %annotated = test.attrs %input {shape = #test.options<mode = precise, element_type = ((vector<[%duplicate_width]xf32>, vector<[%duplicate_width]xf32>) -> (), (vector<[%duplicate_width]xf32>, vector<[%duplicate_width]xf32>) -> ()) -> ()>} : f32
  %constrained = test.assume %duplicate_width [eq(%duplicate_width, %duplicate_width)] : index
  test.use %constrained : index
  func.return %annotated : f32
}

// ----
func.def @shared_attribute_membership(%extent: index, %increment: index, %input: f32) -> (f32) {
  %width = index.add %extent, %increment : index
  %annotated = test.attrs %input {shape = #test.options<mode = precise, element_type = ((vector<[%width]xf32>, vector<[%width]xf32>) -> (), (vector<[%width]xf32>, vector<[%width]xf32>) -> ()) -> ()>} : f32
  %constrained = test.assume %width [eq(%width, %width)] : index
  test.use %constrained : index
  func.return %annotated : f32
}
