// Select and rotate two runtime strided layouts through structured control
// flow. Each final descriptor addresses the same logical coordinate through a
// nonzero buffer origin, making both selection arms and zero, odd, and even
// trip counts observably distinct.
kernel.def @strided_layout_recurrence() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %count_input: index, %left_pitch_input: index, %right_pitch_input: index, %choose_left: i1) {
  func.call @compute_strided_layout_recurrence(%input, %output, %count_input, %left_pitch_input, %right_pitch_input, %choose_left) : (buffer, buffer, index, index, index, i1)
  kernel.return
}

func.def device inline @compute_strided_layout_recurrence(%input: buffer, %output: buffer, %count_input: index, %left_pitch_input: index, %right_pitch_input: index, %choose_left: i1) {
  %count = index.assume %count_input [range(%count_input, 0, 3)] : index
  %left_pitch = index.assume %left_pitch_input [range(%left_pitch_input, 4, 9)] : index
  %right_pitch = index.assume %right_pitch_input [range(%right_pitch_input, 4, 9)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %origin = index.constant 4 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %left = encoding.layout.strided [%left_pitch, 1] : encoding<layout>
  %right = encoding.layout.strided [%right_pitch, 1] : encoding<layout>
  %selected = scf.if %choose_left -> (encoding<layout>) {
    scf.yield %left : encoding<layout>
  } else {
    scf.yield %right : encoding<layout>
  }

  %for_first, %for_second = scf.for %i = [%c0 to %count step %c1](%first = %left : encoding<layout>, %second = %right : encoding<layout>) -> (encoding<layout>, encoding<layout>) {
    scf.yield %second, %first : encoding<layout>, encoding<layout>
  }

  %remaining, %while_first, %while_second = scf.while(%before_remaining = %count : index, %before_first = %left : encoding<layout>, %before_second = %right : encoding<layout>) -> (index, encoding<layout>, encoding<layout>) {
    %more = index.cmp sgt, %before_remaining, %c0 : index
    scf.condition %more, %before_remaining, %before_first, %before_second : i1, index, encoding<layout>, encoding<layout>
  } do(%body_remaining: index, %body_first: encoding<layout>, %body_second: encoding<layout>) {
    %next_remaining = index.sub %body_remaining, %c1 : index
    scf.yield %next_remaining, %body_second, %body_first : index, encoding<layout>, encoding<layout>
  }

  %for_view = buffer.view %input_aligned[%origin] : buffer -> view<2x2xi32, %for_first>
  %while_view = buffer.view %input_aligned[%origin] : buffer -> view<2x2xi32, %while_first>
  %selected_view = buffer.view %input_aligned[%origin] : buffer -> view<2x2xi32, %selected>
  %for_value = view.load %for_view[1, 1] : view<2x2xi32, %for_first> -> i32
  %while_value = view.load %while_view[1, 1] : view<2x2xi32, %while_first> -> i32
  %selected_value = view.load %selected_view[1, 1] : view<2x2xi32, %selected> -> i32
  %destination = buffer.view %output_aligned[%origin] : buffer -> view<3xi32>
  view.store %for_value, %destination[0] : i32, view<3xi32>
  view.store %while_value, %destination[1] : i32, view<3xi32>
  view.store %selected_value, %destination[2] : i32, view<3xi32>
  func.return
}

func.def @strided_layout_recurrence_oracle(%input: buffer, %output: buffer, %count_input: index, %left_pitch_input: index, %right_pitch_input: index, %choose_left: i1) {
  func.call @compute_strided_layout_recurrence(%input, %output, %count_input, %left_pitch_input, %right_pitch_input, %choose_left) : (buffer, buffer, index, index, index, i1)
  func.return
}

check.scenario @strided_layout_recurrence_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(0) : index
    %left_pitch = check.literal value(4) : index
    %right_pitch = check.literal value(9) : index
    %choose_left = check.literal value(true) : i1
    %input = check.generate.iota offset(100) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-99) : tensor<5xi32>
    check.compare<@strided_layout_recurrence, @strided_layout_recurrence_oracle>(%input, %output, %count, %left_pitch, %right_pitch, %choose_left) : (tensor<16xi32>, tensor<5xi32>, index, index, index, i1) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(1) : index
    %left_pitch = check.literal value(4) : index
    %right_pitch = check.literal value(9) : index
    %choose_left = check.literal value(false) : i1
    %input = check.generate.iota offset(100) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-99) : tensor<5xi32>
    check.compare<@strided_layout_recurrence, @strided_layout_recurrence_oracle>(%input, %output, %count, %left_pitch, %right_pitch, %choose_left) : (tensor<16xi32>, tensor<5xi32>, index, index, index, i1) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(2) : index
    %left_pitch = check.literal value(4) : index
    %right_pitch = check.literal value(9) : index
    %choose_left = check.literal value(true) : i1
    %input = check.generate.iota offset(100) step(1) : tensor<16xi32>
    %output = check.generate.fill value(-99) : tensor<5xi32>
    check.compare<@strided_layout_recurrence, @strided_layout_recurrence_oracle>(%input, %output, %count, %left_pitch, %right_pitch, %choose_left) : (tensor<16xi32>, tensor<5xi32>, index, index, index, i1) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<16xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<5xi32>
    }
  }
  check.return
}
