// The exact quotient relation remains usable without lifting its numerator.
func.def @original_quotient_guard(%input: buffer, %extent_input: index, %block_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %block = index.assume %block_input [range(%block_input, 0, 63)] : index
  %block_width = index.constant 16 : index
  %base = index.constant 0 : offset
  %count = index.div %extent, %block_width : index
  %in_bounds = index.cmp slt, %block, %count : index
  scf.if %in_bounds {
    %view = buffer.view %input[%base] : buffer -> view<[%count]xi32>
    %value = vector.load %view[%block] : view<[%count]xi32> -> vector<1xi32>
    test.use %value : vector<1xi32>
  }
  func.return
}

// ----
func.def @original_quotient_guard(%input: buffer, %extent_input: index, %block_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %block = index.assume %block_input [range(%block_input, 0, 63)] : index
  %block_width = index.constant 16 : index
  %base = index.constant 0 : offset
  %count = index.div %extent, %block_width : index
  %in_bounds = index.cmp slt, %block, %count : index
  scf.if %in_bounds {
    %view = buffer.view %input[%base] : buffer -> view<[%count]xi32>
    %value = vector.load %view[%block] : view<[%count]xi32> -> vector<1xi32>
    test.use %value : vector<1xi32>
  }
  func.return
}

// ====

// Fixed-width division carries the same projection through an index cast.
func.def @fixed_width_block_guard(%input: buffer, %extent_input: i32, %block_input: i32) {
  %extent = scalar.assume %extent_input [range(%extent_input, 12, 1023)] : i32
  %block = scalar.assume %block_input [range(%block_input, 0, 85)] : i32
  %block_width = scalar.constant 12 : i32
  %count = scalar.divui %extent, %block_width : i32
  %in_bounds = scalar.cmpi ult, %block, %count : i32
  scf.if %in_bounds {
    %origin = scalar.muli %block, %block_width : i32
    %origin_index = index.cast %origin : i32 to index
    %extent_index = index.cast %extent : i32 to index
    %base = index.constant 0 : offset
    %view = buffer.view %input[%base] : buffer -> view<[%extent_index]xi32>
    %value = vector.load %view[%origin_index] : view<[%extent_index]xi32> -> vector<12xi32>
    test.use %value : vector<12xi32>
  }
  func.return
}

// ----
func.def @fixed_width_block_guard(%input: buffer, %extent_input: i32, %block_input: i32) {
  %extent = scalar.assume %extent_input [range(%extent_input, 12, 1023)] : i32
  %block = scalar.assume %block_input [range(%block_input, 0, 85)] : i32
  %block_width = scalar.constant 12 : i32
  %count = scalar.divui %extent, %block_width : i32
  %in_bounds = scalar.cmpi ult, %block, %count : i32
  scf.if %in_bounds {
    %origin = scalar.muli %block, %block_width : i32
    %origin_index = index.cast %origin : i32 to index
    %extent_index = index.cast %extent : i32 to index
    %base = index.constant 0 : offset
    %view = buffer.view %input[%base] : buffer -> view<[%extent_index]xi32>
    %value = vector.load %view[%origin_index] : view<[%extent_index]xi32> -> vector<12xi32>
    test.use %value : vector<12xi32>
  }
  func.return
}

// ====

// A remainder guard cannot establish the number of complete blocks.
func.def @periodic_digit_is_not_a_quotient(%input: buffer, %extent_input: index, %block_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %block = index.assume %block_input [range(%block_input, 0, 63)] : index
  %block_width = index.constant 16 : index
  %base = index.constant 0 : offset
  %remainder = index.rem %extent, %block_width : index
  %in_bounds = index.cmp slt, %block, %remainder : index
  scf.if %in_bounds {
    %origin = index.mul %block, %block_width : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    // ERROR@+1: SUBRANGE/010 {op_name="vector.load", vector_extent="4"}
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

// ====

// Equal quotients do not make their numerators equal or license a tail packet.
func.def @equal_quotient_does_not_cover_tail(%input: buffer, %extent_input: index, %count_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %count = index.assume %count_input [range(%count_input, 1, 63)] : index
  %block_width = index.constant 16 : index
  %base = index.constant 0 : offset
  %quotient = index.div %extent, %block_width : index
  %equal = index.cmp eq, %quotient, %count : index
  scf.if %equal {
    %origin = index.mul %count, %block_width : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    // ERROR@+1: SUBRANGE/010 {op_name="vector.load", vector_extent="4"}
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

// ====

// Coprime divisors retain both cross multipliers without common-factor removal.
func.def @coprime_quotient_scales(%input: buffer, %coordinate_input: index, %extent_input: index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 511)] : index
  %extent = index.assume %extent_input [range(%extent_input, 5, 1023)] : index
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  %base = index.constant 0 : offset
  %left = index.div %coordinate, %c3 : index
  %right = index.div %extent, %c5 : index
  %in_bounds = index.cmp slt, %left, %right : index
  scf.if %in_bounds {
    %origin = index.mul %coordinate, %c5 : index
    %view_extent = index.mul %extent, %c3 : index
    %view = buffer.view %input[%base] : buffer -> view<[%view_extent]xi32>
    %value = vector.load %view[%origin] : view<[%view_extent]xi32> -> vector<5xi32>
    test.use %value : vector<5xi32>
  }
  func.return
}

// ----
func.def @coprime_quotient_scales(%input: buffer, %coordinate_input: index, %extent_input: index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 511)] : index
  %extent = index.assume %extent_input [range(%extent_input, 5, 1023)] : index
  %c3 = index.constant 3 : index
  %c5 = index.constant 5 : index
  %base = index.constant 0 : offset
  %left = index.div %coordinate, %c3 : index
  %right = index.div %extent, %c5 : index
  %in_bounds = index.cmp slt, %left, %right : index
  scf.if %in_bounds {
    %origin = index.mul %coordinate, %c5 : index
    %view_extent = index.mul %extent, %c3 : index
    %view = buffer.view %input[%base] : buffer -> view<[%view_extent]xi32>
    %value = vector.load %view[%origin] : view<[%view_extent]xi32> -> vector<5xi32>
    test.use %value : vector<5xi32>
  }
  func.return
}
