// The same uniform transport must preserve both halves of a wide recurrence.
kernel.def @collective_loop_wide_state() {
  %unit = index.constant 1 : index
  %size = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %iterations_input: index) {
  %iterations = index.assume %iterations_input [range(%iterations_input, 0, 2)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %unit = index.constant 1 : index
  %initial = scalar.constant 4294967301 : i64
  %multiplier = scalar.constant 2 : i64
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 8} : buffer
  %source, %destination = buffer.assume.noalias %input_aligned, %output_aligned : buffer, buffer
  %values = buffer.view %source[%base] : buffer -> view<128xi32>
  %results = buffer.view %destination[%base] : buffer -> view<128xi64>
  %value = view.load %values[%lane] : view<128xi32> -> i32
  %result = scf.for %iteration = [%c0 to %iterations step %unit](%sum = %initial : i64) -> (i64) {
    %reduced = kernel.workgroup.reduce<addi> %value : i32
    %wide = scalar.extui %reduced : i32 to i64
    %scaled = scalar.muli %sum, %multiplier : i64
    %next = scalar.addi %scaled, %wide : i64
    scf.yield %next : i64
  }
  view.store %result, %results[%lane] : i64, view<128xi64>
  kernel.return
}

func.def @collective_loop_wide_state_oracle(%input: buffer, %output: buffer, %iterations_input: index) {
  %iterations = index.assume %iterations_input [range(%iterations_input, 0, 2)] : index
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %initial = scalar.constant 4294967301 : i64
  %multiplier = scalar.constant 2 : i64
  %values = buffer.view %input[%base] : buffer -> view<128xi32>
  %results = buffer.view %output[%base] : buffer -> view<128xi64>
  %reduced = scf.for %position = [%begin to %end step %step](%sum = %c0 : i32) -> (i32) {
    %value = view.load %values[%position] : view<128xi32> -> i32
    %next = scalar.addi %sum, %value : i32
    scf.yield %next : i32
  }
  %wide = scalar.extui %reduced : i32 to i64
  %result = scf.for %iteration = [%begin to %iterations step %step](%sum = %initial : i64) -> (i64) {
    %scaled = scalar.muli %sum, %multiplier : i64
    %next = scalar.addi %scaled, %wide : i64
    scf.yield %next : i64
  }
  scf.for %position = [%begin to %end step %step] {
    view.store %result, %results[%position] : i64, view<128xi64>
  }
  func.return
}

check.scenario @collective_loop_wide_state_values {
  check.trial[3](%iterations: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%iterations] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(0 to 1024) : tensor<128xi32>
    %storage = check.generate.fill value(-1) : tensor<136xi64>
    %output = check.tensor.view %storage offset(32) : tensor<136xi64> -> tensor<128xi64>
    check.compare<@collective_loop_wide_state, @collective_loop_wide_state_oracle>(%input, %output, %iterations) : (tensor<128xi32>, tensor<128xi64>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<136xi64>
    }
  }
  check.return
}
