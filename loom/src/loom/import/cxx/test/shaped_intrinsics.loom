func.decl @lookup_lane(%input: i32, %index: i32, %lane: i32) -> (i32)

func.decl @dot_lane(%input: i32, %accumulator: i32, %lane: i32) -> (i32)

kernel.decl @register_lookup() launch(%table: buffer, %indices: buffer, %output: buffer, %count: i32)

kernel.decl @register_lookup_float() launch(%table: buffer, %indices: buffer, %output: buffer, %count: i32)

kernel.decl @mixed_dot() launch(%lhs: buffer, %rhs: buffer, %acc: buffer, %output: buffer, %count: i32)

global.rodata.def @shaped_lookup_values = align(4) bytes("0000000000000080ffffffff")

global.rodata.def @shaped_dot_values = align(4) bytes("00000000010000007f00000080000000ff000000ff010000")

global.rodata.def @shaped_dot_accumulators = align(4) bytes("00000000ffffff7f00000080")

global.rodata.def @shaped_lookup_configs = align(4) bytes("000000000400000000000000200000000100000004000000040000002400000004000000100000001000000030000000070000001c0000001c0000003c000000")

global.rodata.def @shaped_mixed_dot_configs = align(4) bytes("0000000004000000000000002000000001000000040000001000000030000000030000000c0000003000000050000000090000002400000090000000b0000000")

global.rodata.def @shaped_float_lookup_table = align(4) bytes("00000000000000804523c17f0000807f000080ff01000000010000800000803f000080bf0000003f00000040000000c0ffff7f7f00008000ffff7f004523c1ff")

global.rodata.def @shaped_dot_lhs = align(1) bytes("00ff807f0001ff80172d4359ffffffff")

global.rodata.def @shaped_dot_rhs = align(1) bytes("807fff017f8001fffd05f90b7f7f7f7f")

global.rodata.def @shaped_mixed_accumulators = align(4) bytes("00000000ffffff7f00000080ffffffff")

func.def @shaped_lookup_input(%trial: index) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 47)] : index
  %index_span = index.constant 16 : index
  %value_index = index.div %bounded_trial, %index_span : index
  %lookup_index = index.rem %bounded_trial, %index_span : index
  %value_buffer = global.load @shaped_lookup_values : buffer
  %values = buffer.view %value_buffer[%origin] : buffer -> view<3xi32>
  %input = view.load %values[%value_index] : view<3xi32> -> i32
  %lookup_index_i32 = index.cast %lookup_index : index to i32
  func.return %input, %lookup_index_i32 : i32, i32
}

func.def @shaped_dot_input(%trial: index) -> (i32, i32) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 17)] : index
  %accumulator_span = index.constant 3 : index
  %value_index = index.div %bounded_trial, %accumulator_span : index
  %accumulator_index = index.rem %bounded_trial, %accumulator_span : index
  %value_buffer = global.load @shaped_dot_values : buffer
  %accumulator_buffer = global.load @shaped_dot_accumulators : buffer
  %values = buffer.view %value_buffer[%origin] : buffer -> view<6xi32>
  %accumulators = buffer.view %accumulator_buffer[%origin] : buffer -> view<3xi32>
  %input = view.load %values[%value_index] : view<6xi32> -> i32
  %accumulator = view.load %accumulators[%accumulator_index] : view<3xi32> -> i32
  func.return %input, %accumulator : i32, i32
}

func.def @shaped_lookup_config(%trial: index) -> (i32, index, index, index) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 3)] : index
  %config_buffer = global.load @shaped_lookup_configs : buffer
  %configs = buffer.view %config_buffer[%origin] : buffer -> view<4x4xi32>
  %count = view.load %configs[%bounded_trial, 0] : view<4x4xi32> -> i32
  %input_count_i32 = view.load %configs[%bounded_trial, 1] : view<4x4xi32> -> i32
  %output_count_i32 = view.load %configs[%bounded_trial, 2] : view<4x4xi32> -> i32
  %storage_count_i32 = view.load %configs[%bounded_trial, 3] : view<4x4xi32> -> i32
  %input_count_unbounded = index.cast %input_count_i32 : i32 to index
  %output_count_unbounded = index.cast %output_count_i32 : i32 to index
  %storage_count_unbounded = index.cast %storage_count_i32 : i32 to index
  %input_count = index.assume %input_count_unbounded [range(%input_count_unbounded, 4, 28)] : index
  %output_count = index.assume %output_count_unbounded [range(%output_count_unbounded, 0, 28)] : index
  %storage_count = index.assume %storage_count_unbounded [range(%storage_count_unbounded, 32, 60)] : index
  func.return %count, %input_count, %output_count, %storage_count : i32, index, index, index
}

func.def @shaped_mixed_dot_config(%trial: index) -> (i32, index, index, index) {
  %origin = index.constant 0 : offset
  %bounded_trial = index.assume %trial [range(%trial, 0, 3)] : index
  %config_buffer = global.load @shaped_mixed_dot_configs : buffer
  %configs = buffer.view %config_buffer[%origin] : buffer -> view<4x4xi32>
  %count = view.load %configs[%bounded_trial, 0] : view<4x4xi32> -> i32
  %input_count_i32 = view.load %configs[%bounded_trial, 1] : view<4x4xi32> -> i32
  %output_count_i32 = view.load %configs[%bounded_trial, 2] : view<4x4xi32> -> i32
  %storage_count_i32 = view.load %configs[%bounded_trial, 3] : view<4x4xi32> -> i32
  %input_count_unbounded = index.cast %input_count_i32 : i32 to index
  %output_count_unbounded = index.cast %output_count_i32 : i32 to index
  %storage_count_unbounded = index.cast %storage_count_i32 : i32 to index
  %input_count = index.assume %input_count_unbounded [range(%input_count_unbounded, 4, 36)] : index
  %output_count = index.assume %output_count_unbounded [range(%output_count_unbounded, 0, 144)] : index
  %storage_count = index.assume %storage_count_unbounded [range(%storage_count_unbounded, 32, 176)] : index
  func.return %count, %input_count, %output_count, %storage_count : i32, index, index, index
}

func.def @shaped_lookup_observations(%input: i32, %lookup_index: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %value = func.call @lookup_lane(%input, %lookup_index, %lane_i32) : (i32, i32, i32) -> (i32)
    view.store %value, %results[%lane] : i32, view<4xi32>
  }
  func.return
}

func.def @shaped_lookup_reference(%input: i32, %lookup_index: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c15 = scalar.constant 15 : i32
  %word_maximum = scalar.constant -1 : i32
  %word_high_bit = scalar.constant -2147483648 : i32
  %reverse_index = scalar.subi %c15, %lookup_index : i32
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first_lane = scalar.cmpi eq, %lane_i32, %c0 : i32
    %is_second_lane = scalar.cmpi eq, %lane_i32, %c1 : i32
    %is_third_lane = scalar.cmpi eq, %lane_i32, %c2 : i32
    %selected_tail = scf.select %is_third_lane, %c0, %c15 : i32
    %selected_tail1 = scf.select %is_second_lane, %reverse_index, %selected_tail : i32
    %selected_index = scf.select %is_first_lane, %lookup_index, %selected_tail1 : i32
    %is_table_first = scalar.cmpi eq, %selected_index, %c0 : i32
    %is_table_second = scalar.cmpi eq, %selected_index, %c1 : i32
    %is_table_third = scalar.cmpi eq, %selected_index, %c2 : i32
    %is_table_fourth = scalar.cmpi eq, %selected_index, %c3 : i32
    %value_tail0 = scf.select %is_table_fourth, %word_high_bit, %selected_index : i32
    %value_tail1 = scf.select %is_table_third, %word_maximum, %value_tail0 : i32
    %value_tail2 = scf.select %is_table_second, %c1, %value_tail1 : i32
    %value = scf.select %is_table_first, %input, %value_tail2 : i32
    view.store %value, %results[%lane] : i32, view<4xi32>
  }
  func.return
}

func.def @shaped_dot_observations(%input: i32, %accumulator: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %value = func.call @dot_lane(%input, %accumulator, %lane_i32) : (i32, i32, i32) -> (i32)
    view.store %value, %results[%lane] : i32, view<4xi32>
  }
  func.return
}

func.def @shaped_dot_reference(%input: i32, %accumulator: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %lane_end = index.constant 4 : index
  %product_end = index.constant 4 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %word_maximum = scalar.constant -1 : i32
  %signed_maximum = scalar.constant 2147483647 : i32
  %signed_minimum = scalar.constant -2147483648 : i32
  %input_byte = scalar.trunci %input : i32 to i8
  %lhs_buffer = global.load @shaped_dot_lhs : buffer
  %rhs_buffer = global.load @shaped_dot_rhs : buffer
  %lhs_values = buffer.view %lhs_buffer[%origin] : buffer -> view<16xi8>
  %rhs_values = buffer.view %rhs_buffer[%origin] : buffer -> view<16xi8>
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  scf.for %lane = [%begin to %lane_end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first_lane = scalar.cmpi eq, %lane_i32, %c0 : i32
    %is_second_lane = scalar.cmpi eq, %lane_i32, %c1 : i32
    %is_third_lane = scalar.cmpi eq, %lane_i32, %c2 : i32
    %initial_tail0 = scf.select %is_third_lane, %signed_maximum, %signed_minimum : i32
    %initial_tail1 = scf.select %is_second_lane, %word_maximum, %initial_tail0 : i32
    %initial = scf.select %is_first_lane, %accumulator, %initial_tail1 : i32
    %lane_base = index.mul %lane, %product_end : index
    %product_sum = scf.for %element = [%begin to %product_end step %step](%sum = %c0 : i32) -> (i32) {
      %position = index.add %lane_base, %element : index
      %position_i32 = index.cast %position : index to i32
      %is_input = scalar.cmpi eq, %position_i32, %c0 : i32
      %stored_lhs = view.load %lhs_values[%position] : view<16xi8> -> i8
      %lhs = scf.select %is_input, %input_byte, %stored_lhs : i8
      %rhs = view.load %rhs_values[%position] : view<16xi8> -> i8
      %lhs_wide = scalar.extui %lhs : i8 to i32
      %rhs_wide = scalar.extsi %rhs : i8 to i32
      %product = scalar.muli %lhs_wide, %rhs_wide : i32
      %next = scalar.addi %sum, %product : i32
      scf.yield %next : i32
    }
    %value = scalar.addi %initial, %product_sum : i32
    view.store %value, %results[%lane] : i32, view<4xi32>
  }
  func.return
}

func.def @shaped_integer_lookup_table(%table: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  %multiplier = scalar.constant -1640531527 : i32
  %bias = scalar.constant -2147483648 : i32
  %values = buffer.view %table[%origin] : buffer -> view<16xi32>
  scf.for %position = [%begin to %end step %step] {
    %position_i32 = index.cast %position : index to i32
    %scaled = scalar.muli %position_i32, %multiplier : i32
    %value = scalar.addi %scaled, %bias : i32
    view.store %value, %values[%position] : i32, view<16xi32>
  }
  func.return
}

func.def @shaped_float_lookup_table_input(%table: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 16 : index
  %step = index.constant 1 : index
  %source_buffer = global.load @shaped_float_lookup_table : buffer
  %source = buffer.view %source_buffer[%origin] : buffer -> view<16xi32>
  %values = buffer.view %table[%origin] : buffer -> view<16xi32>
  scf.for %position = [%begin to %end step %step] {
    %value = view.load %source[%position] : view<16xi32> -> i32
    view.store %value, %values[%position] : i32, view<16xi32>
  }
  func.return
}

func.def @shaped_lookup_indices(%indices: buffer, %input_count: index) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %bounded_input_count = index.assume %input_count [range(%input_count, 4, 28)] : index
  %multiplier = scalar.constant 11 : i32
  %bias = scalar.constant 15 : i32
  %mask = scalar.constant 15 : i32
  %values = buffer.view %indices[%origin] : buffer -> view<[%bounded_input_count]xi32>
  scf.for %position = [%begin to %bounded_input_count step %step] {
    %position_i32 = index.cast %position : index to i32
    %scaled = scalar.muli %position_i32, %multiplier : i32
    %shifted = scalar.addi %scaled, %bias : i32
    %value = scalar.andi %shifted, %mask : i32
    view.store %value, %values[%position] : i32, view<[%bounded_input_count]xi32>
  }
  func.return
}

func.def @shaped_register_lookup_oracle(%table: buffer, %indices: buffer, %output: buffer, %count: i32) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %element_bytes = index.constant 4 : index
  %lanes = index.constant 4 : index
  %indices_length = buffer.length %indices
  %indices_bytes = index.cast %indices_length : offset to index
  %input_count_unbounded = index.div %indices_bytes, %element_bytes : index
  %input_count = index.assume %input_count_unbounded [range(%input_count_unbounded, 4, 28)] : index
  %count_unbounded = index.cast %count : i32 to index
  %bounded_count = index.assume %count_unbounded [range(%count_unbounded, 0, 7)] : index
  %output_count_unbounded = index.mul %bounded_count, %lanes : index
  %output_count = index.assume %output_count_unbounded [range(%output_count_unbounded, 0, 28)] : index
  %table_values = buffer.view %table[%origin] : buffer -> view<16xi32>
  %index_values = buffer.view %indices[%origin] : buffer -> view<[%input_count]xi32>
  %output_values = buffer.view %output[%origin] : buffer -> view<[%output_count]xi32>
  scf.for %position = [%begin to %output_count step %step] {
    %bounded_position = index.assume %position [lt(%position, %input_count)] : index
    %selector_i32 = view.load %index_values[%bounded_position] : view<[%input_count]xi32> -> i32
    %selector_unbounded = index.cast %selector_i32 : i32 to index
    %selector = index.assume %selector_unbounded [range(%selector_unbounded, 0, 15)] : index
    %value = view.load %table_values[%selector] : view<16xi32> -> i32
    view.store %value, %output_values[%position] : i32, view<[%output_count]xi32>
  }
  func.return
}

func.def @shaped_mixed_dot_inputs(%lhs: buffer, %rhs: buffer, %acc: buffer, %input_count: index) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %word_bytes = index.constant 4 : index
  %bounded_input_count = index.assume %input_count [range(%input_count, 4, 36)] : index
  %byte_count_unbounded = index.mul %bounded_input_count, %word_bytes : index
  %byte_count = index.assume %byte_count_unbounded [range(%byte_count_unbounded, 16, 144)] : index
  %c17 = scalar.constant 17 : i32
  %c255 = scalar.constant 255 : i32
  %lhs_base_buffer = global.load @shaped_dot_lhs : buffer
  %accumulator_buffer = global.load @shaped_mixed_accumulators : buffer
  %lhs_base = buffer.view %lhs_base_buffer[%origin] : buffer -> view<16xi8>
  %accumulator_values = buffer.view %accumulator_buffer[%origin] : buffer -> view<4xi32>
  %lhs_values = buffer.view %lhs[%origin] : buffer -> view<[%byte_count]xi8>
  %rhs_values = buffer.view %rhs[%origin] : buffer -> view<[%byte_count]xi8>
  %acc_values = buffer.view %acc[%origin] : buffer -> view<[%bounded_input_count]xi32>
  scf.for %position = [%begin to %byte_count step %step] {
    %lane = index.rem %position, %word_bytes : index
    %packet = index.div %position, %word_bytes : index
    %base = view.load %lhs_base[%lane] : view<16xi8> -> i8
    %base_i32 = scalar.extui %base : i8 to i32
    %packet_i32 = index.cast %packet : index to i32
    %lhs_i32 = scalar.addi %base_i32, %packet_i32 : i32
    %lhs_value = scalar.trunci %lhs_i32 : i32 to i8
    %position_i32 = index.cast %position : index to i32
    %rhs_offset = scalar.muli %position_i32, %c17 : i32
    %rhs_i32 = scalar.subi %c255, %rhs_offset : i32
    %rhs_value = scalar.trunci %rhs_i32 : i32 to i8
    view.store %lhs_value, %lhs_values[%position] : i8, view<[%byte_count]xi8>
    view.store %rhs_value, %rhs_values[%position] : i8, view<[%byte_count]xi8>
  }
  scf.for %position = [%begin to %bounded_input_count step %step] {
    %lane = index.rem %position, %word_bytes : index
    %value = view.load %accumulator_values[%lane] : view<4xi32> -> i32
    view.store %value, %acc_values[%position] : i32, view<[%bounded_input_count]xi32>
  }
  func.return
}

func.def @shaped_mixed_dot_oracle(%lhs: buffer, %rhs: buffer, %acc: buffer, %output: buffer, %count: i32) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %lane_end = index.constant 4 : index
  %variant_end = index.constant 4 : index
  %product_end = index.constant 4 : index
  %step = index.constant 1 : index
  %word_bytes = index.constant 4 : index
  %group_bytes = index.constant 16 : index
  %group_outputs = index.constant 16 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %lhs_length = buffer.length %lhs
  %lhs_bytes_unbounded = index.cast %lhs_length : offset to index
  %lhs_bytes = index.assume %lhs_bytes_unbounded [range(%lhs_bytes_unbounded, 16, 144)] : index
  %input_count_unbounded = index.div %lhs_bytes, %word_bytes : index
  %input_count = index.assume %input_count_unbounded [range(%input_count_unbounded, 4, 36)] : index
  %count_unbounded = index.cast %count : i32 to index
  %bounded_count = index.assume %count_unbounded [range(%count_unbounded, 0, 9)] : index
  %output_count_unbounded = index.mul %bounded_count, %group_outputs : index
  %output_count = index.assume %output_count_unbounded [range(%output_count_unbounded, 0, 144)] : index
  %lhs_values = buffer.view %lhs[%origin] : buffer -> view<[%lhs_bytes]xi8>
  %rhs_values = buffer.view %rhs[%origin] : buffer -> view<[%lhs_bytes]xi8>
  %acc_values = buffer.view %acc[%origin] : buffer -> view<[%input_count]xi32>
  %output_values = buffer.view %output[%origin] : buffer -> view<[%output_count]xi32>
  scf.for %group = [%begin to %bounded_count step %step] {
    %input_group_base = index.mul %group, %group_bytes : index
    %acc_group_base = index.mul %group, %lane_end : index
    %output_group_base = index.mul %group, %group_outputs : index
    scf.for %variant = [%begin to %variant_end step %step] {
      %variant_i32 = index.cast %variant : index to i32
      %lhs_unsigned_bit = scalar.andi %variant_i32, %c1 : i32
      %lhs_unsigned = scalar.cmpi ne, %lhs_unsigned_bit, %c0 : i32
      %rhs_unsigned = scalar.cmpi uge, %variant_i32, %c2 : i32
      %variant_base = index.mul %variant, %lane_end : index
      scf.for %lane = [%begin to %lane_end step %step] {
        %lane_base = index.mul %lane, %product_end : index
        %product_base = index.add %input_group_base, %lane_base : index
        %sum = scf.for %element = [%begin to %product_end step %step](%accumulator = %c0 : i32) -> (i32) {
          %position = index.add %product_base, %element : index
          %bounded_position = index.assume %position [lt(%position, %lhs_bytes)] : index
          %lhs_byte = view.load %lhs_values[%bounded_position] : view<[%lhs_bytes]xi8> -> i8
          %rhs_byte = view.load %rhs_values[%bounded_position] : view<[%lhs_bytes]xi8> -> i8
          %lhs_signed_value = scalar.extsi %lhs_byte : i8 to i32
          %lhs_unsigned_value = scalar.extui %lhs_byte : i8 to i32
          %rhs_signed_value = scalar.extsi %rhs_byte : i8 to i32
          %rhs_unsigned_value = scalar.extui %rhs_byte : i8 to i32
          %lhs_value = scf.select %lhs_unsigned, %lhs_unsigned_value, %lhs_signed_value : i32
          %rhs_value = scf.select %rhs_unsigned, %rhs_unsigned_value, %rhs_signed_value : i32
          %product = scalar.muli %lhs_value, %rhs_value : i32
          %next = scalar.addi %accumulator, %product : i32
          scf.yield %next : i32
        }
        %acc_position = index.add %acc_group_base, %lane : index
        %bounded_acc_position = index.assume %acc_position [lt(%acc_position, %input_count)] : index
        %initial = view.load %acc_values[%bounded_acc_position] : view<[%input_count]xi32> -> i32
        %value = scalar.addi %initial, %sum : i32
        %variant_position = index.add %variant_base, %lane : index
        %output_position = index.add %output_group_base, %variant_position : index
        %bounded_output_position = index.assume %output_position [lt(%output_position, %output_count)] : index
        view.store %value, %output_values[%bounded_output_position] : i32, view<[%output_count]xi32>
      }
    }
  }
  func.return
}

check.scenario @shaped_intrinsics_functions {
  check.trial[48](%trial: index, %entropy: check.entropy) {
    %input, %lookup_index = check.generate<@shaped_lookup_input>(%trial) : (index) -> (i32, i32)
    %output = check.generate.fill value(-123) : tensor<4xi32>
    check.compare<@shaped_lookup_observations, @shaped_lookup_reference>(%input, %lookup_index, %output) : (i32, i32, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[18](%trial: index, %entropy: check.entropy) {
    %input, %accumulator = check.generate<@shaped_dot_input>(%trial) : (index) -> (i32, i32)
