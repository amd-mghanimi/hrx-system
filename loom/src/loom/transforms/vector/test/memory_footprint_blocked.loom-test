// RUN: pass scf-to-cfg,vector-memory-footprint

// Retaining a remainder's source anchor does not turn it into a quotient.
func.def @periodic_digit_is_not_a_quotient_after_cfg(%input: buffer, %extent_input: index, %block_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %block = index.assume %block_input [range(%block_input, 0, 63)] : index
  %block_width = index.constant 16 : index
  %base = index.constant 0 : offset
  %remainder = index.rem %extent, %block_width : index
  %in_bounds = index.cmp slt, %block, %remainder : index
  scf.if %in_bounds {
    %origin = index.mul %block, %block_width : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    // ERROR@+1: SUBRANGE/010 {op_name="vector.load", vector_extent="4"}
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

// ====
// RUN: pass vector-memory-footprint

// Equality bounds both the beginning and end of the quotient's input block.
func.def @equal_quotient_bounds(%input: buffer, %extent_input: index, %count_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %count = index.assume %count_input [range(%count_input, 1, 63)] : index
  %block_width = index.constant 16 : index
  %packet_width = index.constant 4 : index
  %c1 = index.constant 1 : index
  %base = index.constant 0 : offset
  %quotient = index.div %extent, %block_width : index
  %equal = index.cmp eq, %quotient, %count : index
  scf.if %equal {
    %end = index.mul %count, %block_width : index
    %origin = index.sub %end, %packet_width : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    %packet = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %packet : vector<4xi32>
    %padded_count = index.add %count, %c1 : index
    %padded_extent = index.mul %padded_count, %block_width : index
    %padded_view = buffer.view %input[%base] : buffer -> view<[%padded_extent]xi32>
    %last = vector.load %padded_view[%extent] : view<[%padded_extent]xi32> -> vector<1xi32>
    test.use %last : vector<1xi32>
  }
  func.return
}

// ----
func.def @equal_quotient_bounds(%input: buffer, %extent_input: index, %count_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %count = index.assume %count_input [range(%count_input, 1, 63)] : index
  %block_width = index.constant 16 : index
  %packet_width = index.constant 4 : index
  %c1 = index.constant 1 : index
  %base = index.constant 0 : offset
  %quotient = index.div %extent, %block_width : index
  %equal = index.cmp eq, %quotient, %count : index
  scf.if %equal {
    %end = index.mul %count, %block_width : index
    %origin = index.sub %end, %packet_width : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    %packet = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %packet : vector<4xi32>
    %padded_count = index.add %count, %c1 : index
    %padded_extent = index.mul %padded_count, %block_width : index
    %padded_view = buffer.view %input[%base] : buffer -> view<[%padded_extent]xi32>
    %last = vector.load %padded_view[%extent] : view<[%padded_extent]xi32> -> vector<1xi32>
    test.use %last : vector<1xi32>
  }
  func.return
}

