load("//build_tools/testing:build_defs.bzl", "iree_execution_test_suite")
load("//loom/binding/c:shared.bzl", "loomc_cc_binary")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

loomc_cc_binary(
    name = "loom-link",
    srcs = ["loom-link.c"],
    deps = [
        "//loom/binding/c:loomc",
        "//loom/binding/c/target/configured:target",
        "//loom/src/loom/config:text_binding",
        "//loom/src/loom/testing:target_environment",
        "//loom/src/loom/tooling/cli:help",
        "//loom/src/loom/tooling/cli:loomc_options",
        "//loom/src/loom/tooling/cli:loomc_result",
        "//loom/src/loom/tooling/config:input",
        "//loom/src/loom/tooling/input:flags",
        "//loom/src/loom/tooling/input:format",
        "//loom/src/loom/tooling/input:loomc_configured",
        "//loom/src/loom/tooling/io:file",
        "//loom/src/loom/tooling/io:module_format",
        "//loom/src/loom/util:stream",
        "//runtime/src/iree/base",
        "//runtime/src/iree/base/internal:arena",
        "//runtime/src/iree/base/tooling:flags",
    ],
)

iree_execution_test_suite(
    name = "execution_test",
    data = [
        "testdata/dependency_component.loom",
        "testdata/dependency_direct.loom",
        "testdata/dependency_transitive.loom",
        "testdata/kernel_export_cases.loom",
        "testdata/kernel_exports.loom",
        "testdata/source_library.loom-test",
        "testdata/source_main.loom",
        "//loom/src/loom/link/testdata:provider_roots/direct.loom",
        "//loom/src/loom/link/testdata:provider_roots/transitive.loom",
        "//loom/src/loom/link/testdata:provider_roots/unused.loom",
        "//loom/src/loom/link/testdata:template_selection/missing_provider.loom",
        "//loom/src/loom/link/testdata:template_selection/root.loom",
        "//loom/src/loom/tooling/input:testdata/duplicate_symbols.loom-test",
    ],
    manifests = ["loom-link.test.json"],
    tags = ["hostonly"],
    tools = {
        "loom-format": "//loom/src/loom/tools/loom-format",
        "loom-link": ":loom-link",
        "loom-opt": "//loom/src/loom/tools/loom-opt",
    },
)
