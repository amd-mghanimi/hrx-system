// RUN: pass canonicalize,cse,promote-private-fragments,canonicalize,cse,dce
// A fixed array is an immutable value partition inside an enclosing record.
struct Command { unsigned words[2]; };
Command forward(Command value) { return value; }

// ----
func.def public @forward(%value_words_0: i32, %value_words_1: i32) -> (i32, i32) {
  func.return %value_words_0, %value_words_1 : i32, i32
}

// ====
// Constant element mutations return to SSA without retaining a local array.
struct Command { unsigned words[2]; };
Command adjust(Command value) { value.words[1] += 3; return value; }

// ----
func.def public @adjust(%value_words_0: i32, %value_words_1: i32) -> (i32, i32) {
  %16 = scalar.constant 3 : i32
  %30 = scalar.addi %value_words_1, %16 : i32
  func.return %value_words_0, %30 : i32, i32
}

// ====
// Whole-object memory access captures every field before replacing the object.
struct Record { unsigned first, second; };
Record read(const Record* input) { return *input; }
void write(Record* output, Record value) { *output = value; }

// ----
func.def public @read(%input: buffer, %input_byte_offset: offset) -> (i32, i32) {
  %6 = buffer.view %input[%input_byte_offset] : buffer -> view<1xi32>
  %7 = view.load %6[0] : view<1xi32> -> i32
  %8 = index.constant 4 : offset
  %9 = index.add %input_byte_offset, %8 : offset
  %10 = buffer.view %input[%9] : buffer -> view<1xi32>
  %11 = view.load %10[0] : view<1xi32> -> i32
  func.return %7, %11 : i32, i32
}

func.def public @write(%output: buffer, %output_byte_offset: offset, %value_first: i32, %value_second: i32) {
  %18 = buffer.view %output[%output_byte_offset] : buffer -> view<1xi32>
  view.store %value_first, %18[0] : i32, view<1xi32>
  %19 = index.constant 4 : offset
  %20 = index.add %output_byte_offset, %19 : offset
  %21 = buffer.view %output[%20] : buffer -> view<1xi32>
  view.store %value_second, %21[0] : i32, view<1xi32>
  func.return
}

// ====
// Both an object pointer and a member pointer retain the parameter's identity.
struct Record { unsigned first, second; };
unsigned address(Record value) {
  auto* object = &value;
  auto* member = &value.second;
  *member += 3;
  return object->first + object->second;
}

// ----
func.def public @address(%value_first: i32, %value_second: i32) -> (i32) {
  %17 = scalar.constant 3 : i32
  %38 = scalar.addi %value_second, %value_first : i32
  %39 = scalar.addi %38, %17 : i32
  func.return %39 : i32
}

// ====
// Two vector elements retain their vector components through a record return.
typedef unsigned U4 __attribute__((vector_size(16)));
struct Record { U4 values[2]; };
Record forward(Record value) { return value; }

// ----
func.def public @forward(%value_values_0: vector<4xi32>, %value_values_1: vector<4xi32>) -> (vector<4xi32>, vector<4xi32>) {
  func.return %value_values_0, %value_values_1 : vector<4xi32>, vector<4xi32>
}

// ====
// A real command-sized copy retains only the observed words after promotion.
struct Command { unsigned words[16]; };
unsigned clipped(const Command* source, unsigned skipped) {
  Command value = source[0];
  value.words[0] += skipped * value.words[1];
  return value.words[0];
}

// ----
func.def public @clipped(%source: buffer, %source_byte_offset: offset, %skipped: i32) -> (i32) {
  %12 = index.cast %source_byte_offset : offset to i64
  %14 = scalar.assume %12 [range(%12, 0, 9223372036854775807)] : i64
  %15 = index.cast %14 : i64 to offset
  %18 = buffer.view %source[%15] : buffer -> view<1xi32>
  %19 = view.load %18[0] : view<1xi32> -> i32
  %20 = index.constant 4 : offset
  %21 = index.add %15, %20 : offset
  %22 = buffer.view %source[%21] : buffer -> view<1xi32>
  %23 = view.load %22[0] : view<1xi32> -> i32
  %157 = scalar.muli %skipped, %23 : i32
  %171 = scalar.addi %19, %157 : i32
  func.return %171 : i32
}
