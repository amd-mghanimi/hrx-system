COMPILE-REPORT: pipeline.worker[0] entry=reduce placement=0,3 code_byte_count=22 code_capacity_byte_count=16384 worker_storage_byte_count=64 local_memory_byte_count=32896 local_memory_capacity_byte_count=65536 maximum_bank_storage_byte_count=16384 bank_storage_capacity_byte_count=16384
COMPILE-REPORT: pipeline.worker[1] entry=reduce placement=1,3 code_byte_count=22 code_capacity_byte_count=16384 worker_storage_byte_count=64 local_memory_byte_count=65536 local_memory_capacity_byte_count=65536 maximum_bank_storage_byte_count=16384 bank_storage_capacity_byte_count=16384
