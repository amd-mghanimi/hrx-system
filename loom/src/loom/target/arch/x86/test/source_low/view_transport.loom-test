// RUN: emit source-low target=x86:avx2 output=low

func.def @wide_subview_selection(%input: buffer, %byte_base0: offset, %condition: i1) -> (i32) {
  %byte_base = index.assume %byte_base0 [range(%byte_base0, 2147483648, 4294967296), multiple_of(%byte_base0, 4)] : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %root = buffer.view %aligned[%byte_base] : buffer -> view<4xi32>
  %first = view.subview %root[1] : view<4xi32> -> view<1xi32>
  %second = view.subview %root[2] : view<4xi32> -> view<1xi32>
  %selected = scf.select %condition, %first, %second : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, offset, i1) -> (i32)}) @wide_subview_selection(%aligned: reg<x86.gpr64>, %byte_base: reg<x86.gpr64>, %condition: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %20 = lea.disp %byte_base {disp32 = 4}
  %21 = lea.disp %byte_base {disp32 = 8}
  %22 = copy %21 : reg<x86.gpr64> -> reg<x86.gpr64>
  %selected_offset = select.gpr64 %condition, %20, %22
  %value = mov.load.indexed.gpr32 %aligned, %selected_offset {disp32 = 0, scale = 1}
  return %value
}

// ====

func.def @distinct_root_selection(%first: buffer, %second: buffer, %condition: i1) -> (i32) {
  %first_offset = index.constant 4 : offset
  %second_offset = index.constant 8 : offset
  %first_aligned = buffer.assume.alignment %first {minimum_alignment = 4} : buffer
  %second_aligned = buffer.assume.alignment %second {minimum_alignment = 4} : buffer
  %first_view = buffer.view %first_aligned[%first_offset] : buffer -> view<1xi32>
  %second_view = buffer.view %second_aligned[%second_offset] : buffer -> view<1xi32>
  %selected = scf.select %condition, %first_view, %second_view : view<1xi32>
  %value = view.load %selected[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<x86.avx2.core> abi(object_function) abi_layout({signature = (buffer, buffer, i1) -> (i32)}) @distinct_root_selection(%first_aligned: reg<x86.gpr64>, %second_aligned: reg<x86.gpr64>, %condition: reg<x86.gpr32>) -> (reg<x86.gpr32>) asm {
  %first_offset = mov.imm64 4
  %second_offset = mov.imm64 8
  low.cond_br %condition, ^_bb1, ^_bb2 : reg<x86.gpr32>
^_bb1:
  low.br ^_bb3(%first_aligned: reg<x86.gpr64>, %first_offset: reg<x86.gpr64>)
^_bb2:
  low.br ^_bb3(%second_aligned: reg<x86.gpr64>, %second_offset: reg<x86.gpr64>)
^_bb3(%selected_root: reg<x86.gpr64>, %selected_offset: reg<x86.gpr64>):
  %value = mov.load.indexed.gpr32 %selected_root, %selected_offset {disp32 = 0, scale = 1}
  return %value
}
