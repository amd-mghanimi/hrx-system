// Immediate-form limits are verified on the instruction that owns them.
// RUN: verify

low.func.def target<x86.scalar.core> @immediate_count_too_wide(%value: reg<x86.gpr64>) -> (reg<x86.gpr64>) asm {
  // ERROR@+1: STRUCTURE/014
  %result = shr.imm.gpr64 %value {shift = 64}
  return %result
}

// ====

// Packed shifts accept an imm8; counts of at least 64 clear both qwords.
// RUN: roundtrip

x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @shift_bounds(%input: reg<x86.xmm>) -> (reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>, reg<x86.xmm>) asm {
  %unchanged = vpsllq.xmm %input, 0
  %sign = vpsllq.xmm %input, 63
  %width = vpsllq.xmm %input, 64
  %maximum = vpsllq.xmm %input, 255
  return %unchanged, %sign, %width, %maximum
}

// ====

// RUN: verify

x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @shift_invalid(%input: reg<x86.xmm>) -> (reg<x86.xmm>) asm {
  // ERROR@+1: STRUCTURE/014
  %result = vpsllq.xmm %input, 256
  return %result
}

// ====

// Read-only-data immediates resolve to module-local immutable payloads.
// RUN: roundtrip

x86.target<avx2> @target

global.rodata.def @control = align(16) bytes("0f0e0d0c0b0a09080706050403020100")

low.func.def target<x86.avx2.core>(@target) @load_control() -> (reg<x86.xmm>) asm {
  %control = avx2.vmovdqu.rodata.xmm @control
  return %control
}

// ====

// RUN: verify

x86.target<avx2> @target

low.func.def target<x86.avx2.core>(@target) @missing_control() -> (reg<x86.xmm>) asm {
  // ERROR@+1: SYMBOL/002 {symbol_name="missing_data"}
  %control = avx2.vmovdqu.rodata.xmm @missing_data
  return %control
}

// ====

// RUN: verify

x86.target<avx2> @target

global.constant @not_rodata : f32

low.func.def target<x86.avx2.core>(@target) @wrong_control_kind() -> (reg<x86.xmm>) asm {
  // ERROR@+1: SYMBOL/003 {symbol_name="not_rodata", actual_kind="global.constant", expected_kind="global.rodata.def"}
  %control = avx2.vmovdqu.rodata.xmm @not_rodata
  return %control
}
