{
  "version": 1,
  "cases": [
    {
      "name": "specializes imported C++ workgroup storage",
      "steps": [
        {
          "name": "import-once",
          "run": {
            "tool": "loom-import-cxx",
            "args": [
              "{srcdir}/../../../../../import/cxx/test/configured_workgroup_storage.cxx",
              "--to=bc",
              "--output={tmp}/imported.loombc"
            ]
          },
          "files": [
            {"path": "{tmp}/imported.loombc", "non_empty": true}
          ]
        },
        {
          "name": "roundtrip-bytecode",
          "run": {
            "tool": "loom-format",
            "args": [
              "{tmp}/imported.loombc",
              "--to=bc",
              "--output={tmp}/roundtrip.loombc"
            ]
          },
          "files": [
            {"path": "{tmp}/roundtrip.loombc", "non_empty": true}
          ]
        },
        {
          "name": "inspect-roundtrip",
          "run": {
            "tool": "loom-format",
            "args": [
              "{tmp}/roundtrip.loombc",
              "--output={tmp}/roundtrip.loom"
            ]
          },
          "files": [
            {
              "path": "{tmp}/roundtrip.loom",
              "contains": [
                "config.decl @test.buffer.stage_count",
                {"regex": "range\\([^,]+, 1, 100000\\)"},
                "buffer.alloca<workgroup> align(64)",
                "func.def inline @store_stage"
              ]
            }
          ]
        },
        {
          "name": "compile-one-stage",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/roundtrip.loombc",
              "--root=@configured_workgroup_storage",
              "--target=amdgpu:gfx1151",
              "--config=test.buffer.stage_count=1",
              "--format=amdgpu-hsaco",
              "--output={tmp}/one-stage.hsaco",
              "--compile-report=summary",
              "--compile-report-output={tmp}/one-stage.json"
            ]
          },
          "files": [
            {"path": "{tmp}/one-stage.hsaco", "non_empty": true},
            {
              "path": "{tmp}/one-stage.json",
              "contains": {
                "unordered": [
                  "\"key\":\"test.buffer.stage_count\",\"value\":\"1\"",
                  {"regex": "\"name\":\"amdgpu\\.lds\"[^}]*\"units\":128"},
                  "\"local_memory_bytes\":128"
                ]
              }
            }
          ]
        },
        {
          "name": "compile-four-stages",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/roundtrip.loombc",
              "--root=@configured_workgroup_storage",
              "--target=amdgpu:gfx1151",
              "--config=test.buffer.stage_count=4",
              "--format=amdgpu-hsaco",
              "--output={tmp}/four-stages.hsaco",
              "--compile-report=summary",
              "--compile-report-output={tmp}/four-stages.json"
            ]
          },
          "files": [
            {"path": "{tmp}/four-stages.hsaco", "non_empty": true},
            {
              "path": "{tmp}/four-stages.json",
              "contains": {
                "unordered": [
                  "\"key\":\"test.buffer.stage_count\",\"value\":\"4\"",
                  {"regex": "\"name\":\"amdgpu\\.lds\"[^}]*\"units\":512"},
                  "\"local_memory_bytes\":512"
                ]
              }
            }
          ]
        },
        {
          "name": "reject-out-of-range-stage-count",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/roundtrip.loombc",
              "--root=@configured_workgroup_storage",
              "--target=amdgpu:gfx1151",
              "--config=test.buffer.stage_count=0",
              "--format=amdgpu-hsaco",
              "--output={tmp}/invalid.hsaco"
            ]
          },
          "exit": 1,
          "stderr": {
            "contains": [
              "error [CONFIG/INVALID]",
              "symbol '@test.buffer.stage_count' value 0 violates constraint 'range'"
            ]
          },
          "files": [
            {"path": "{tmp}/invalid.hsaco", "exists": false}
          ]
        },
        {
          "name": "reject-target-capacity",
          "run": {
            "tool": "loom-compile",
            "args": [
              "{tmp}/roundtrip.loombc",
              "--root=@configured_workgroup_storage",
              "--target=amdgpu:gfx1151",
              "--config=test.buffer.stage_count=100000",
              "--format=amdgpu-hsaco",
              "--output={tmp}/over-capacity.hsaco"
            ]
          },
          "exit": 1,
          "stderr": {
            "contains": [
              "configured_workgroup_storage.cxx",
              "error [TARGET/051]",
              "reserves 12800000 byte(s) of workgroup storage, exceeding target limit 65536"
            ]
          },
          "files": [
            {"path": "{tmp}/over-capacity.hsaco", "exists": false}
          ]
        }
      ]
    }
  ]
}
