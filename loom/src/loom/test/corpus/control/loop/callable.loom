// Function inputs bind the vector shape while separate header arguments carry
// changing values. Independent calls instantiate different widths and counts.
func.def inline @callable_repeat(%width: index, %value: vector<[%width]xf32>, %count: i32) -> (vector<[%width]xf32>) {
  cfg.br ^header(%value: vector<[%width]xf32>, %count: i32)
^header(%carried: vector<[%width]xf32>, %remaining: i32):
  %c0 = scalar.constant 0 : i32
  %again = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %again, ^step, ^exit
^step:
  %c1 = scalar.constant 1 : i32
  %next_count = scalar.subi %remaining, %c1 : i32
  %next_value = vector.addf %carried, %carried : vector<[%width]xf32>
  cfg.br ^header(%next_value: vector<[%width]xf32>, %next_count: i32)
^exit:
  func.return %carried : vector<[%width]xf32>
}

// The precondition constrains the initial count; the carried count decreases.
func.def inline @callable_countdown(%count: i32) -> (i32) where [eq(%count, 3)] {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  cfg.br ^header(%count: i32, %c0: i32)
^header(%remaining: i32, %total: i32):
  %again = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %again, ^step, ^exit
^step:
  %next_count = scalar.subi %remaining, %c1 : i32
  %next_total = scalar.addi %total, %remaining : i32
  cfg.br ^header(%next_count: i32, %next_total: i32)
^exit:
  func.return %total : i32
}

kernel.def @callable_loops() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%left_count: i32, %right_count: i32, %input: buffer, %output: buffer) {
  func.call @compute_callable_loops(%left_count, %right_count, %input, %output) : (i32, i32, buffer, buffer)
  kernel.return
}

func.def device inline @compute_callable_loops(%left_count: i32, %right_count: i32, %input: buffer, %output: buffer) {
  %pair_width = index.constant 2 : index
  %quad_width = index.constant 4 : index
  %base = index.constant 0 : offset
  %quad_base = index.constant 8 : offset
  %total_base = index.constant 24 : offset
  %aligned_input = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %aligned_output = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %pair_input = buffer.view %aligned_input[%base] : buffer -> view<2xf32>
  %quad_input = buffer.view %aligned_input[%quad_base] : buffer -> view<4xf32>
  %pair_output = buffer.view %aligned_output[%base] : buffer -> view<2xf32>
  %quad_output = buffer.view %aligned_output[%quad_base] : buffer -> view<4xf32>
  %total_output = buffer.view %aligned_output[%total_base] : buffer -> view<1xi32>
  %pair = vector.load %pair_input[0] : view<2xf32> -> vector<[%pair_width]xf32>
  %quad = vector.load %quad_input[0] : view<4xf32> -> vector<[%quad_width]xf32>
  %left = func.call @callable_repeat(%pair_width, %pair, %left_count) : (index, vector<[%pair_width]xf32>, i32) -> (vector<[%pair_width]xf32>)
  %right = func.call @callable_repeat(%quad_width, %quad, %right_count) : (index, vector<[%quad_width]xf32>, i32) -> (vector<[%quad_width]xf32>)
  %initial_count = scalar.constant 3 : i32
  %total = func.call @callable_countdown(%initial_count) : (i32) -> (i32)
  vector.store %left, %pair_output[0] : vector<[%pair_width]xf32>, view<2xf32>
  vector.store %right, %quad_output[0] : vector<[%quad_width]xf32>, view<4xf32>
  view.store %total, %total_output[0] : i32, view<1xi32>
  func.return
}

func.def inline @callable_repeat_scalar(%value: f32, %count: i32) -> (f32) {
  cfg.br ^header(%value: f32, %count: i32)
^header(%carried: f32, %remaining: i32):
  %c0 = scalar.constant 0 : i32
  %again = scalar.cmpi sgt, %remaining, %c0 : i32
  cfg.cond_br %again, ^step, ^exit
^step:
  %c1 = scalar.constant 1 : i32
  %next_count = scalar.subi %remaining, %c1 : i32
  %next_value = scalar.addf %carried, %carried : f32
  cfg.br ^header(%next_value: f32, %next_count: i32)
^exit:
  func.return %carried : f32
}

func.def @callable_loops_oracle(%left_count: i32, %right_count: i32, %input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %input_view = buffer.view %input[%base] : buffer -> view<6xf32>
  %output_view = buffer.view %output[%base] : buffer -> view<7xf32>
  %total_output = buffer.view %output[%base] : buffer -> view<7xi32>
  %input0 = view.load %input_view[0] : view<6xf32> -> f32
  %input1 = view.load %input_view[1] : view<6xf32> -> f32
  %input2 = view.load %input_view[2] : view<6xf32> -> f32
  %input3 = view.load %input_view[3] : view<6xf32> -> f32
  %input4 = view.load %input_view[4] : view<6xf32> -> f32
  %input5 = view.load %input_view[5] : view<6xf32> -> f32
  %output0 = func.call @callable_repeat_scalar(%input0, %left_count) : (f32, i32) -> (f32)
  %output1 = func.call @callable_repeat_scalar(%input1, %left_count) : (f32, i32) -> (f32)
  %output2 = func.call @callable_repeat_scalar(%input2, %right_count) : (f32, i32) -> (f32)
  %output3 = func.call @callable_repeat_scalar(%input3, %right_count) : (f32, i32) -> (f32)
  %output4 = func.call @callable_repeat_scalar(%input4, %right_count) : (f32, i32) -> (f32)
  %output5 = func.call @callable_repeat_scalar(%input5, %right_count) : (f32, i32) -> (f32)
  view.store %output0, %output_view[0] : f32, view<7xf32>
  view.store %output1, %output_view[1] : f32, view<7xf32>
  view.store %output2, %output_view[2] : f32, view<7xf32>
  view.store %output3, %output_view[3] : f32, view<7xf32>
  view.store %output4, %output_view[4] : f32, view<7xf32>
  view.store %output5, %output_view[5] : f32, view<7xf32>
  %initial_count = scalar.constant 3 : i32
  %total = func.call @callable_countdown(%initial_count) : (i32) -> (i32)
  view.store %total, %total_output[6] : i32, view<7xi32>
  func.return
}

check.scenario @callable_loop_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %left_count = check.literal value(0) : i32
    %right_count = check.literal value(0) : i32
    %input = check.generate.iota offset(1.0) step(1.0) : tensor<6xf32>
    %storage = check.generate.fill value(-1.0) : tensor<15xf32>
    %output = check.tensor.view %storage offset(16) : tensor<15xf32> -> tensor<7xf32>
    check.compare<@callable_loops, @callable_loops_oracle>(%left_count, %right_count, %input, %output) : (i32, i32, tensor<6xf32>, tensor<7xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<6xf32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<15xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %left_count = check.literal value(1) : i32
    %right_count = check.literal value(1) : i32
    %input = check.generate.iota offset(1.0) step(1.0) : tensor<6xf32>
    %storage = check.generate.fill value(-1.0) : tensor<15xf32>
    %output = check.tensor.view %storage offset(16) : tensor<15xf32> -> tensor<7xf32>
    check.compare<@callable_loops, @callable_loops_oracle>(%left_count, %right_count, %input, %output) : (i32, i32, tensor<6xf32>, tensor<7xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<6xf32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<15xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %left_count = check.literal value(3) : i32
    %right_count = check.literal value(5) : i32
    %input = check.generate.iota offset(1.0) step(1.0) : tensor<6xf32>
    %storage = check.generate.fill value(-1.0) : tensor<15xf32>
    %output = check.tensor.view %storage offset(16) : tensor<15xf32> -> tensor<7xf32>
    check.compare<@callable_loops, @callable_loops_oracle>(%left_count, %right_count, %input, %output) : (i32, i32, tensor<6xf32>, tensor<7xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<6xf32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<15xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %left_count = check.literal value(0) : i32
    %right_count = check.literal value(3) : i32
    %input = check.generate.iota offset(1.0) step(1.0) : tensor<6xf32>
    %storage = check.generate.fill value(-1.0) : tensor<15xf32>
    %output = check.tensor.view %storage offset(16) : tensor<15xf32> -> tensor<7xf32>
    check.compare<@callable_loops, @callable_loops_oracle>(%left_count, %right_count, %input, %output) : (i32, i32, tensor<6xf32>, tensor<7xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<6xf32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<15xf32>
    }
  }
  check.return
}
