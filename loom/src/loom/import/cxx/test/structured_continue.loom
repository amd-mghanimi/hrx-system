func.def @continue_scheduled_input(%input: buffer) {
  %length = buffer.length %input
  %bounded_length = index.assume %length [range(%length, 4, 8448)] : offset
  %length_index = index.cast %bounded_length : offset to index
  %element_bytes = index.constant 4 : index
  %element_count_unbounded = index.div %length_index, %element_bytes : index
  %element_count = index.assume %element_count_unbounded [range(%element_count_unbounded, 1, 2112)] : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c7 = scalar.constant 7 : i32
  %c17 = scalar.constant 17 : i32
  %c251 = scalar.constant 251 : i32
  %values = buffer.view %input[%origin] : buffer -> view<[%element_count]xi32>
  scf.for %position = [%begin to %element_count step %step] {
    %position_i32 = index.cast %position : index to i32
    %scaled = scalar.muli %position_i32, %c17 : i32
    %shifted = scalar.addi %scaled, %c7 : i32
    %value = scalar.remui %shifted, %c251 : i32
    view.store %value, %values[%position] : i32, view<[%element_count]xi32>
  }
  func.return
}

func.def @continue_scheduled_oracle(%input: buffer, %output: buffer, %count: i32, %choose: i32) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 4, 8448)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %element_bytes = index.constant 4 : index
  %input_count_unbounded = index.div %input_bytes, %element_bytes : index
  %input_count = index.assume %input_count_unbounded [range(%input_count_unbounded, 1, 2112)] : index
  %count_unbounded = index.cast %count : i32 to index
  %count_index = index.assume %count_unbounded [range(%count_unbounded, 0, 33)] : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %lane_end = index.constant 64 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %c7 = scalar.constant 7 : i32
  %results = buffer.view %output[%origin] : buffer -> view<64x4xi32>
  scf.for %lane = [%begin to %lane_end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %lane_low = scalar.andi %lane_i32, %c7 : i32
    %mask = scalar.xori %choose, %lane_low : i32
    %row = index.mul %lane, %count_index : index
    %sum = scf.for %column = [%begin to %count_index step %step](%total = %c0 : i32) -> (i32) {
      %position = index.add %row, %column : index
      %bounded_position, %bounded_count = index.assume %position, %input_count [range(%position, 0, 2111), lt(%position, %input_count)] : index, index
      %bounded_values = buffer.view %input[%origin] : buffer -> view<[%bounded_count]xi32>
      %value = view.load %bounded_values[%bounded_position] : view<[%bounded_count]xi32> -> i32
      %column_i32 = index.cast %column : index to i32
      %masked = scalar.andi %column_i32, %mask : i32
      %selected = scalar.cmpi eq, %masked, %c0 : i32
      %contribution = scf.select %selected, %value, %c0 : i32
      %next = scalar.addi %total, %contribution : i32
      scf.yield %next : i32
    }
    view.store %sum, %results[%lane, 0] : i32, view<64x4xi32>
    view.store %sum, %results[%lane, 1] : i32, view<64x4xi32>
    view.store %sum, %results[%lane, 2] : i32, view<64x4xi32>
    view.store %sum, %results[%lane, 3] : i32, view<64x4xi32>
  }
  func.return
}

func.def @continue_copy_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 1024 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %values = buffer.view %input[%origin] : buffer -> view<1024xi32>
  %results = buffer.view %output[%origin] : buffer -> view<1024xi32>
  scf.for %position = [%begin to %end step %step] {
    %position_i32 = index.cast %position : index to i32
    %low = scalar.andi %position_i32, %c1 : i32
    %odd = scalar.cmpi ne, %low, %c0 : i32
    scf.if %odd {
      %value = view.load %values[%position] : view<1024xi32> -> i32
      view.store %value, %results[%position] : i32, view<1024xi32>
    }
  }
  func.return
}

func.def @continue_pointer_input(%input: buffer) {
  %length = buffer.length %input
  %bounded_length = index.assume %length [range(%length, 4, 8448)] : offset
  %length_index = index.cast %bounded_length : offset to index
  %element_bytes = index.constant 4 : index
  %element_count_unbounded = index.div %length_index, %element_bytes : index
  %element_count = index.assume %element_count_unbounded [range(%element_count_unbounded, 1, 2112)] : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c7 = scalar.constant 7 : i32
  %c37 = scalar.constant 37 : i32
  %values = buffer.view %input[%origin] : buffer -> view<[%element_count]xi32>
  scf.for %position = [%begin to %element_count step %step] {
    %position_i32 = index.cast %position : index to i32
    %scaled = scalar.muli %position_i32, %c7 : i32
    %value = scalar.remui %scaled, %c37 : i32
    view.store %value, %values[%position] : i32, view<[%element_count]xi32>
  }
  func.return
}

func.def @continue_pointers_oracle(%input: buffer, %output: buffer, %length: i32, %choose: i32) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 4, 8448)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %element_bytes = index.constant 4 : index
  %input_count_unbounded = index.div %input_bytes, %element_bytes : index
  %input_count = index.assume %input_count_unbounded [range(%input_count_unbounded, 1, 2112)] : index
  %length_unbounded = index.cast %length : i32 to index
  %length_index = index.assume %length_unbounded [range(%length_unbounded, 0, 33)] : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %lane_end = index.constant 64 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %results = buffer.view %output[%origin] : buffer -> view<64x34xi32>
  scf.for %lane = [%begin to %lane_end step %step] {
    %row = index.mul %lane, %length_index : index
    %stored = scf.for %position = [%begin to %length_index step %step](%stored_count = %begin : index) -> (index) {
      %input_position = index.add %row, %position : index
      %bounded_position, %bounded_count = index.assume %input_position, %input_count [range(%input_position, 0, 2111), lt(%input_position, %input_count)] : index, index
      %values = buffer.view %input[%origin] : buffer -> view<[%bounded_count]xi32>
      %value = view.load %values[%bounded_position] : view<[%bounded_count]xi32> -> i32
      %masked = scalar.andi %value, %choose : i32
      %selected = scalar.cmpi ne, %masked, %c0 : i32
      %next_count = scf.if %selected -> (index) {
        %bounded_stored = index.assume %stored_count [range(%stored_count, 0, 32)] : index
        view.store %value, %results[%lane, %bounded_stored] : i32, view<64x34xi32>
        %next = index.add %stored_count, %step : index
        scf.yield %next : index
      } else {
        scf.yield %stored_count : index
      }
      scf.yield %next_count : index
    }
    %stored_i32 = index.cast %stored : index to i32
    view.store %stored_i32, %results[%lane, 33] : i32, view<64x34xi32>
  }
  func.return
}

func.def @continue_vectors_oracle(%output: buffer, %count: i32, %choose: i32) {
  %count_unbounded = index.cast %count : i32 to index
  %count_index = index.assume %count_unbounded [range(%count_unbounded, 0, 31)] : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c17 = scalar.constant 17 : i32
  %c31 = scalar.constant 31 : i32
  %c63 = scalar.constant 63 : i32
  %c127 = scalar.constant 127 : i32
  %first, %second, %third, %fourth = scf.for %iteration = [%begin to %count_index step %step](%first_value = %c1 : i32, %second_value = %c2 : i32, %third_value = %c3 : i32, %fourth_value = %c4 : i32) -> (i32, i32, i32, i32) {
    %index = index.cast %iteration : index to i32
    %second_increment = scalar.muli %index, %c2 : i32
    %third_increment = scalar.muli %index, %c3 : i32
    %fourth_increment = scalar.muli %index, %c4 : i32
    %first_added = scalar.addi %first_value, %index : i32
    %second_added = scalar.addi %second_value, %second_increment : i32
    %third_added = scalar.addi %third_value, %third_increment : i32
    %fourth_added = scalar.addi %fourth_value, %fourth_increment : i32
    %masked = scalar.andi %index, %choose : i32
    %selected = scalar.cmpi eq, %masked, %c0 : i32
    %first_xor = scalar.xori %first_added, %c17 : i32
    %second_xor = scalar.xori %second_added, %c31 : i32
    %third_xor = scalar.xori %third_added, %c63 : i32
    %fourth_xor = scalar.xori %fourth_added, %c127 : i32
    %next_first = scf.select %selected, %first_xor, %first_added : i32
    %next_second = scf.select %selected, %second_xor, %second_added : i32
    %next_third = scf.select %selected, %third_xor, %third_added : i32
    %next_fourth = scf.select %selected, %fourth_xor, %fourth_added : i32
    scf.yield %next_first, %next_second, %next_third, %next_fourth : i32, i32, i32, i32
  }
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  view.store %first, %results[0] : i32, view<4xi32>
  view.store %second, %results[1] : i32, view<4xi32>
  view.store %third, %results[2] : i32, view<4xi32>
  view.store %fourth, %results[3] : i32, view<4xi32>
  func.return
}

check.scenario @structured_continue_functions {
  check.trial[49](%trial: index, %entropy: check.entropy) {
    %count, %choose = check.generate<@continue_function_config>(%trial) : (index) -> (i32, i32)
    %output = check.generate.fill value(-123) : tensor<8xi32>
    check.compare<@continue_function_observations, @continue_function_oracle>(%count, %choose, %output) : (i32, i32, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.return
}

check.scenario @structured_continue_cases {
  check.trial[12](%trial: index, %entropy: check.entropy) {
    %count, %choose = check.generate<@continue_value_config>(%trial) : (index) -> (i32, i32)
    %storage = check.generate.fill value(-123) : tensor<544xi32>
    %output = check.tensor.view %storage offset(64) : tensor<544xi32> -> tensor<512xi32>
    check.compare<@continue_values, @continue_values_oracle>(%output, %count, %choose) : (tensor<512xi32>, i32, i32) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<544xi32>
    }
  }
  check.trial[12](%trial: index, %entropy: check.entropy) {
    %count, %choose, %input_count = check.generate<@continue_schedule_config>(%trial) : (index) -> (i32, i32, index)
    %input = check.generate.fill value(0) : tensor<[%input_count]xi32>
    check.generate<@continue_scheduled_input>(%input) : (tensor<[%input_count]xi32>) -> ()
    %storage = check.generate.fill value(-123) : tensor<288xi32>
    %output = check.tensor.view %storage offset(64) : tensor<288xi32> -> tensor<256xi32>
    check.compare<@continue_scheduled, @continue_scheduled_oracle>(%input, %output, %count, %choose) : (tensor<[%input_count]xi32>, tensor<256xi32>, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_count]xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<288xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(3) step(7) : tensor<1024xi32>
    %storage = check.generate.fill value(-123) : tensor<1056xi32>
    %output = check.tensor.view %storage offset(64) : tensor<1056xi32> -> tensor<1024xi32>
    check.compare<@continue_copy, @continue_copy_oracle>(%input, %output) : (tensor<1024xi32>, tensor<1024xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1024xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<1056xi32>
    }
  }
  check.trial[15](%trial: index, %entropy: check.entropy) {
    %length, %choose, %input_count = check.generate<@continue_pointer_config>(%trial) : (index) -> (i32, i32, index)
    %input = check.generate.fill value(0) : tensor<[%input_count]xi32>
    check.generate<@continue_pointer_input>(%input) : (tensor<[%input_count]xi32>) -> ()
    %storage = check.generate.fill value(-123) : tensor<2208xi32>
    %output = check.tensor.view %storage offset(64) : tensor<2208xi32> -> tensor<2176xi32>
    check.compare<@continue_pointers, @continue_pointers_oracle>(%input, %output, %length, %choose) : (tensor<[%input_count]xi32>, tensor<2176xi32>, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_count]xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<2208xi32>
    }
  }
  check.trial[15](%trial: index, %entropy: check.entropy) {
    %count, %choose = check.generate<@continue_vector_config>(%trial) : (index) -> (i32, i32)
    %storage = check.generate.fill value(-123) : tensor<36xi32>
    %output = check.tensor.view %storage offset(64) : tensor<36xi32> -> tensor<4xi32>
    check.compare<@continue_vectors, @continue_vectors_oracle>(%output, %count, %choose) : (tensor<4xi32>, i32, i32) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<36xi32>
    }
  }
  check.return
}
