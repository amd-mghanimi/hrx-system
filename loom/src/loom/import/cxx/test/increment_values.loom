  %c7_index = index.constant 7 : index
  %c8_index = index.constant 8 : index
  %c9_index = index.constant 9 : index
  %c1_i32 = scalar.constant 1 : i32
  %c7_i32 = scalar.constant 7 : i32
  %c31_i32 = scalar.constant 31 : i32
  %c32_i64 = scalar.constant 32 : i64
  %wide_multiplier = scalar.constant 4294967297 : i64
  %input_wide = scalar.extui %input : i32 to i64
  %wide_base = scalar.muli %input_wide, %wide_multiplier : i64
  %results = buffer.view %output[%origin] : buffer -> view<640xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %lane_i64 = index.cast %lane : index to i64
    %value = scalar.addi %input, %lane_i32 : i32
    %wide_input = scalar.addi %wide_base, %lane_i64 : i64
    %byte = func.call @increment_byte_oracle(%value) : (i32) -> (i32)
    %short_input = scalar.subi %lane_i32, %c31_i32 : i32
    %short = func.call @decrement_short_oracle(%short_input) : (i32) -> (i32)
    %wide = func.call @increment_wide_oracle(%wide_input) : (i64) -> (i64)
    %wide_low = scalar.trunci %wide : i64 to i32
    %wide_high_i64 = scalar.shrui %wide, %c32_i64 : i64
    %wide_high = scalar.trunci %wide_high_i64 : i64 to i32
    %chain = func.call @increment_chain_oracle(%value) : (i32) -> (i32)
    %choose = scalar.andi %lane_i32, %c1_i32 : i32
    %or_result = func.call @increment_or_oracle(%value, %choose) : (i32, i32) -> (i32)
    %select_choose = scalar.andi %lane_i32, %c7_i32 : i32
    %select_result = func.call @increment_select_oracle(%value, %select_choose) : (i32, i32) -> (i32)
    %condition = func.call @increment_condition_oracle(%value) : (i32) -> (i32)
    %count = scalar.andi %lane_i32, %c7_i32 : i32
    %while_result = func.call @increment_while_oracle(%count) : (i32) -> (i32)
    %do_result = func.call @increment_do_oracle(%count) : (i32) -> (i32)
    %position_0 = index.mul %lane, %field_count : index
    %position_1 = index.add %position_0, %c1_index : index
    %position_2 = index.add %position_0, %c2_index : index
    %position_3 = index.add %position_0, %c3_index : index
    %position_4 = index.add %position_0, %c4_index : index
    %position_5 = index.add %position_0, %c5_index : index
    %position_6 = index.add %position_0, %c6_index : index
    %position_7 = index.add %position_0, %c7_index : index
    %position_8 = index.add %position_0, %c8_index : index
    %position_9 = index.add %position_0, %c9_index : index
    view.store %byte, %results[%position_0] : i32, view<640xi32>
    view.store %short, %results[%position_1] : i32, view<640xi32>
    view.store %wide_low, %results[%position_2] : i32, view<640xi32>
    view.store %wide_high, %results[%position_3] : i32, view<640xi32>
    view.store %chain, %results[%position_4] : i32, view<640xi32>
    view.store %or_result, %results[%position_5] : i32, view<640xi32>
    view.store %select_result, %results[%position_6] : i32, view<640xi32>
    view.store %condition, %results[%position_7] : i32, view<640xi32>
    view.store %while_result, %results[%position_8] : i32, view<640xi32>
    view.store %do_result, %results[%position_9] : i32, view<640xi32>
  }
  func.return
}

func.def @increment_pointers_oracle(%input: buffer, %output: buffer, %length: i32, %choose: i32) {
  %input_length = buffer.length %input
  %bounded_input_length = index.assume %input_length [range(%input_length, 4, 2048)] : offset
  %input_bytes = index.cast %bounded_input_length : offset to index
  %element_bytes = index.constant 4 : index
  %unbounded_count = index.div %input_bytes, %element_bytes : index
  %input_count = index.assume %unbounded_count [range(%unbounded_count, 1, 512)] : index
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %input_stride = index.constant 8 : index
  %output_stride = index.constant 12 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c4_i32 = scalar.constant 4 : i32
  %c1_index = index.constant 1 : index
  %c2_index = index.constant 2 : index
  %c3_index = index.constant 3 : index
  %c4_index = index.constant 4 : index
  %c5_index = index.constant 5 : index
  %c6_index = index.constant 6 : index
  %c7_index = index.constant 7 : index
  %c8_index = index.constant 8 : index
  %c9_index = index.constant 9 : index
  %c10_index = index.constant 10 : index
  %c11_index = index.constant 11 : index
  %length_index = index.cast %length : i32 to index
  %bounded_length = index.assume %length_index [range(%length_index, 0, 64)] : index
  %choose_0 = scalar.andi %choose, %c1_i32 : i32
  %choose_1 = scalar.andi %choose, %c2_i32 : i32
  %choose_2 = scalar.andi %choose, %c4_i32 : i32
  %bit_0 = scalar.cmpi ne, %choose_0, %c0_i32 : i32
  %bit_1 = scalar.cmpi ne, %choose_1, %c0_i32 : i32
  %bit_2 = scalar.cmpi ne, %choose_2, %c0_i32 : i32
  %results = buffer.view %output[%origin] : buffer -> view<768xi32>
  scf.for %lane = [%begin to %bounded_length step %step] {
    %input_base = index.mul %lane, %input_stride : index
    %input_1_position = index.add %input_base, %c1_index : index
    %input_2_position = index.add %input_base, %c2_index : index
    %input_3_position = index.add %input_base, %c3_index : index
    %input_1_bounded, %input_2_bounded, %input_3_bounded, %early_input_count = index.assume %input_1_position, %input_2_position, %input_3_position, %input_count [range(%input_1_position, 0, 511), range(%input_2_position, 0, 511), range(%input_3_position, 0, 511), lt(%input_1_position, %input_count), lt(%input_2_position, %input_count), lt(%input_3_position, %input_count)] : index, index, index, index
    %early_inputs = buffer.view %input[%origin] : buffer -> view<[%early_input_count]xi32>
    %input_1 = view.load %early_inputs[%input_1_bounded] : view<[%early_input_count]xi32> -> i32
    %input_2 = view.load %early_inputs[%input_2_bounded] : view<[%early_input_count]xi32> -> i32
    %input_3 = view.load %early_inputs[%input_3_bounded] : view<[%early_input_count]xi32> -> i32
    %selected = scf.select %bit_0, %input_1, %input_2 : i32
    %input_2_nonzero = scalar.cmpi ne, %input_2, %c0_i32 : i32
    %accepted = scalar.ori %bit_1, %input_2_nonzero : i1
    %accepted_i32 = scalar.extui %accepted : i1 to i32
    %cursor_after_accepted = scf.select %bit_1, %c2_index, %c3_index : index
    %guard_position = index.add %input_base, %cursor_after_accepted : index
    %guard_bounded, %guard_input_count = index.assume %guard_position, %input_count [range(%guard_position, 0, 511), lt(%guard_position, %input_count)] : index, index
    %guard_inputs = buffer.view %input[%origin] : buffer -> view<[%guard_input_count]xi32>
    %guard_value = view.load %guard_inputs[%guard_bounded] : view<[%guard_input_count]xi32> -> i32
    %guard_nonzero = scalar.cmpi ne, %guard_value, %c0_i32 : i32
    %guarded = scalar.andi %bit_2, %guard_nonzero : i1
    %guarded_i32 = scalar.extui %guarded : i1 to i32
    %cursor_incremented = index.add %cursor_after_accepted, %c1_index : index
    %final_cursor = scf.select %bit_2, %cursor_incremented, %cursor_after_accepted : index
    %final_position = index.add %input_base, %final_cursor : index
    %next_position = index.add %final_position, %c1_index : index
    %after_position = index.add %final_position, %c2_index : index
    %final_bounded, %next_bounded, %after_bounded, %final_input_count = index.assume %final_position, %next_position, %after_position, %input_count [range(%final_position, 0, 511), range(%next_position, 0, 511), range(%after_position, 0, 511), lt(%final_position, %input_count), lt(%next_position, %input_count), lt(%after_position, %input_count)] : index, index, index, index
    %final_inputs = buffer.view %input[%origin] : buffer -> view<[%final_input_count]xi32>
    %final_value = view.load %final_inputs[%final_bounded] : view<[%final_input_count]xi32> -> i32
    %next_value = view.load %final_inputs[%next_bounded] : view<[%final_input_count]xi32> -> i32
    %after_value = view.load %final_inputs[%after_bounded] : view<[%final_input_count]xi32> -> i32
    %total = scalar.addi %final_value, %next_value : i32
    %output_0 = index.mul %lane, %output_stride : index
    %output_1 = index.add %output_0, %c1_index : index
    %output_2 = index.add %output_0, %c2_index : index
    %output_3 = index.add %output_0, %c3_index : index
    %output_4 = index.add %output_0, %c4_index : index
    %output_5 = index.add %output_0, %c5_index : index
    %output_6 = index.add %output_0, %c6_index : index
    %output_7 = index.add %output_0, %c7_index : index
    %output_8 = index.add %output_0, %c8_index : index
    %output_9 = index.add %output_0, %c9_index : index
    %output_10 = index.add %output_0, %c10_index : index
    %output_11 = index.add %output_0, %c11_index : index
    view.store %input_1, %results[%output_0] : i32, view<768xi32>
    view.store %input_3, %results[%output_1] : i32, view<768xi32>
    view.store %input_3, %results[%output_2] : i32, view<768xi32>
    view.store %input_1, %results[%output_3] : i32, view<768xi32>
    view.store %selected, %results[%output_4] : i32, view<768xi32>
    view.store %input_2, %results[%output_5] : i32, view<768xi32>
    view.store %accepted_i32, %results[%output_6] : i32, view<768xi32>
    view.store %guard_value, %results[%output_7] : i32, view<768xi32>
    view.store %guarded_i32, %results[%output_8] : i32, view<768xi32>
    view.store %final_value, %results[%output_9] : i32, view<768xi32>
    view.store %total, %results[%output_10] : i32, view<768xi32>
    view.store %after_value, %results[%output_11] : i32, view<768xi32>
  }
  func.return
}

check.scenario @increment_values_functions {
  check.trial[256](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@increment_byte_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@increment_byte_observation, @increment_byte_reference>(%input, %output) : (i32, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[7](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@increment_short_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@decrement_short_observation, @decrement_short_reference>(%input, %output) : (i32, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[9](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@increment_wide_input>(%trial) : (index) -> (i64)
    %output = check.generate.fill value(-123) : tensor<1xi64>
    check.compare<@increment_wide_observation, @increment_wide_reference>(%input, %output) : (i64, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi64>
    }
  }
  check.trial[20](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@increment_value_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<2xi32>
    check.compare<@increment_chain_condition_observations, @increment_chain_condition_reference>(%input, %output) : (i32, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[40](%trial: index, %entropy: check.entropy) {
    %input, %choose = check.generate<@increment_or_input>(%trial) : (index) -> (i32, i32)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@increment_or_observation, @increment_or_reference>(%input, %choose, %output) : (i32, i32, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[160](%trial: index, %entropy: check.entropy) {
    %input, %choose = check.generate<@increment_select_input>(%trial) : (index) -> (i32, i32)
    %output = check.generate.fill value(-123) : tensor<1xi32>
    check.compare<@increment_select_observation, @increment_select_reference>(%input, %choose, %output) : (i32, i32, tensor<1xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xi32>
    }
  }
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %count = check.generate<@increment_loop_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<2xi32>
    check.compare<@increment_loop_observations, @increment_loop_reference>(%count, %output) : (i32, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}

check.scenario @increment_kernel_values {
  check.trial[8](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@increment_kernel_input>(%trial) : (index) -> (i32)
    %storage = check.generate.fill value(-123) : tensor<672xi32>
    %output = check.tensor.view %storage offset(64) : tensor<672xi32> -> tensor<640xi32>
    check.compare<@increment_values, @increment_values_oracle>(%output, %input) : (tensor<640xi32>, i32) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<672xi32>
    }
  }
  check.trial[9](%trial: index, %entropy: check.entropy) {
    %length, %choose, %input_count = check.generate<@increment_pointer_config>(%trial) : (index) -> (i32, i32, index)
    %input = check.generate.fill value(0) : tensor<[%input_count]xi32>
    check.generate<@increment_pointer_input>(%input) : (tensor<[%input_count]xi32>) -> ()
    %storage = check.generate.fill value(-123) : tensor<800xi32>
    %output = check.tensor.view %storage offset(64) : tensor<800xi32> -> tensor<768xi32>
    check.compare<@increment_pointers, @increment_pointers_oracle>(%input, %output, %length, %choose) : (tensor<[%input_count]xi32>, tensor<768xi32>, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<[%input_count]xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<800xi32>
    }
  }
  check.return
}
