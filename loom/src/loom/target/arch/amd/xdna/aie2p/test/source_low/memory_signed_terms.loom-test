// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// Exact AIE2P address-materialization contracts not owned by executable scenarios.

func.def @signed_irregular_stride(%input: buffer, %table: buffer) -> (i32) {
  %source_origin = index.constant 0 : offset
  %source = buffer.view %input[%source_origin] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %position = index.cast %signed : i32 to index
  %bias = index.constant 128 : index
  %ordinal = index.add %position, %bias : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [3] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<256xi32, %layout>
  %value = view.load %view[%ordinal] : view<256xi32, %layout> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @signed_irregular_stride() -> (reg<aie2p.er>) asm {
  %source = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %signed = lda %source, 0
  %18 = mov.static-byte-offset 1536
  %19 = mov.i32 12
  %20 = mac %18, %signed, %19
  %21 = mov.address-index %20
  %value = lda.i32.index %view, %21
  return %value
}

// ====

func.def @signed_dynamic_stride(%input: buffer, %bias0: index, %stride0: index, %table: buffer) -> (i32) {
  %source_origin = index.constant 0 : offset
  %source = buffer.view %input[%source_origin] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %coordinate = index.cast %signed : i32 to index
  %bias = index.assume %bias0 [range(%bias0, 128, 256)] : index
  %stride = index.assume %stride0 [range(%stride0, 1, 16)] : index
  %position = index.add %coordinate, %bias : index
  %base = index.constant 0 : offset
  %layout = encoding.layout.strided [%stride] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<512xi32, %layout>
  %value = view.load %view[%position] : view<512xi32, %layout> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @signed_dynamic_stride(%bias: reg<aie2p.er>, %stride: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %source = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %view = resource<native_pointer> {index = 3, source_type = buffer} : reg<aie2p.ep>
  %signed = lda %source, 0
  %23 = mul %bias, %stride
  %24 = mov.i32 2
  %25 = lshl %23, %24
  %26 = mul %signed, %stride
  %28 = lshl %26, %24
  %29 = add.rr %25, %28
  %30 = mov.address-index %29
  %value = lda.i32.index %view, %30
  return %value
}

