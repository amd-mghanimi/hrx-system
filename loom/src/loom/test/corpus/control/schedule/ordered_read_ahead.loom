kernel.def @ordered_rows_0_depth_2() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %end = index.constant 0 : index
  %depth = index.constant 2 : index
  %factor = index.constant 1 : index
  template.apply<@ordered_read_ahead_rows>(%input, %output, %end, %depth, %factor) : (buffer, buffer, index, index, index)
  kernel.return
}

check.scenario @ordered_rows_0_depth_2_values {
  check.trial[4](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %input = check.generate.random.uniform seed(%seed) range(-2147483648 to 2147483647) : tensor<1024xi32>
    %output_storage = check.generate.fill value(-123) : tensor<136xi32>
    %output = check.tensor.view %output_storage offset(16) : tensor<136xi32> -> tensor<128xi32>
    check.compare<@ordered_rows_0_depth_2, @ordered_rows_0_oracle>(%input, %output) : (tensor<1024xi32>, tensor<128xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1024xi32>
      check.expect.bitwise actual(%output_storage) expected(%output_storage) : tensor<136xi32>
    }
  }
  check.return
}

// Each runtime mask selects whole rows uniformly for all workitems. Both the
// scalar recurrence and the convergent reduction consume workgroup storage
// inside the guard, between publication and reuse barriers. Sixteen-lane
// clusters have the same reference on wave32 and wave64 targets.
template.decl @ordered_guarded_then_rows(%mask: index, %input: buffer, %output: buffer, %depth: index)

template.def<@ordered_guarded_then_rows> @ordered_guarded_then_rows_impl(%mask: index, %input: buffer, %output: buffer, %depth: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %stripes = index.constant 2 : index
  %width = index.constant 128 : index
  %tile = index.constant 256 : index
  %last = index.constant 127 : index
  %base = index.constant 0 : offset
  %stage_bytes = index.constant 1024 : offset
  %lane = kernel.workitem.id<x> : index
  %peer = index.sub %last, %lane : index
  %second_peer = index.add %peer, %width : index
  %source = buffer.view %input[%base] : buffer -> view<1024xi32>
  %destination = buffer.view %output[%base] : buffer -> view<2x128xi32>
  %scratch = buffer.alloca<workgroup> align(4) %stage_bytes : buffer
  %published = buffer.view %scratch[%base] : buffer -> view<256xi32>
  %consumed = buffer.view %scratch[%base] : buffer -> view<256xi32>
  %identity = scalar.constant 0 : i32
  %multiplier = scalar.constant 3 : i32
  %scalar_result, %reduced_result = scf.for %row = [%begin to %end step %step](%sum = %identity : i32, %reduced_sum = %identity : i32) -> (i32, i32) pipeline(%depth) {
    scf.for %stripe = [%begin to %stripes step %step] unroll {
      %slot = index.madd %stripe, %width, %lane : index
      %address = index.madd %row, %tile, %slot : index
      %value = view.load %source[%address] : view<1024xi32> -> i32
      view.store %value, %published[%slot] : i32, view<256xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %row_bits = index.shrui %mask, %row : index
    %selected_bit = index.andi %row_bits, %step : index
    %active = index.cmp ne, %selected_bit, %begin : index
    %next, %next_reduced = scf.if %active -> (i32, i32) {
      %first = view.load %consumed[%peer] : view<256xi32> -> i32
      %second = view.load %consumed[%second_peer] : view<256xi32> -> i32
      %pair = scalar.addi %first, %second : i32
      %cluster = kernel.subgroup.reduce<addi> %pair {cluster_size = 16} : i32
      %scaled = scalar.muli %sum, %multiplier : i32
      %scaled_reduced = scalar.muli %reduced_sum, %multiplier : i32
      %updated = scalar.addi %scaled, %pair : i32
      %updated_reduced = scalar.addi %scaled_reduced, %cluster : i32
      scf.yield %updated, %updated_reduced : i32, i32
    } else {
      scf.yield %sum, %reduced_sum : i32, i32
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next, %next_reduced : i32, i32
  }
  view.store %scalar_result, %destination[0, %lane] : i32, view<2x128xi32>
  view.store %reduced_result, %destination[1, %lane] : i32, view<2x128xi32>
  template.return
}

template.decl @ordered_guarded_else_rows(%mask: index, %input: buffer, %output: buffer, %depth: index)

template.def<@ordered_guarded_else_rows> @ordered_guarded_else_rows_impl(%mask: index, %input: buffer, %output: buffer, %depth: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %end = index.constant 4 : index
  %stripes = index.constant 2 : index
  %width = index.constant 128 : index
  %tile = index.constant 256 : index
  %last = index.constant 127 : index
  %base = index.constant 0 : offset
  %stage_bytes = index.constant 1024 : offset
  %lane = kernel.workitem.id<x> : index
  %peer = index.sub %last, %lane : index
  %second_peer = index.add %peer, %width : index
  %source = buffer.view %input[%base] : buffer -> view<1024xi32>
  %destination = buffer.view %output[%base] : buffer -> view<2x128xi32>
  %scratch = buffer.alloca<workgroup> align(4) %stage_bytes : buffer
  %published = buffer.view %scratch[%base] : buffer -> view<256xi32>
  %consumed = buffer.view %scratch[%base] : buffer -> view<256xi32>
  %identity = scalar.constant 0 : i32
  %multiplier = scalar.constant 3 : i32
  %scalar_result, %reduced_result = scf.for %row = [%begin to %end step %step](%sum = %identity : i32, %reduced_sum = %identity : i32) -> (i32, i32) pipeline(%depth) {
    scf.for %stripe = [%begin to %stripes step %step] unroll {
      %slot = index.madd %stripe, %width, %lane : index
      %address = index.madd %row, %tile, %slot : index
      %value = view.load %source[%address] : view<1024xi32> -> i32
      view.store %value, %published[%slot] : i32, view<256xi32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %row_bits = index.shrui %mask, %row : index
    %selected_bit = index.andi %row_bits, %step : index
    %inactive = index.cmp eq, %selected_bit, %begin : index
    %next, %next_reduced = scf.if %inactive -> (i32, i32) {
      scf.yield %sum, %reduced_sum : i32, i32
    } else {
      %first = view.load %consumed[%peer] : view<256xi32> -> i32
      %second = view.load %consumed[%second_peer] : view<256xi32> -> i32
      %pair = scalar.addi %first, %second : i32
      %cluster = kernel.subgroup.reduce<addi> %pair {cluster_size = 16} : i32
      %scaled = scalar.muli %sum, %multiplier : i32
      %scaled_reduced = scalar.muli %reduced_sum, %multiplier : i32
      %updated = scalar.addi %scaled, %pair : i32
      %updated_reduced = scalar.addi %scaled_reduced, %cluster : i32
      scf.yield %updated, %updated_reduced : i32, i32
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next, %next_reduced : i32, i32
  }
  view.store %scalar_result, %destination[0, %lane] : i32, view<2x128xi32>
  view.store %reduced_result, %destination[1, %lane] : i32, view<2x128xi32>
  template.return
}

kernel.def @ordered_guarded_then_depth_2() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%mask: index, %input: buffer, %output: buffer) {
  %depth = index.constant 2 : index
  template.apply<@ordered_guarded_then_rows>(%mask, %input, %output, %depth) : (index, buffer, buffer, index)
  kernel.return
}

