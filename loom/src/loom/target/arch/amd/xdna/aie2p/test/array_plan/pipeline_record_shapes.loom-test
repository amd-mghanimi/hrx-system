aie2p.target<array> @array_target

aie2p.target<core> @core_target

low.func.def public retain target<amd.xdna.aie2p.array>(@array_target) abi(array_program) abi_layout({binding_count = 2}) @copy_1_workers_1_records() asm {
  %worker_count = constant.u32 1 : reg<aie2p.array.scalar : index>
  %workers = group %worker_count
  %worker_lane = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker = worker %workers, %worker_lane, @copy
  %input = binding 0, "read"
  %output = binding 1, "write"
  %input_sender = sender %input, 0 : reg<aie2p.array.sender : tile<1x1x4xi32, #encoding.layout.strided<strides=[12, 8, 1]>>>
  %input_offset = constant.u64 16 : reg<aie2p.array.offset : offset>
  %input_partition = constant.u32 0 : reg<aie2p.array.scalar : index>
  %input_partitions = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_partition_sender = partition.sender %input_sender, %input_offset, %input_partition, %input_partitions : reg<aie2p.array.sender : tile<4xi32>>
  %worker_receiver = receiver %worker, 0 : reg<aie2p.array.receiver : tile<4xi32>>
  %input_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %input_records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %input_channel = channel %input_partition_sender, %worker_receiver, %input_capacity, %input_records : reg<aie2p.array.channel : tile<4xi32>>
  %worker_sender = sender %worker, 1 : reg<aie2p.array.sender : tile<4xi32>>
  %output_receiver = receiver %output, 0 : reg<aie2p.array.receiver : tile<1x1x4xi32, #encoding.layout.strided<strides=[16, 12, 1]>>>
  %output_offset = constant.u64 32 : reg<aie2p.array.offset : offset>
  %output_partition = constant.u32 0 : reg<aie2p.array.scalar : index>
  %output_partitions = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_partition_receiver = partition.receiver %output_receiver, %output_offset, %output_partition, %output_partitions : reg<aie2p.array.receiver : tile<4xi32>>
  %output_capacity = constant.u32 2 : reg<aie2p.array.scalar : index>
  %output_records = constant.u32 1 : reg<aie2p.array.scalar : index>
  %output_channel = channel %worker_sender, %output_partition_receiver, %output_capacity, %output_records : reg<aie2p.array.channel : tile<4xi32>>
  %worker_column = constant.u32 0 : reg<aie2p.array.scalar : index>
  %worker_row = constant.u32 2 : reg<aie2p.array.scalar : index>
  constrain.location %worker, %worker_column, %worker_row
  return
}

func.def target(@core_target) @copy(%input: buffer, %output: buffer) {
  %input_aligned, %output_aligned = buffer.assume.alignment %input, %output {minimum_alignment = 4} : buffer, buffer
  %base = index.constant 0 : offset
  %input_view = buffer.view %input_aligned[%base] : buffer -> view<4xi32>
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<4xi32>
  %word0 = view.load %input_view[0] : view<4xi32> -> i32
  view.store %word0, %output_view[0] : i32, view<4xi32>
  %word1 = view.load %input_view[1] : view<4xi32> -> i32
  view.store %word1, %output_view[1] : i32, view<4xi32>
  %word2 = view.load %input_view[2] : view<4xi32> -> i32
  view.store %word2, %output_view[2] : i32, view<4xi32>
  %word3 = view.load %input_view[3] : view<4xi32> -> i32
  view.store %word3, %output_view[3] : i32, view<4xi32>
  func.return
}

