func.def @dynamic_stride_static_bias(%table: buffer, %position0: index, %stride0: index) -> (i8) {
  %position = index.assume %position0 [range(%position0, 0, 31)] : index
  %stride = index.assume %stride0 [range(%stride0, 1, 16)] : index
  %base = index.constant 128 : offset
  %layout = encoding.layout.strided [%stride] : encoding<layout>
  %view = buffer.view %table[%base] : buffer -> view<32xi8, %layout>
  %value = view.load %view[%position] : view<32xi8, %layout> -> i8
