// Exchange and compare-exchange preserve payload bits across global, generic,
// workgroup, and vector atomic paths. The vector exchange selects its first
// mask lane from the trial flag while its second lane observes passthrough.
kernel.def @atomic_bitwise_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial_bits_wide: i64, %replacement_bits_wide: i64, %flag: index, %global_storage: buffer, %generic_storage: buffer, %vector_storage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %initial_bits = scalar.trunci %initial_bits_wide : i64 to i32
  %replacement_bits = scalar.trunci %replacement_bits_wide : i64 to i32
  %initial = scalar.bitcast %initial_bits : i32 to f32
  %replacement = scalar.bitcast %replacement_bits : i32 to f32
  %results = buffer.view %output[%base] : buffer -> view<18xi32>

  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %global_cell = buffer.view %global[%base] : buffer -> view<1xf32>
  view.store %initial, %global_cell[0] : f32, view<1xf32>
  %global_exchanged = view.atomic.rmw<xchgf> %replacement, %global_cell[0] {ordering = acq_rel, scope = system} : f32, view<1xf32> -> f32
  %global_succeeded = view.atomic.cmpxchg %replacement, %initial, %global_cell[0] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : f32, view<1xf32> -> f32
  %global_failed = view.atomic.cmpxchg %replacement, %replacement, %global_cell[0] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : f32, view<1xf32> -> f32
  %global_final = view.load %global_cell[0] : view<1xf32> -> f32
  %global_exchanged_bits = scalar.bitcast %global_exchanged : f32 to i32
  %global_succeeded_bits = scalar.bitcast %global_succeeded : f32 to i32
  %global_failed_bits = scalar.bitcast %global_failed : f32 to i32
  %global_final_bits = scalar.bitcast %global_final : f32 to i32
  view.store %global_exchanged_bits, %results[0] : i32, view<18xi32>
  view.store %global_succeeded_bits, %results[1] : i32, view<18xi32>
  view.store %global_failed_bits, %results[2] : i32, view<18xi32>
  view.store %global_final_bits, %results[3] : i32, view<18xi32>

  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  %generic_cell = buffer.view %generic[%base] : buffer -> view<1xf32>
  view.store %initial, %generic_cell[0] : f32, view<1xf32>
  %generic_exchanged = view.atomic.rmw<xchgf> %replacement, %generic_cell[0] {ordering = acq_rel, scope = device} : f32, view<1xf32> -> f32
  %generic_succeeded = view.atomic.cmpxchg %replacement, %initial, %generic_cell[0] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : f32, view<1xf32> -> f32
  %generic_failed = view.atomic.cmpxchg %replacement, %replacement, %generic_cell[0] {failure_ordering = seq_cst, scope = device, success_ordering = seq_cst} : f32, view<1xf32> -> f32
  %generic_final = view.load %generic_cell[0] : view<1xf32> -> f32
  %generic_exchanged_bits = scalar.bitcast %generic_exchanged : f32 to i32
  %generic_succeeded_bits = scalar.bitcast %generic_succeeded : f32 to i32
  %generic_failed_bits = scalar.bitcast %generic_failed : f32 to i32
  %generic_final_bits = scalar.bitcast %generic_final : f32 to i32
  view.store %generic_exchanged_bits, %results[4] : i32, view<18xi32>
  view.store %generic_succeeded_bits, %results[5] : i32, view<18xi32>
  view.store %generic_failed_bits, %results[6] : i32, view<18xi32>
  view.store %generic_final_bits, %results[7] : i32, view<18xi32>

  %workgroup_bytes = index.constant 4 : offset
  %workgroup = buffer.alloca<workgroup> align(4) %workgroup_bytes : buffer
  %workgroup_cell = buffer.view %workgroup[%base] : buffer -> view<1xf32>
  view.store %initial, %workgroup_cell[0] : f32, view<1xf32>
  %workgroup_exchanged = view.atomic.rmw<xchgf> %replacement, %workgroup_cell[0] {ordering = acq_rel, scope = workgroup} : f32, view<1xf32> -> f32
  %workgroup_succeeded = view.atomic.cmpxchg %replacement, %initial, %workgroup_cell[0] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : f32, view<1xf32> -> f32
  %workgroup_failed = view.atomic.cmpxchg %replacement, %replacement, %workgroup_cell[0] {failure_ordering = seq_cst, scope = workgroup, success_ordering = seq_cst} : f32, view<1xf32> -> f32
  %workgroup_final = view.load %workgroup_cell[0] : view<1xf32> -> f32
  %workgroup_exchanged_bits = scalar.bitcast %workgroup_exchanged : f32 to i32
  %workgroup_succeeded_bits = scalar.bitcast %workgroup_succeeded : f32 to i32
  %workgroup_failed_bits = scalar.bitcast %workgroup_failed : f32 to i32
  %workgroup_final_bits = scalar.bitcast %workgroup_final : f32 to i32
  view.store %workgroup_exchanged_bits, %results[8] : i32, view<18xi32>
  view.store %workgroup_succeeded_bits, %results[9] : i32, view<18xi32>
  view.store %workgroup_failed_bits, %results[10] : i32, view<18xi32>
  view.store %workgroup_final_bits, %results[11] : i32, view<18xi32>

  %vector_global = buffer.assume.memory_space<global> %vector_storage : buffer
  %vector_cells = buffer.view %vector_global[%base] : buffer -> view<2xf32>
  %initial_vector = vector.from_elements %initial, %initial : vector<2xf32>
  %replacement_vector = vector.from_elements %replacement, %replacement : vector<2xf32>
  vector.store %initial_vector, %vector_cells[0] : vector<2xf32>, view<2xf32>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %enabled = index.cmp ne, %flag, %c0 : index
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  %vector_exchanged = vector.atomic.rmw.mask<xchgf> %replacement_vector, %vector_cells[0][%offsets], %mask, %replacement_vector {ordering = acq_rel, scope = device} : vector<2xf32>, view<2xf32>, vector<2xindex>, vector<2xi1>, vector<2xf32>
  %vector_observed = vector.atomic.cmpxchg %replacement_vector, %initial_vector, %vector_cells[0][%offsets] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : vector<2xf32>, view<2xf32>, vector<2xindex> -> vector<2xf32>
  %vector_final = vector.load %vector_cells[0] : view<2xf32> -> vector<2xf32>
  %vector_exchanged_bits = vector.bitcast %vector_exchanged : vector<2xf32> to vector<2xi32>
  %vector_observed_bits = vector.bitcast %vector_observed : vector<2xf32> to vector<2xi32>
  %vector_final_bits = vector.bitcast %vector_final : vector<2xf32> to vector<2xi32>
  vector.store %vector_exchanged_bits, %results[12] : vector<2xi32>, view<18xi32>
  vector.store %vector_observed_bits, %results[14] : vector<2xi32>, view<18xi32>
  vector.store %vector_final_bits, %results[16] : vector<2xi32>, view<18xi32>
  kernel.return
}

// The oracle models raw atomic state transitions with integer values. It
// executes neither floating-point operations nor atomic instructions.
func.def @atomic_bitwise_f32_oracle(%initial_bits_wide: i64, %replacement_bits_wide: i64, %flag: index, %global_storage: buffer, %generic_storage: buffer, %vector_storage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %initial = scalar.trunci %initial_bits_wide : i64 to i32
  %replacement = scalar.trunci %replacement_bits_wide : i64 to i32
  %global = buffer.view %global_storage[%base] : buffer -> view<1xi32>
  %generic = buffer.view %generic_storage[%base] : buffer -> view<1xi32>
  %vector_cells = buffer.view %vector_storage[%base] : buffer -> view<2xi32>
  %results = buffer.view %output[%base] : buffer -> view<18xi32>
  view.store %initial, %global[0] : i32, view<1xi32>
  view.store %initial, %generic[0] : i32, view<1xi32>
  view.store %initial, %vector_cells[0] : i32, view<2xi32>
  view.store %initial, %vector_cells[1] : i32, view<2xi32>
  view.store %initial, %results[0] : i32, view<18xi32>
  view.store %replacement, %results[1] : i32, view<18xi32>
  view.store %initial, %results[2] : i32, view<18xi32>
  view.store %initial, %results[3] : i32, view<18xi32>
  view.store %initial, %results[4] : i32, view<18xi32>
  view.store %replacement, %results[5] : i32, view<18xi32>
  view.store %initial, %results[6] : i32, view<18xi32>
  view.store %initial, %results[7] : i32, view<18xi32>
  view.store %initial, %results[8] : i32, view<18xi32>
  view.store %replacement, %results[9] : i32, view<18xi32>
  view.store %initial, %results[10] : i32, view<18xi32>
  view.store %initial, %results[11] : i32, view<18xi32>
  %enabled = index.cmp ne, %flag, %c0 : index
  %first_exchanged = scf.select %enabled, %initial, %replacement : i32
  %first_observed = scf.select %enabled, %replacement, %initial : i32
  view.store %first_exchanged, %results[12] : i32, view<18xi32>
  view.store %replacement, %results[13] : i32, view<18xi32>
  view.store %first_observed, %results[14] : i32, view<18xi32>
  view.store %initial, %results[15] : i32, view<18xi32>
  view.store %initial, %results[16] : i32, view<18xi32>
  view.store %initial, %results[17] : i32, view<18xi32>
  func.return
}

// Exchange and compare-exchange preserve payload bits across global, generic,
// workgroup, and vector atomic paths. The vector exchange selects its first
// mask lane from the trial flag while its second lane observes passthrough.
kernel.def @atomic_bitwise_f64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%initial_bits: i64, %replacement_bits: i64, %flag: index, %global_storage: buffer, %generic_storage: buffer, %vector_storage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %initial = scalar.bitcast %initial_bits : i64 to f64
  %replacement = scalar.bitcast %replacement_bits : i64 to f64
  %results = buffer.view %output[%base] : buffer -> view<18xi64>

  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %global_cell = buffer.view %global[%base] : buffer -> view<1xf64>
  view.store %initial, %global_cell[0] : f64, view<1xf64>
  %global_exchanged = view.atomic.rmw<xchgf> %replacement, %global_cell[0] {ordering = acq_rel, scope = system} : f64, view<1xf64> -> f64
  %global_succeeded = view.atomic.cmpxchg %replacement, %initial, %global_cell[0] {failure_ordering = acquire, scope = system, success_ordering = acq_rel} : f64, view<1xf64> -> f64
  %global_failed = view.atomic.cmpxchg %replacement, %replacement, %global_cell[0] {failure_ordering = seq_cst, scope = system, success_ordering = seq_cst} : f64, view<1xf64> -> f64
  %global_final = view.load %global_cell[0] : view<1xf64> -> f64
  %global_exchanged_bits = scalar.bitcast %global_exchanged : f64 to i64
  %global_succeeded_bits = scalar.bitcast %global_succeeded : f64 to i64
  %global_failed_bits = scalar.bitcast %global_failed : f64 to i64
  %global_final_bits = scalar.bitcast %global_final : f64 to i64
  view.store %global_exchanged_bits, %results[0] : i64, view<18xi64>
  view.store %global_succeeded_bits, %results[1] : i64, view<18xi64>
  view.store %global_failed_bits, %results[2] : i64, view<18xi64>
  view.store %global_final_bits, %results[3] : i64, view<18xi64>

  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  %generic_cell = buffer.view %generic[%base] : buffer -> view<1xf64>
  view.store %initial, %generic_cell[0] : f64, view<1xf64>
  %generic_exchanged = view.atomic.rmw<xchgf> %replacement, %generic_cell[0] {ordering = acq_rel, scope = device} : f64, view<1xf64> -> f64
  %generic_succeeded = view.atomic.cmpxchg %replacement, %initial, %generic_cell[0] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : f64, view<1xf64> -> f64
  %generic_failed = view.atomic.cmpxchg %replacement, %replacement, %generic_cell[0] {failure_ordering = seq_cst, scope = device, success_ordering = seq_cst} : f64, view<1xf64> -> f64
  %generic_final = view.load %generic_cell[0] : view<1xf64> -> f64
  %generic_exchanged_bits = scalar.bitcast %generic_exchanged : f64 to i64
  %generic_succeeded_bits = scalar.bitcast %generic_succeeded : f64 to i64
  %generic_failed_bits = scalar.bitcast %generic_failed : f64 to i64
  %generic_final_bits = scalar.bitcast %generic_final : f64 to i64
  view.store %generic_exchanged_bits, %results[4] : i64, view<18xi64>
  view.store %generic_succeeded_bits, %results[5] : i64, view<18xi64>
  view.store %generic_failed_bits, %results[6] : i64, view<18xi64>
  view.store %generic_final_bits, %results[7] : i64, view<18xi64>

  %workgroup_bytes = index.constant 8 : offset
  %workgroup = buffer.alloca<workgroup> align(8) %workgroup_bytes : buffer
  %workgroup_cell = buffer.view %workgroup[%base] : buffer -> view<1xf64>
  view.store %initial, %workgroup_cell[0] : f64, view<1xf64>
  %workgroup_exchanged = view.atomic.rmw<xchgf> %replacement, %workgroup_cell[0] {ordering = acq_rel, scope = workgroup} : f64, view<1xf64> -> f64
  %workgroup_succeeded = view.atomic.cmpxchg %replacement, %initial, %workgroup_cell[0] {failure_ordering = acquire, scope = workgroup, success_ordering = acq_rel} : f64, view<1xf64> -> f64
  %workgroup_failed = view.atomic.cmpxchg %replacement, %replacement, %workgroup_cell[0] {failure_ordering = seq_cst, scope = workgroup, success_ordering = seq_cst} : f64, view<1xf64> -> f64
  %workgroup_final = view.load %workgroup_cell[0] : view<1xf64> -> f64
  %workgroup_exchanged_bits = scalar.bitcast %workgroup_exchanged : f64 to i64
  %workgroup_succeeded_bits = scalar.bitcast %workgroup_succeeded : f64 to i64
  %workgroup_failed_bits = scalar.bitcast %workgroup_failed : f64 to i64
  %workgroup_final_bits = scalar.bitcast %workgroup_final : f64 to i64
  view.store %workgroup_exchanged_bits, %results[8] : i64, view<18xi64>
  view.store %workgroup_succeeded_bits, %results[9] : i64, view<18xi64>
  view.store %workgroup_failed_bits, %results[10] : i64, view<18xi64>
  view.store %workgroup_final_bits, %results[11] : i64, view<18xi64>

  %vector_global = buffer.assume.memory_space<global> %vector_storage : buffer
  %vector_cells = buffer.view %vector_global[%base] : buffer -> view<2xf64>
  %initial_vector = vector.from_elements %initial, %initial : vector<2xf64>
  %replacement_vector = vector.from_elements %replacement, %replacement : vector<2xf64>
  vector.store %initial_vector, %vector_cells[0] : vector<2xf64>, view<2xf64>
  %origin = index.constant 0 : index
  %stride = index.constant 1 : index
  %offsets = vector.iota %origin step %stride : vector<2xindex>
  %enabled = index.cmp ne, %flag, %c0 : index
  %disabled = scalar.constant false : i1
  %mask = vector.from_elements %enabled, %disabled : vector<2xi1>
  %vector_exchanged = vector.atomic.rmw.mask<xchgf> %replacement_vector, %vector_cells[0][%offsets], %mask, %replacement_vector {ordering = acq_rel, scope = device} : vector<2xf64>, view<2xf64>, vector<2xindex>, vector<2xi1>, vector<2xf64>
  %vector_observed = vector.atomic.cmpxchg %replacement_vector, %initial_vector, %vector_cells[0][%offsets] {failure_ordering = acquire, scope = device, success_ordering = acq_rel} : vector<2xf64>, view<2xf64>, vector<2xindex> -> vector<2xf64>
  %vector_final = vector.load %vector_cells[0] : view<2xf64> -> vector<2xf64>
  %vector_exchanged_bits = vector.bitcast %vector_exchanged : vector<2xf64> to vector<2xi64>
  %vector_observed_bits = vector.bitcast %vector_observed : vector<2xf64> to vector<2xi64>
  %vector_final_bits = vector.bitcast %vector_final : vector<2xf64> to vector<2xi64>
  vector.store %vector_exchanged_bits, %results[12] : vector<2xi64>, view<18xi64>
  vector.store %vector_observed_bits, %results[14] : vector<2xi64>, view<18xi64>
  vector.store %vector_final_bits, %results[16] : vector<2xi64>, view<18xi64>
  kernel.return
}

// The oracle models raw atomic state transitions with integer values. It
// executes neither floating-point operations nor atomic instructions.
func.def @atomic_bitwise_f64_oracle(%initial: i64, %replacement: i64, %flag: index, %global_storage: buffer, %generic_storage: buffer, %vector_storage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %global = buffer.view %global_storage[%base] : buffer -> view<1xi64>
  %generic = buffer.view %generic_storage[%base] : buffer -> view<1xi64>
  %vector_cells = buffer.view %vector_storage[%base] : buffer -> view<2xi64>
  %results = buffer.view %output[%base] : buffer -> view<18xi64>
  view.store %initial, %global[0] : i64, view<1xi64>
  view.store %initial, %generic[0] : i64, view<1xi64>
  view.store %initial, %vector_cells[0] : i64, view<2xi64>
  view.store %initial, %vector_cells[1] : i64, view<2xi64>
  view.store %initial, %results[0] : i64, view<18xi64>
  view.store %replacement, %results[1] : i64, view<18xi64>
  view.store %initial, %results[2] : i64, view<18xi64>
  view.store %initial, %results[3] : i64, view<18xi64>
  view.store %initial, %results[4] : i64, view<18xi64>
  view.store %replacement, %results[5] : i64, view<18xi64>
  view.store %initial, %results[6] : i64, view<18xi64>
  view.store %initial, %results[7] : i64, view<18xi64>
  view.store %initial, %results[8] : i64, view<18xi64>
  view.store %replacement, %results[9] : i64, view<18xi64>
  view.store %initial, %results[10] : i64, view<18xi64>
  view.store %initial, %results[11] : i64, view<18xi64>
  %enabled = index.cmp ne, %flag, %c0 : index
  %first_exchanged = scf.select %enabled, %initial, %replacement : i64
  %first_observed = scf.select %enabled, %replacement, %initial : i64
  view.store %first_exchanged, %results[12] : i64, view<18xi64>
  view.store %replacement, %results[13] : i64, view<18xi64>
  view.store %first_observed, %results[14] : i64, view<18xi64>
  view.store %initial, %results[15] : i64, view<18xi64>
  view.store %initial, %results[16] : i64, view<18xi64>
  view.store %initial, %results[17] : i64, view<18xi64>
  func.return
}

check.scenario @atomic_bitwise_f32_values {
  check.trial[64](%trial: index, %entropy: check.entropy) {
    %initial = check.entropy.read %entropy[0] : check.entropy -> i64
    %replacement = check.entropy.read %entropy[1] : check.entropy -> i64
    %global = check.generate.fill value(77) : tensor<1xi32>
    %generic = check.generate.fill value(77) : tensor<1xi32>
    %vector_cells = check.generate.fill value(77) : tensor<2xi32>
    %output = check.generate.fill value(-1) : tensor<18xi32>
    check.compare<@atomic_bitwise_f32, @atomic_bitwise_f32_oracle>(%initial, %replacement, %trial, %global, %generic, %vector_cells, %output) : (i64, i64, index, tensor<1xi32>, tensor<1xi32>, tensor<2xi32>, tensor<18xi32>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<1xi32>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<1xi32>
      check.expect.bitwise actual(%vector_cells) expected(%vector_cells) : tensor<2xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<18xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(2139169605) : i64
    %replacement = check.literal value(2143634209) : i64
    %flag = check.literal value(0) : index
    %global = check.generate.fill value(77) : tensor<1xi32>
    %generic = check.generate.fill value(77) : tensor<1xi32>
    %vector_cells = check.generate.fill value(77) : tensor<2xi32>
    %output = check.generate.fill value(-1) : tensor<18xi32>
    check.compare<@atomic_bitwise_f32, @atomic_bitwise_f32_oracle>(%initial, %replacement, %flag, %global, %generic, %vector_cells, %output) : (i64, i64, index, tensor<1xi32>, tensor<1xi32>, tensor<2xi32>, tensor<18xi32>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<1xi32>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<1xi32>
      check.expect.bitwise actual(%vector_cells) expected(%vector_cells) : tensor<2xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<18xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(0) : i64
    %replacement = check.literal value(-2147483648) : i64
    %flag = check.literal value(1) : index
    %global = check.generate.fill value(77) : tensor<1xi32>
    %generic = check.generate.fill value(77) : tensor<1xi32>
    %vector_cells = check.generate.fill value(77) : tensor<2xi32>
    %output = check.generate.fill value(-1) : tensor<18xi32>
    check.compare<@atomic_bitwise_f32, @atomic_bitwise_f32_oracle>(%initial, %replacement, %flag, %global, %generic, %vector_cells, %output) : (i64, i64, index, tensor<1xi32>, tensor<1xi32>, tensor<2xi32>, tensor<18xi32>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<1xi32>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<1xi32>
      check.expect.bitwise actual(%vector_cells) expected(%vector_cells) : tensor<2xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<18xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %initial = check.literal value(1) : i64
    %replacement = check.literal value(1193046) : i64
    %flag = check.literal value(0) : index
    %global = check.generate.fill value(77) : tensor<1xi32>
    %generic = check.generate.fill value(77) : tensor<1xi32>
    %vector_cells = check.generate.fill value(77) : tensor<2xi32>
    %output = check.generate.fill value(-1) : tensor<18xi32>
    check.compare<@atomic_bitwise_f32, @atomic_bitwise_f32_oracle>(%initial, %replacement, %flag, %global, %generic, %vector_cells, %output) : (i64, i64, index, tensor<1xi32>, tensor<1xi32>, tensor<2xi32>, tensor<18xi32>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<1xi32>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<1xi32>
      check.expect.bitwise actual(%vector_cells) expected(%vector_cells) : tensor<2xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<18xi32>
    }
  }
  check.return
}

