  %origin = index.constant 0 : offset
  %branches, %for_step, %while, %do, %nested, %all, %scopes, %byte = func.call @continue_reference(%count, %choose) : (i32, i32) -> (i32, i32, i32, i32, i32, i32, i32, i32)
