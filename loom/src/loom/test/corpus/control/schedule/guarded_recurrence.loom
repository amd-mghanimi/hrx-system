// Serial, pipelined, and pipelined-unrolled schedules evaluate each guarded
// recurrence in one checked program. Each iteration queues its predicate with
// its guarded payload; a separate guarded recurrence consumes both later. The
// odd row stride alternates the two lanes' predicates.
template.decl @test.guarded_sum(%count: index, %lane: index, %flags: view<16x17xi32>, %values: view<16x17xf32>, %depth: index, %factor: index) -> (f32)

template.decl @test.guarded_state(%count: index, %flags: view<16xi32>, %values: view<16xf32>, %initial: f32, %depth: index, %factor: index) -> (f32, f32)

template.decl @test.segmented_guarded_sum(%flags: view<32768xi32>, %values: view<32768xf32>, %length: index, %segment_count: index, %depth: index) -> (f32)

template.def<@test.guarded_sum> @guarded_sum_impl(%count: index, %lane: index, %flags: view<16x17xi32>, %values: view<16x17xf32>, %depth: index, %factor: index) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %threshold = scalar.constant 0 : i32
  %initial = scalar.constant 0.0 : f32
  %total = scf.for %row = [%begin to %count step %step](%sum = %initial : f32) -> (f32) pipeline(%depth) unroll(%factor) {
    %flag = view.load %flags[%row, %lane] : view<16x17xi32> -> i32
    %valid = scalar.cmpi sgt, %flag, %threshold : i32
    %payload = scf.if %valid -> (f32) {
      %loaded = view.load %values[%row, %lane] : view<16x17xf32> -> f32
      scf.yield %loaded : f32
    } else {
      scf.yield %initial : f32
    }
    %next = scf.if %valid -> (f32) {
      %updated = scalar.addf %sum, %payload : f32
      scf.yield %updated : f32
    } else {
      scf.yield %sum : f32
    }
    scf.yield %next : f32
  }
  template.return %total : f32
}

template.def<@test.guarded_state> @guarded_state_impl(%count: index, %flags: view<16xi32>, %values: view<16xf32>, %initial: f32, %depth: index, %factor: index) -> (f32, f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %threshold = scalar.constant 0 : i32
  %total, %last = scf.for %row = [%begin to %count step %step](%sum = %initial : f32, %selected = %initial : f32) -> (f32, f32) pipeline(%depth) unroll(%factor) {
    %flag = view.load %flags[%row] : view<16xi32> -> i32
    %valid = scalar.cmpi sgt, %flag, %threshold : i32
    %payload = scf.if %valid -> (f32) {
      %loaded = view.load %values[%row] : view<16xf32> -> f32
      scf.yield %loaded : f32
    } else {
      scf.yield %initial : f32
    }
    %next_sum, %next_selected = scf.if %valid -> (f32, f32) {
      %updated = scalar.addf %sum, %payload : f32
      scf.yield %updated, %payload : f32, f32
    } else {
      scf.yield %sum, %selected : f32, f32
    }
    scf.yield %next_sum, %next_selected : f32, f32
  }
  template.return %total, %last : f32, f32
}

template.def<@test.segmented_guarded_sum> @segmented_guarded_sum_impl(%flags: view<32768xi32>, %values: view<32768xf32>, %length: index, %segment_count: index, %depth: index) -> (f32) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %segment_length = index.constant 64 : index
  %end = index.assume %length [range(%length, 0, 64)] : index
  %threshold = scalar.constant 0 : i32
  %initial = scalar.constant 0.0 : f32
  %result = scf.for %segment = [%begin to %segment_count step %step](%accumulator = %initial : f32) -> (f32) unroll {
    %base = index.mul %segment, %segment_length : index
    %partial = scf.for %i = [%begin to %end step %step](%sum = %accumulator : f32) -> (f32) pipeline(%depth) {
      %position = index.add %base, %i : index
      %flag = view.load %flags[%position] : view<32768xi32> -> i32
      %valid = scalar.cmpi sgt, %flag, %threshold : i32
      %value = scf.if %valid -> (f32) {
        %loaded = view.load %values[%position] : view<32768xf32> -> f32
        scf.yield %loaded : f32
      } else {
        scf.yield %initial : f32
      }
      %next = scf.if %valid -> (f32) {
        %updated = scalar.addf %sum, %value : f32
        scf.yield %updated : f32
      } else {
        scf.yield %sum : f32
      }
      scf.yield %next : f32
    }
    scf.yield %partial : f32
  }
  template.return %result : f32
}

kernel.def @guarded_uniform_variants() {
  %groups = index.constant 2 : index
  %lanes = index.constant 1 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%row_count: index, %flag_buffer: buffer, %value_buffer: buffer, %output_buffer: buffer) {
  %count = index.assume %row_count [range(%row_count, 0, 16)] : index
  %lane = kernel.workgroup.id<x> : index
  %base = index.constant 0 : offset
  %serial_depth = index.constant 1 : index
  %pipelined_depth = index.constant 3 : index
  %unrolled_depth = index.constant 4 : index
  %factor = index.constant 1 : index
  %unrolled_factor = index.constant 2 : index
  %pipelined_offset = index.constant 2 : index
  %unrolled_offset = index.constant 4 : index
  %flags_aligned = buffer.assume.alignment %flag_buffer {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %value_buffer {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output_buffer {minimum_alignment = 4} : buffer
  %flags_storage, %values_storage, %output_storage = buffer.assume.noalias %flags_aligned, %values_aligned, %output_aligned : buffer, buffer, buffer
  %flags = buffer.view %flags_storage[%base] : buffer -> view<16x17xi32>
  %values = buffer.view %values_storage[%base] : buffer -> view<16x17xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<6xf32>
  %serial = template.apply<@test.guarded_sum>(%count, %lane, %flags, %values, %serial_depth, %factor) : (index, index, view<16x17xi32>, view<16x17xf32>, index, index) -> (f32)
  %pipelined = template.apply<@test.guarded_sum>(%count, %lane, %flags, %values, %pipelined_depth, %factor) : (index, index, view<16x17xi32>, view<16x17xf32>, index, index) -> (f32)
  %unrolled = template.apply<@test.guarded_sum>(%count, %lane, %flags, %values, %unrolled_depth, %unrolled_factor) : (index, index, view<16x17xi32>, view<16x17xf32>, index, index) -> (f32)
  %pipelined_position = index.add %lane, %pipelined_offset : index
  %unrolled_position = index.add %lane, %unrolled_offset : index
  view.store %serial, %output[%lane] : f32, view<6xf32>
  view.store %pipelined, %output[%pipelined_position] : f32, view<6xf32>
  view.store %unrolled, %output[%unrolled_position] : f32, view<6xf32>
  kernel.return
}

kernel.def @guarded_varying_variants() {
  %groups = index.constant 1 : index
  %lanes = index.constant 2 : index
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%row_count: index, %flag_buffer: buffer, %value_buffer: buffer, %output_buffer: buffer) {
  %count = index.assume %row_count [range(%row_count, 0, 16)] : index
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %serial_depth = index.constant 1 : index
  %pipelined_depth = index.constant 3 : index
  %unrolled_depth = index.constant 4 : index
  %factor = index.constant 1 : index
  %unrolled_factor = index.constant 2 : index
  %pipelined_offset = index.constant 2 : index
  %unrolled_offset = index.constant 4 : index
  %flags_aligned = buffer.assume.alignment %flag_buffer {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %value_buffer {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output_buffer {minimum_alignment = 4} : buffer
  %flags_storage, %values_storage, %output_storage = buffer.assume.noalias %flags_aligned, %values_aligned, %output_aligned : buffer, buffer, buffer
  %flags = buffer.view %flags_storage[%base] : buffer -> view<16x17xi32>
  %values = buffer.view %values_storage[%base] : buffer -> view<16x17xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<6xf32>
  %serial = template.apply<@test.guarded_sum>(%count, %lane, %flags, %values, %serial_depth, %factor) : (index, index, view<16x17xi32>, view<16x17xf32>, index, index) -> (f32)
  %pipelined = template.apply<@test.guarded_sum>(%count, %lane, %flags, %values, %pipelined_depth, %factor) : (index, index, view<16x17xi32>, view<16x17xf32>, index, index) -> (f32)
  %unrolled = template.apply<@test.guarded_sum>(%count, %lane, %flags, %values, %unrolled_depth, %unrolled_factor) : (index, index, view<16x17xi32>, view<16x17xf32>, index, index) -> (f32)
  %pipelined_position = index.add %lane, %pipelined_offset : index
  %unrolled_position = index.add %lane, %unrolled_offset : index
  view.store %serial, %output[%lane] : f32, view<6xf32>
  view.store %pipelined, %output[%pipelined_position] : f32, view<6xf32>
  view.store %unrolled, %output[%unrolled_position] : f32, view<6xf32>
  kernel.return
}

// The VM oracle evaluates the same guarded reduction serially without schedule annotations.
func.def @guarded_variants_oracle(%row_count: index, %flag_buffer: buffer, %value_buffer: buffer, %output_buffer: buffer) {
  %count = index.assume %row_count [range(%row_count, 0, 16)] : index
  %begin = index.constant 0 : index
  %lane_count = index.constant 2 : index
  %step = index.constant 1 : index
  %threshold = scalar.constant 0 : i32
  %initial = scalar.constant 0.0 : f32
  %base = index.constant 0 : offset
  %pipelined_offset = index.constant 2 : index
  %unrolled_offset = index.constant 4 : index
  %flags = buffer.view %flag_buffer[%base] : buffer -> view<16x17xi32>
  %values = buffer.view %value_buffer[%base] : buffer -> view<16x17xf32>
  %output = buffer.view %output_buffer[%base] : buffer -> view<6xf32>
  scf.for %lane = [%begin to %lane_count step %step] {
    %sum = scf.for %row = [%begin to %count step %step](%accumulator = %initial : f32) -> (f32) {
      %flag = view.load %flags[%row, %lane] : view<16x17xi32> -> i32
      %valid = scalar.cmpi sgt, %flag, %threshold : i32
      %next = scf.if %valid -> (f32) {
        %value = view.load %values[%row, %lane] : view<16x17xf32> -> f32
        %updated = scalar.addf %accumulator, %value : f32
        scf.yield %updated : f32
      } else {
        scf.yield %accumulator : f32
      }
      scf.yield %next : f32
    }
    %pipelined_position = index.add %lane, %pipelined_offset : index
    %unrolled_position = index.add %lane, %unrolled_offset : index
    view.store %sum, %output[%lane] : f32, view<6xf32>
    view.store %sum, %output[%pipelined_position] : f32, view<6xf32>
    view.store %sum, %output[%unrolled_position] : f32, view<6xf32>
  }
  func.return
}

check.scenario @guarded_uniform_values {
  // Exercise every legal row count with alternating lane predicates.
  check.trial[17](%row_count: index, %entropy: check.entropy) {
    %flags = check.generate.iota offset(-1) step(2) period(2) : tensor<16x17xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<16x17xf32>
    %output = check.generate.fill value(-1.0) : tensor<6xf32>
    check.compare<@guarded_uniform_variants, @guarded_variants_oracle>(%row_count, %flags, %values, %output) : (index, tensor<16x17xi32>, tensor<16x17xf32>, tensor<6xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<6xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(16) : index
    %flags = check.generate.fill value(-1) : tensor<16x17xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<16x17xf32>
    %output = check.generate.fill value(-1.0) : tensor<6xf32>
    check.compare<@guarded_uniform_variants, @guarded_variants_oracle>(%row_count, %flags, %values, %output) : (index, tensor<16x17xi32>, tensor<16x17xf32>, tensor<6xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<6xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(16) : index
    %flags = check.generate.fill value(1) : tensor<16x17xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<16x17xf32>
    %output = check.generate.fill value(-1.0) : tensor<6xf32>
    check.compare<@guarded_uniform_variants, @guarded_variants_oracle>(%row_count, %flags, %values, %output) : (index, tensor<16x17xi32>, tensor<16x17xf32>, tensor<6xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<6xf32>
    }
  }
  check.return
}

check.scenario @guarded_varying_values {
  // Exercise every legal row count with alternating lane predicates.
  check.trial[17](%row_count: index, %entropy: check.entropy) {
    %flags = check.generate.iota offset(-1) step(2) period(2) : tensor<16x17xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<16x17xf32>
    %output = check.generate.fill value(-1.0) : tensor<6xf32>
    check.compare<@guarded_varying_variants, @guarded_variants_oracle>(%row_count, %flags, %values, %output) : (index, tensor<16x17xi32>, tensor<16x17xf32>, tensor<6xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<6xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(16) : index
    %flags = check.generate.fill value(-1) : tensor<16x17xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<16x17xf32>
    %output = check.generate.fill value(-1.0) : tensor<6xf32>
    check.compare<@guarded_varying_variants, @guarded_variants_oracle>(%row_count, %flags, %values, %output) : (index, tensor<16x17xi32>, tensor<16x17xf32>, tensor<6xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<6xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(16) : index
    %flags = check.generate.fill value(1) : tensor<16x17xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<16x17xf32>
    %output = check.generate.fill value(-1.0) : tensor<6xf32>
    check.compare<@guarded_varying_variants, @guarded_variants_oracle>(%row_count, %flags, %values, %output) : (index, tensor<16x17xi32>, tensor<16x17xf32>, tensor<6xf32>) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<6xf32>
    }
  }
  check.return
}

kernel.def @guarded_state_variants() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%row_count: index, %initial_bits: i32, %flag_buffer: buffer, %value_buffer: buffer, %sum_buffer: buffer, %last_buffer: buffer) {
  %count = index.assume %row_count [range(%row_count, 0, 16)] : index
  %base = index.constant 0 : offset
  %serial_depth = index.constant 1 : index
  %pipelined_depth = index.constant 3 : index
  %unrolled_depth = index.constant 4 : index
  %factor = index.constant 1 : index
  %unrolled_factor = index.constant 2 : index
  %initial = scalar.bitcast %initial_bits : i32 to f32
  %flags_aligned = buffer.assume.alignment %flag_buffer {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %value_buffer {minimum_alignment = 4} : buffer
  %sum_aligned = buffer.assume.alignment %sum_buffer {minimum_alignment = 4} : buffer
  %last_aligned = buffer.assume.alignment %last_buffer {minimum_alignment = 4} : buffer
  %flags_storage, %values_storage, %sum_storage, %last_storage = buffer.assume.noalias %flags_aligned, %values_aligned, %sum_aligned, %last_aligned : buffer, buffer, buffer, buffer
  %flags = buffer.view %flags_storage[%base] : buffer -> view<16xi32>
  %values = buffer.view %values_storage[%base] : buffer -> view<16xf32>
  %sum_output = buffer.view %sum_storage[%base] : buffer -> view<3xf32>
  %last_output = buffer.view %last_storage[%base] : buffer -> view<3xf32>
  %serial_sum, %serial_last = template.apply<@test.guarded_state>(%count, %flags, %values, %initial, %serial_depth, %factor) : (index, view<16xi32>, view<16xf32>, f32, index, index) -> (f32, f32)
  %pipelined_sum, %pipelined_last = template.apply<@test.guarded_state>(%count, %flags, %values, %initial, %pipelined_depth, %factor) : (index, view<16xi32>, view<16xf32>, f32, index, index) -> (f32, f32)
  %unrolled_sum, %unrolled_last = template.apply<@test.guarded_state>(%count, %flags, %values, %initial, %unrolled_depth, %unrolled_factor) : (index, view<16xi32>, view<16xf32>, f32, index, index) -> (f32, f32)
  view.store %serial_sum, %sum_output[0] : f32, view<3xf32>
  view.store %pipelined_sum, %sum_output[1] : f32, view<3xf32>
  view.store %unrolled_sum, %sum_output[2] : f32, view<3xf32>
  view.store %serial_last, %last_output[0] : f32, view<3xf32>
  view.store %pipelined_last, %last_output[1] : f32, view<3xf32>
  view.store %unrolled_last, %last_output[2] : f32, view<3xf32>
  kernel.return
}

func.def @guarded_state_oracle(%row_count: index, %initial_bits: i32, %flag_buffer: buffer, %value_buffer: buffer, %sum_buffer: buffer, %last_buffer: buffer) {
  %count = index.assume %row_count [range(%row_count, 0, 16)] : index
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %threshold = scalar.constant 0 : i32
  %initial = scalar.bitcast %initial_bits : i32 to f32
  %base = index.constant 0 : offset
  %flags = buffer.view %flag_buffer[%base] : buffer -> view<16xi32>
  %values = buffer.view %value_buffer[%base] : buffer -> view<16xf32>
  %sum_output = buffer.view %sum_buffer[%base] : buffer -> view<3xf32>
  %last_output = buffer.view %last_buffer[%base] : buffer -> view<3xf32>
  %sum, %last = scf.for %row = [%begin to %count step %step](%accumulator = %initial : f32, %selected = %initial : f32) -> (f32, f32) {
    %flag = view.load %flags[%row] : view<16xi32> -> i32
    %valid = scalar.cmpi sgt, %flag, %threshold : i32
    %next_sum, %next_last = scf.if %valid -> (f32, f32) {
      %value = view.load %values[%row] : view<16xf32> -> f32
      %updated = scalar.addf %accumulator, %value : f32
      scf.yield %updated, %value : f32, f32
    } else {
      scf.yield %accumulator, %selected : f32, f32
    }
    scf.yield %next_sum, %next_last : f32, f32
  }
  view.store %sum, %sum_output[0] : f32, view<3xf32>
  view.store %sum, %sum_output[1] : f32, view<3xf32>
  view.store %sum, %sum_output[2] : f32, view<3xf32>
  view.store %last, %last_output[0] : f32, view<3xf32>
  view.store %last, %last_output[1] : f32, view<3xf32>
  view.store %last, %last_output[2] : f32, view<3xf32>
  func.return
}

check.scenario @guarded_state_values {
  // Source order distinguishes the strict recurrence from reassociation.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(3) : index
    %initial = check.literal value(0) : i32
    %flags = check.generate.fill value(1) : tensor<16xi32>
    %values = check.generate.iota offset(16777216.0) step(-16777215.0) : tensor<16xf32>
    %sum = check.generate.fill value(nan) : tensor<3xf32>
    %last = check.generate.fill value(nan) : tensor<3xf32>
    check.compare<@guarded_state_variants, @guarded_state_oracle>(%row_count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<16xf32>, tensor<3xf32>, tensor<3xf32>) -> () {
      check.expect.bitwise actual(%sum) expected(%sum) : tensor<3xf32>
      check.expect.bitwise actual(%last) expected(%last) : tensor<3xf32>
    }
  }
  // Skipped updates must forward both carried values without loading payloads.
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(9) : index
    %initial = check.literal value(-2147483648) : i32
    %flags = check.generate.fill value(-1) : tensor<16xi32>
    %values = check.generate.fill value(nan) : tensor<1xf32>
    %sum = check.generate.fill value(1.0) : tensor<3xf32>
    %last = check.generate.fill value(1.0) : tensor<3xf32>
    check.compare<@guarded_state_variants, @guarded_state_oracle>(%row_count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<1xf32>, tensor<3xf32>, tensor<3xf32>) -> () {
      check.expect.bitwise actual(%sum) expected(%sum) : tensor<3xf32>
      check.expect.bitwise actual(%last) expected(%last) : tensor<3xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(7) : index
    %initial = check.literal value(2143289344) : i32
    %flags = check.generate.fill value(-1) : tensor<16xi32>
    %values = check.generate.fill value(1.0) : tensor<1xf32>
    %sum = check.generate.fill value(0.0) : tensor<3xf32>
    %last = check.generate.fill value(0.0) : tensor<3xf32>
    check.compare<@guarded_state_variants, @guarded_state_oracle>(%row_count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<1xf32>, tensor<3xf32>, tensor<3xf32>) -> () {
      check.expect.bitwise actual(%sum) expected(%sum) : tensor<3xf32>
      check.expect.bitwise actual(%last) expected(%last) : tensor<3xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(5) : index
    %initial = check.literal value(0) : i32
    %flags = check.generate.fill value(1) : tensor<16xi32>
    %values = check.generate.fill value(inf) : tensor<16xf32>
    %sum = check.generate.fill value(nan) : tensor<3xf32>
    %last = check.generate.fill value(nan) : tensor<3xf32>
    check.compare<@guarded_state_variants, @guarded_state_oracle>(%row_count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<16xf32>, tensor<3xf32>, tensor<3xf32>) -> () {
      check.expect.bitwise actual(%sum) expected(%sum) : tensor<3xf32>
      check.expect.bitwise actual(%last) expected(%last) : tensor<3xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %row_count = check.literal value(5) : index
    %initial = check.literal value(2139095040) : i32
    %flags = check.generate.fill value(1) : tensor<16xi32>
    %values = check.generate.fill value(-inf) : tensor<16xf32>
    %sum = check.generate.fill value(0.0) : tensor<3xf32>
    %last = check.generate.fill value(0.0) : tensor<3xf32>
    check.compare<@guarded_state_variants, @guarded_state_oracle>(%row_count, %initial, %flags, %values, %sum, %last) : (index, i32, tensor<16xi32>, tensor<16xf32>, tensor<3xf32>, tensor<3xf32>) -> () {
      check.expect.close actual(%sum) expected(%sum) atol(0.0) rtol(0.0) nan(same) : tensor<3xf32>
      check.expect.bitwise actual(%last) expected(%last) : tensor<3xf32>
    }
  }
  check.return
}

kernel.def @segmented_guarded_read_ahead_variants() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%flag_buffer: buffer, %value_buffer: buffer, %output_buffer: buffer, %length: index) {
  %base = index.constant 0 : offset
  %segment_count = index.constant 8 : index
  %serial_depth = index.constant 1 : index
  %pipelined_depth = index.constant 3 : index
  %deep_depth = index.constant 4 : index
  %flags_aligned = buffer.assume.alignment %flag_buffer {minimum_alignment = 4} : buffer
  %values_aligned = buffer.assume.alignment %value_buffer {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output_buffer {minimum_alignment = 4} : buffer
  %flags_storage, %values_storage, %output_storage = buffer.assume.noalias %flags_aligned, %values_aligned, %output_aligned : buffer, buffer, buffer
  %flags = buffer.view %flags_storage[%base] : buffer -> view<32768xi32>
  %values = buffer.view %values_storage[%base] : buffer -> view<32768xf32>
  %output = buffer.view %output_storage[%base] : buffer -> view<3xf32>
  %serial = template.apply<@test.segmented_guarded_sum>(%flags, %values, %length, %segment_count, %serial_depth) : (view<32768xi32>, view<32768xf32>, index, index, index) -> (f32)
  %pipelined = template.apply<@test.segmented_guarded_sum>(%flags, %values, %length, %segment_count, %pipelined_depth) : (view<32768xi32>, view<32768xf32>, index, index, index) -> (f32)
  %deep = template.apply<@test.segmented_guarded_sum>(%flags, %values, %length, %segment_count, %deep_depth) : (view<32768xi32>, view<32768xf32>, index, index, index) -> (f32)
  view.store %serial, %output[0] : f32, view<3xf32>
  view.store %pipelined, %output[1] : f32, view<3xf32>
  view.store %deep, %output[2] : f32, view<3xf32>
  kernel.return
}

// The VM oracle preserves segment and element order without pipelined read-ahead.
func.def @segmented_guarded_read_ahead_oracle(%flag_buffer: buffer, %value_buffer: buffer, %output_buffer: buffer, %length: index) {
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %segment_count = index.constant 8 : index
  %segment_length = index.constant 64 : index
  %end = index.assume %length [range(%length, 0, 64)] : index
  %threshold = scalar.constant 0 : i32
  %initial = scalar.constant 0.0 : f32
  %base_offset = index.constant 0 : offset
  %flags = buffer.view %flag_buffer[%base_offset] : buffer -> view<32768xi32>
  %values = buffer.view %value_buffer[%base_offset] : buffer -> view<32768xf32>
  %output = buffer.view %output_buffer[%base_offset] : buffer -> view<3xf32>
  %result = scf.for %segment = [%begin to %segment_count step %step](%accumulator = %initial : f32) -> (f32) {
    %base = index.mul %segment, %segment_length : index
    %partial = scf.for %i = [%begin to %end step %step](%sum = %accumulator : f32) -> (f32) {
      %position = index.add %base, %i : index
      %flag = view.load %flags[%position] : view<32768xi32> -> i32
      %valid = scalar.cmpi sgt, %flag, %threshold : i32
      %next = scf.if %valid -> (f32) {
        %value = view.load %values[%position] : view<32768xf32> -> f32
        %updated = scalar.addf %sum, %value : f32
        scf.yield %updated : f32
      } else {
        scf.yield %sum : f32
      }
      scf.yield %next : f32
    }
    scf.yield %partial : f32
  }
  view.store %result, %output[0] : f32, view<3xf32>
  view.store %result, %output[1] : f32, view<3xf32>
  view.store %result, %output[2] : f32, view<3xf32>
  func.return
}

check.scenario @segmented_guarded_read_ahead_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(0) : index
    %flags = check.generate.iota offset(-1) step(2) period(2) : tensor<32768xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<32768xf32>
    %output = check.generate.fill value(-1.0) : tensor<3xf32>
    check.compare<@segmented_guarded_read_ahead_variants, @segmented_guarded_read_ahead_oracle>(%flags, %values, %output, %length) : (tensor<32768xi32>, tensor<32768xf32>, tensor<3xf32>, index) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<3xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(3) : index
    %flags = check.generate.iota offset(-1) step(2) period(2) : tensor<32768xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<32768xf32>
    %output = check.generate.fill value(-1.0) : tensor<3xf32>
    check.compare<@segmented_guarded_read_ahead_variants, @segmented_guarded_read_ahead_oracle>(%flags, %values, %output, %length) : (tensor<32768xi32>, tensor<32768xf32>, tensor<3xf32>, index) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<3xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(7) : index
    %flags = check.generate.iota offset(-1) step(2) period(2) : tensor<32768xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<32768xf32>
    %output = check.generate.fill value(-1.0) : tensor<3xf32>
    check.compare<@segmented_guarded_read_ahead_variants, @segmented_guarded_read_ahead_oracle>(%flags, %values, %output, %length) : (tensor<32768xi32>, tensor<32768xf32>, tensor<3xf32>, index) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<3xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(64) : index
    %flags = check.generate.iota offset(-1) step(2) period(2) : tensor<32768xi32>
    %values = check.generate.iota offset(1.0) step(1.0) : tensor<32768xf32>
    %output = check.generate.fill value(-1.0) : tensor<3xf32>
    check.compare<@segmented_guarded_read_ahead_variants, @segmented_guarded_read_ahead_oracle>(%flags, %values, %output, %length) : (tensor<32768xi32>, tensor<32768xf32>, tensor<3xf32>, index) -> () {
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<3xf32>
    }
  }
  check.return
}
