load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The semantic parser is independent of the upstream drivers and LLVM backend.
cc_library(
    name = "parser",
    srcs = glob(["src/parser/cxx/*.cc"]),
    hdrs = glob(["src/parser/cxx/**/*.h"]),
    # The vendored parser owns its implementation warning policy.
    copts = select({
        "@platforms//os:windows": [
            "/std:c++latest",
            "/EHsc",
            "/GR",
            "/W0",
        ],
        "//conditions:default": [
            "-std=c++23",
            "-fexceptions",
            "-frtti",
            "-w",
        ],
    }),
    defines = ['CXX_VERSION="1.2.0"'],
    features = ["-default_cpp_std"],
    includes = ["src/parser"],
)
