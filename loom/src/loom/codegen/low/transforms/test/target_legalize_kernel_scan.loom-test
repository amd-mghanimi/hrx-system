  %57 = scalar.cmpi ult, %54, %42 : i32
  %58 = scalar.andi %48, %56 : i1
  %59 = scalar.andi %58, %57 : i1
  %60 = scf.select %59, %54, %51 : i32
  %61 = scalar.remui %60, %42 : i32
  %62, %63 = kernel.subgroup.shuffle<index> %value, %61, %42 : i32, i32, i32
  %64 = scalar.andi %59, %63 : i1
  %8 = scalar.addi %62, %value : i32
  %9 = scf.select %64, %8, %value : i32
  %10 = scalar.constant 2 : i32
  %15 = scalar.constant 0 : i32
  %16 = scalar.constant 1 : i32
  %17 = scalar.constant 64 : i32
  %18 = scalar.cmpi ne, %4, %15 : i32
  %19 = scalar.cmpi ule, %4, %17 : i32
  %20 = scalar.andi %18, %19 : i1
  %21 = scf.select %20, %4, %16 : i32
  %22 = scalar.cmpi ult, %10, %21 : i32
  %23 = scalar.andi %20, %22 : i1
  %24 = scf.select %23, %10, %15 : i32
  %25 = kernel.subgroup.lane.id : index
  %26 = index.cast %25 : index to i32
  %27 = scalar.divui %26, %21 : i32
  %29 = scalar.subi %26, %24 : i32
  %30 = scalar.divui %29, %21 : i32
  %31 = scalar.cmpi eq, %30, %27 : i32
  %32 = scalar.cmpi ult, %29, %17 : i32
  %33 = scalar.andi %23, %31 : i1
  %34 = scalar.andi %33, %32 : i1
  %35 = scf.select %34, %29, %26 : i32
  %36 = scalar.remui %35, %17 : i32
  %37, %38 = kernel.subgroup.shuffle<index> %9, %36, %17 : i32, i32, i32
  %39 = scalar.andi %34, %38 : i1
  %13 = scalar.addi %37, %9 : i32
  %prefix = scf.select %39, %13, %9 : i32
  test.use %prefix : i32
  kernel.return
}
