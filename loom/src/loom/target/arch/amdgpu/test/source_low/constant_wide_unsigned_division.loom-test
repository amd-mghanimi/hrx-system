// RUN: emit source-low output=low

amdgpu.target<gfx11-generic> @target

func.def target(@target) @bounded_uniform_remainder(%input: i64) -> (i64) {
  %value = scalar.assume %input [range(%input, 0, 9223372036854775807)] : i64
  %divisor = scalar.constant 7 : i64
  %result = scalar.remui %value, %divisor : i64
  func.return %result : i64
}

