  %view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %13 = mov.static-byte-offset 512
  %14 = slice %signed[0] : reg<aie2p.er x2> -> reg<aie2p.er>
  %15 = mov.i32 4
  %16 = mac %13, %14, %15
  %17 = mov.address-index %16
  %value = lda.i32.index %view, %17
  return %value
}

// ====

func.def @negative_varying_coefficient(%input: buffer, %table: buffer) -> (i32) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<1xi32>
  %raw = view.load %source[0] : view<1xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -1, 0)] : i32
  %coordinate = index.cast %signed : i32 to index
  %c0 = index.constant 0 : index
  %position = index.sub %c0, %coordinate : index
  %word_bytes = index.constant 4 : offset
  %origin = index.scale %position, %word_bytes : index, offset -> offset
  %view = buffer.view %table[%origin] : buffer -> view<1xi32>
  %value = view.load %view[0] : view<1xi32> -> i32
  func.return %value : i32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @negative_varying_coefficient() -> (reg<aie2p.er>) asm {
  %source = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %view = resource<native_pointer> {index = 1, source_type = buffer} : reg<aie2p.ep>
  %coordinate = lda %source, 0
  %c0 = mov.short 0
  %position = sub %c0, %coordinate
  %word_bytes = mov.short 4
  %origin = mul %position, %word_bytes
  %22 = mov.address-index %origin
  %value = lda.i32.index %view, %22
  return %value
}
