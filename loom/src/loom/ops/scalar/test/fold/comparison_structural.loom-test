// RUN: pass canonicalize

// cmpi folds same-SSA reflexive and irreflexive predicates.
func.def @cmpi_same_value(%x: i32) -> (i1, i1) {
  %eq = scalar.cmpi eq, %x, %x : i32
  %ult = scalar.cmpi ult, %x, %x : i32
  func.return %eq, %ult : i1, i1
}
// ----
func.def @cmpi_same_value(%x: i32) -> (i1, i1) {
  %eq = scalar.constant true : i1
  %ult = scalar.constant false : i1
  func.return %eq, %ult : i1, i1
}

// ====

// cmpi moves a literal lhs to the rhs and swaps the predicate.
func.def @cmpi_literal_rhs(%x: i32) -> (i1) {
  %c7 = scalar.constant 7 : i32
  %r = scalar.cmpi slt, %c7, %x : i32
  func.return %r : i1
}
// ----
func.def @cmpi_literal_rhs(%x: i32) -> (i1) {
  %c7 = scalar.constant 7 : i32
  %r = scalar.cmpi sgt, %x, %c7 : i32
  func.return %r : i1
}

// ====

// Unsigned comparisons against zero collapse to constants or equality tests.
func.def @cmpi_unsigned_zero(%x: i32) -> (i1, i1) {
  %c0 = scalar.constant 0 : i32
  %lt = scalar.cmpi ult, %x, %c0 : i32
  %gt = scalar.cmpi ugt, %x, %c0 : i32
  func.return %lt, %gt : i1, i1
}
// ----
func.def @cmpi_unsigned_zero(%x: i32) -> (i1, i1) {
  %c0 = scalar.constant 0 : i32
  %lt = scalar.constant false : i1
  %gt = scalar.cmpi ne, %x, %c0 : i32
  func.return %lt, %gt : i1, i1
}

// ====

// cmpi uses integer range facts for simple proofs.
func.def @cmpi_range_proof(%x: i32, %y: i32) -> (i1, i1) {
  %lo = scalar.assume %x [range(%x, 0, 4)] : i32
  %hi = scalar.assume %y [range(%y, 8, 16)] : i32
  %lt = scalar.cmpi slt, %lo, %hi : i32
  %ne = scalar.cmpi ne, %lo, %hi : i32
  func.return %lt, %ne : i1, i1
}
// ----
func.def @cmpi_range_proof(%x: i32, %y: i32) -> (i1, i1) {
  %lt = scalar.constant true : i1
  %ne = scalar.constant true : i1
  func.return %lt, %ne : i1, i1
}

// ====

// At x=2147483642, x+8 wraps negative while x+4 stays positive. The signed
// comparison therefore cannot fold to true through linear cancellation.
func.def @cmpi_wrapping_order(%x: i32) -> (i1) {
  %c4 = scalar.constant 4 : i32
  %c8 = scalar.constant 8 : i32
  %lhs = scalar.addi %x, %c4 : i32
  %rhs = scalar.addi %x, %c8 : i32
  %r = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %r : i1
}
// ----
func.def @cmpi_wrapping_order(%x: i32) -> (i1) {
  %c4 = scalar.constant 4 : i32
  %c8 = scalar.constant 8 : i32
  %lhs = scalar.addi %x, %c4 : i32
  %rhs = scalar.addi %x, %c8 : i32
  %r = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %r : i1
}

// ====

func.def @cmpi_nonwrapping_order(%value: i32) -> (i1) {
  %bounded = scalar.assume %value [range(%value, 0, 1024)] : i32
  %c4 = scalar.constant 4 : i32
  %c8 = scalar.constant 8 : i32
  %lhs = scalar.addi %bounded, %c4 : i32
  %rhs = scalar.addi %bounded, %c8 : i32
  %result = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %result : i1
}

// ----
func.def @cmpi_nonwrapping_order(%value: i32) -> (i1) {
  %result = scalar.constant true : i1
  func.return %result : i1
}

// ====

// An explicit no-signed-wrap contract permits integer-order cancellation.
func.def @cmpi_nsw_order(%value: i32) -> (i1) {
  %c4 = scalar.constant 4 : i32
  %c8 = scalar.constant 8 : i32
  %lhs = scalar.addi<nsw> %value, %c4 : i32
  %rhs = scalar.addi<nsw> %value, %c8 : i32
  %result = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %result : i1
}

// ----
func.def @cmpi_nsw_order(%value: i32) -> (i1) {
  %result = scalar.constant true : i1
  func.return %result : i1
}

// ====

// No unsigned wrap does not guarantee signed ordering across the sign bit.
func.def @cmpi_nuw_does_not_imply_signed_order(%value: i32) -> (i1) {
  %c4 = scalar.constant 4 : i32
  %c8 = scalar.constant 8 : i32
  %lhs = scalar.addi<nuw> %value, %c4 : i32
  %rhs = scalar.addi<nuw> %value, %c8 : i32
  %result = scalar.cmpi slt, %lhs, %rhs : i32
  func.return %result : i1
}

// ====

// NaN-sensitive same-value comparisons fold only with nnan.
func.def @cmpf_same_value(%x: f32) -> (i1, i1, i1) {
  %eq = scalar.cmpf<nnan> oeq, %x, %x : f32
  %uno = scalar.cmpf<nnan> uno, %x, %x : f32
  %nan_sensitive = scalar.cmpf oeq, %x, %x : f32
  func.return %eq, %uno, %nan_sensitive : i1, i1, i1
}
// ----
func.def @cmpf_same_value(%x: f32) -> (i1, i1, i1) {
  %eq = scalar.constant true : i1
  %uno = scalar.constant false : i1
  %nan_sensitive = scalar.cmpf oeq, %x, %x : f32
  func.return %eq, %uno, %nan_sensitive : i1, i1, i1
}

// ====

// Address carries compare bit patterns even when the low word is negative
// in the signed representation used by integer facts.
func.def @cmpi_address_carry() -> (i32, i1) {
  %base = scalar.constant -4 : i32
  %offset = scalar.constant 576 : i32
  %low = scalar.addi %base, %offset : i32
  %overflow = scalar.cmpi ult, %low, %base : i32
  %carry = scalar.extui %overflow : i1 to i32
  %same_bits = scalar.constant -4 : i32
  %unchanged = scalar.cmpi ult, %same_bits, %base : i32
  func.return %carry, %unchanged : i32, i1
}

// ----
func.def @cmpi_address_carry() -> (i32, i1) {
  %carry = scalar.constant 1 : i32
  %unchanged = scalar.constant false : i1
  func.return %carry, %unchanged : i32, i1
}

// ====

// Negative signed ranges are above positive ranges in unsigned order. Two
// wholly negative ranges retain their relative order.
func.def @cmpi_unsigned_negative_ranges(%x: i8, %y: i8, %z: i8) -> (i1, i1, i1, i1, i1) {
  %negative = scalar.assume %x [range(%x, -8, -4)] : i8
  %positive = scalar.assume %y [range(%y, 1, 4)] : i8
  %higher = scalar.assume %z [range(%z, -2, -1)] : i8
  %lt = scalar.cmpi ult, %negative, %positive : i8
  %ge = scalar.cmpi uge, %negative, %positive : i8
  %le = scalar.cmpi ule, %positive, %negative : i8
  %gt = scalar.cmpi ugt, %positive, %negative : i8
  %ordered = scalar.cmpi ult, %negative, %higher : i8
  func.return %lt, %ge, %le, %gt, %ordered : i1, i1, i1, i1, i1
}

// ----
func.def @cmpi_unsigned_negative_ranges(%x: i8, %y: i8, %z: i8) -> (i1, i1, i1, i1, i1) {
  %lt = scalar.constant false : i1
  %ge = scalar.constant true : i1
  %le = scalar.constant true : i1
  %gt = scalar.constant false : i1
  %ordered = scalar.constant true : i1
  func.return %lt, %ge, %le, %gt, %ordered : i1, i1, i1, i1, i1
}

// ====

// A signed interval crossing zero contains both unsigned extrema. Ordering
// against an interior point stays dynamic, while an inclusive maximum folds.
func.def @cmpi_unsigned_crossing_zero(%value: i32) -> (i1, i1) {
  %bounded = scalar.assume %value [range(%value, -2, 2)] : i32
  %interior = scalar.constant -4 : i32
  %maximum = scalar.constant -1 : i32
  %dynamic = scalar.cmpi ult, %bounded, %interior : i32
  %at_most_maximum = scalar.cmpi ule, %bounded, %maximum : i32
  func.return %dynamic, %at_most_maximum : i1, i1
}

// ----
func.def @cmpi_unsigned_crossing_zero(%value: i32) -> (i1, i1) {
  %bounded = scalar.assume %value [range(%value, -2, 2)] : i32
  %interior = scalar.constant -4 : i32
  %dynamic = scalar.cmpi ult, %bounded, %interior : i32
  %at_most_maximum = scalar.constant true : i1
  func.return %dynamic, %at_most_maximum : i1, i1
}

// ====

// Unsigned i64 ordering must not overflow through signed endpoint arithmetic.
func.def @cmpi_unsigned_full_width() -> (i1, i1) {
  %signed_maximum = scalar.constant 9223372036854775807 : i64
  %signed_minimum = scalar.constant -9223372036854775808 : i64
  %unsigned_maximum = scalar.constant -1 : i64
  %sign_boundary = scalar.cmpi ult, %signed_maximum, %signed_minimum : i64
  %upper_half = scalar.cmpi ugt, %unsigned_maximum, %signed_minimum : i64
  func.return %sign_boundary, %upper_half : i1, i1
}

// ----
func.def @cmpi_unsigned_full_width() -> (i1, i1) {
  %sign_boundary = scalar.constant true : i1
  %upper_half = scalar.constant true : i1
  func.return %sign_boundary, %upper_half : i1, i1
}
