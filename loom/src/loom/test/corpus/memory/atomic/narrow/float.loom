// Exchanges return the original NaN payload; arithmetic keeps minimum
// subnormals and signed zeros. Adjacent cells exercise independent word retries.
kernel.def @narrow_float_updates() {
  %unit = index.constant 1 : index
  %width = index.constant 65 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%half: buffer, %brain: buffer, %e4m3: buffer, %e5m2: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %lane = kernel.workitem.id<x> : index
  %results = buffer.view %output[%origin] : buffer -> view<20x65xi16>
  %memory_half = buffer.assume.memory_space<global> %half : buffer
  %offset_half = index.constant 2 : offset
  %cells_half = buffer.view %memory_half[%offset_half] : buffer -> view<65xf16>
  %nan_bits_half = scalar.constant 31745 : i16
  %subnormal_bits_half = scalar.constant 1 : i16
  %negative_zero_bits_half = scalar.constant -32768 : i16
  %nan_half = scalar.bitcast %nan_bits_half : i16 to f16
  %subnormal_half = scalar.bitcast %subnormal_bits_half : i16 to f16
  %negative_zero_half = scalar.bitcast %negative_zero_bits_half : i16 to f16
  %positive_zero_half = scalar.constant 0.0 : f16
  view.store %nan_half, %cells_half[%lane] : f16, view<65xf16>
  %exchanged_half = view.atomic.rmw<xchgf> %subnormal_half, %cells_half[%lane] {ordering = acq_rel, scope = system} : f16, view<65xf16> -> f16
  %added_half = view.atomic.rmw<addf, noftz> %subnormal_half, %cells_half[%lane] {ordering = acq_rel, scope = system} : f16, view<65xf16> -> f16
  view.atomic.reduce<addf, noftz> %subnormal_half, %cells_half[%lane] {ordering = release, scope = device} : f16, view<65xf16>
  %minimum_half = view.atomic.rmw<minnumf> %negative_zero_half, %cells_half[%lane] {ordering = relaxed, scope = device} : f16, view<65xf16> -> f16
  %maximum_half = view.atomic.rmw<maximumf> %positive_zero_half, %cells_half[%lane] {ordering = relaxed, scope = subgroup} : f16, view<65xf16> -> f16
  %final_half = view.atomic.load %cells_half[%lane] {ordering = acquire, scope = system} : view<65xf16> -> f16
  %exchanged_bits_half = scalar.bitcast %exchanged_half : f16 to i16
  view.store %exchanged_bits_half, %results[0, %lane] : i16, view<20x65xi16>
  %added_bits_half = scalar.bitcast %added_half : f16 to i16
  view.store %added_bits_half, %results[1, %lane] : i16, view<20x65xi16>
  %minimum_bits_half = scalar.bitcast %minimum_half : f16 to i16
  view.store %minimum_bits_half, %results[2, %lane] : i16, view<20x65xi16>
  %maximum_bits_half = scalar.bitcast %maximum_half : f16 to i16
  view.store %maximum_bits_half, %results[3, %lane] : i16, view<20x65xi16>
  %final_bits_half = scalar.bitcast %final_half : f16 to i16
  view.store %final_bits_half, %results[4, %lane] : i16, view<20x65xi16>
  %memory_brain = buffer.assume.memory_space<generic> %brain : buffer
  %offset_brain = index.constant 2 : offset
  %cells_brain = buffer.view %memory_brain[%offset_brain] : buffer -> view<65xbf16>
  %nan_bits_brain = scalar.constant 32641 : i16
  %subnormal_bits_brain = scalar.constant 1 : i16
  %negative_zero_bits_brain = scalar.constant -32768 : i16
  %nan_brain = scalar.bitcast %nan_bits_brain : i16 to bf16
  %subnormal_brain = scalar.bitcast %subnormal_bits_brain : i16 to bf16
  %negative_zero_brain = scalar.bitcast %negative_zero_bits_brain : i16 to bf16
  %positive_zero_brain = scalar.constant 0.0 : bf16
  view.store %nan_brain, %cells_brain[%lane] : bf16, view<65xbf16>
  %exchanged_brain = view.atomic.rmw<xchgf> %subnormal_brain, %cells_brain[%lane] {ordering = acq_rel, scope = system} : bf16, view<65xbf16> -> bf16
  %added_brain = view.atomic.rmw<addf, noftz> %subnormal_brain, %cells_brain[%lane] {ordering = acq_rel, scope = system} : bf16, view<65xbf16> -> bf16
  view.atomic.reduce<addf, noftz> %subnormal_brain, %cells_brain[%lane] {ordering = release, scope = device} : bf16, view<65xbf16>
  %minimum_brain = view.atomic.rmw<minnumf> %negative_zero_brain, %cells_brain[%lane] {ordering = relaxed, scope = device} : bf16, view<65xbf16> -> bf16
  %maximum_brain = view.atomic.rmw<maximumf> %positive_zero_brain, %cells_brain[%lane] {ordering = relaxed, scope = subgroup} : bf16, view<65xbf16> -> bf16
  %final_brain = view.atomic.load %cells_brain[%lane] {ordering = acquire, scope = system} : view<65xbf16> -> bf16
  %exchanged_bits_brain = scalar.bitcast %exchanged_brain : bf16 to i16
  view.store %exchanged_bits_brain, %results[5, %lane] : i16, view<20x65xi16>
  %added_bits_brain = scalar.bitcast %added_brain : bf16 to i16
  view.store %added_bits_brain, %results[6, %lane] : i16, view<20x65xi16>
  %minimum_bits_brain = scalar.bitcast %minimum_brain : bf16 to i16
  view.store %minimum_bits_brain, %results[7, %lane] : i16, view<20x65xi16>
  %maximum_bits_brain = scalar.bitcast %maximum_brain : bf16 to i16
  view.store %maximum_bits_brain, %results[8, %lane] : i16, view<20x65xi16>
  %final_bits_brain = scalar.bitcast %final_brain : bf16 to i16
  view.store %final_bits_brain, %results[9, %lane] : i16, view<20x65xi16>
  %memory_e4m3 = buffer.assume.memory_space<global> %e4m3 : buffer
  %offset_e4m3 = index.constant 1 : offset
  %cells_e4m3 = buffer.view %memory_e4m3[%offset_e4m3] : buffer -> view<65xf8E4M3>
  %nan_bits_e4m3 = scalar.constant -1 : i8
  %subnormal_bits_e4m3 = scalar.constant 1 : i8
  %negative_zero_bits_e4m3 = scalar.constant -128 : i8
  %nan_e4m3 = scalar.bitcast %nan_bits_e4m3 : i8 to f8E4M3
  %subnormal_e4m3 = scalar.bitcast %subnormal_bits_e4m3 : i8 to f8E4M3
  %negative_zero_e4m3 = scalar.bitcast %negative_zero_bits_e4m3 : i8 to f8E4M3
  %positive_zero_e4m3 = scalar.constant 0.0 : f8E4M3
  view.store %nan_e4m3, %cells_e4m3[%lane] : f8E4M3, view<65xf8E4M3>
  %exchanged_e4m3 = view.atomic.rmw<xchgf> %subnormal_e4m3, %cells_e4m3[%lane] {ordering = acq_rel, scope = system} : f8E4M3, view<65xf8E4M3> -> f8E4M3
  %added_e4m3 = view.atomic.rmw<addf, noftz> %subnormal_e4m3, %cells_e4m3[%lane] {ordering = acq_rel, scope = system} : f8E4M3, view<65xf8E4M3> -> f8E4M3
  view.atomic.reduce<addf, noftz> %subnormal_e4m3, %cells_e4m3[%lane] {ordering = release, scope = device} : f8E4M3, view<65xf8E4M3>
  %minimum_e4m3 = view.atomic.rmw<minnumf> %negative_zero_e4m3, %cells_e4m3[%lane] {ordering = relaxed, scope = device} : f8E4M3, view<65xf8E4M3> -> f8E4M3
  %maximum_e4m3 = view.atomic.rmw<maximumf> %positive_zero_e4m3, %cells_e4m3[%lane] {ordering = relaxed, scope = subgroup} : f8E4M3, view<65xf8E4M3> -> f8E4M3
  %final_e4m3 = view.atomic.load %cells_e4m3[%lane] {ordering = acquire, scope = system} : view<65xf8E4M3> -> f8E4M3
  %exchanged_bits_e4m3 = scalar.bitcast %exchanged_e4m3 : f8E4M3 to i8
  %exchanged_wide_e4m3 = scalar.extui %exchanged_bits_e4m3 : i8 to i16
  view.store %exchanged_wide_e4m3, %results[10, %lane] : i16, view<20x65xi16>
  %added_bits_e4m3 = scalar.bitcast %added_e4m3 : f8E4M3 to i8
  %added_wide_e4m3 = scalar.extui %added_bits_e4m3 : i8 to i16
  view.store %added_wide_e4m3, %results[11, %lane] : i16, view<20x65xi16>
  %minimum_bits_e4m3 = scalar.bitcast %minimum_e4m3 : f8E4M3 to i8
  %minimum_wide_e4m3 = scalar.extui %minimum_bits_e4m3 : i8 to i16
  view.store %minimum_wide_e4m3, %results[12, %lane] : i16, view<20x65xi16>
  %maximum_bits_e4m3 = scalar.bitcast %maximum_e4m3 : f8E4M3 to i8
  %maximum_wide_e4m3 = scalar.extui %maximum_bits_e4m3 : i8 to i16
  view.store %maximum_wide_e4m3, %results[13, %lane] : i16, view<20x65xi16>
  %final_bits_e4m3 = scalar.bitcast %final_e4m3 : f8E4M3 to i8
  %final_wide_e4m3 = scalar.extui %final_bits_e4m3 : i8 to i16
  view.store %final_wide_e4m3, %results[14, %lane] : i16, view<20x65xi16>
  %memory_e5m2 = buffer.assume.memory_space<generic> %e5m2 : buffer
  %offset_e5m2 = index.constant 1 : offset
  %cells_e5m2 = buffer.view %memory_e5m2[%offset_e5m2] : buffer -> view<65xf8E5M2>
  %nan_bits_e5m2 = scalar.constant 125 : i8
  %subnormal_bits_e5m2 = scalar.constant 1 : i8
  %negative_zero_bits_e5m2 = scalar.constant -128 : i8
  %nan_e5m2 = scalar.bitcast %nan_bits_e5m2 : i8 to f8E5M2
  %subnormal_e5m2 = scalar.bitcast %subnormal_bits_e5m2 : i8 to f8E5M2
  %negative_zero_e5m2 = scalar.bitcast %negative_zero_bits_e5m2 : i8 to f8E5M2
  %positive_zero_e5m2 = scalar.constant 0.0 : f8E5M2
  view.store %nan_e5m2, %cells_e5m2[%lane] : f8E5M2, view<65xf8E5M2>
  %exchanged_e5m2 = view.atomic.rmw<xchgf> %subnormal_e5m2, %cells_e5m2[%lane] {ordering = acq_rel, scope = system} : f8E5M2, view<65xf8E5M2> -> f8E5M2
  %added_e5m2 = view.atomic.rmw<addf, noftz> %subnormal_e5m2, %cells_e5m2[%lane] {ordering = acq_rel, scope = system} : f8E5M2, view<65xf8E5M2> -> f8E5M2
  view.atomic.reduce<addf, noftz> %subnormal_e5m2, %cells_e5m2[%lane] {ordering = release, scope = device} : f8E5M2, view<65xf8E5M2>
  %minimum_e5m2 = view.atomic.rmw<minnumf> %negative_zero_e5m2, %cells_e5m2[%lane] {ordering = relaxed, scope = device} : f8E5M2, view<65xf8E5M2> -> f8E5M2
  %maximum_e5m2 = view.atomic.rmw<maximumf> %positive_zero_e5m2, %cells_e5m2[%lane] {ordering = relaxed, scope = subgroup} : f8E5M2, view<65xf8E5M2> -> f8E5M2
  %final_e5m2 = view.atomic.load %cells_e5m2[%lane] {ordering = acquire, scope = system} : view<65xf8E5M2> -> f8E5M2
  %exchanged_bits_e5m2 = scalar.bitcast %exchanged_e5m2 : f8E5M2 to i8
  %exchanged_wide_e5m2 = scalar.extui %exchanged_bits_e5m2 : i8 to i16
  view.store %exchanged_wide_e5m2, %results[15, %lane] : i16, view<20x65xi16>
  %added_bits_e5m2 = scalar.bitcast %added_e5m2 : f8E5M2 to i8
  %added_wide_e5m2 = scalar.extui %added_bits_e5m2 : i8 to i16
  view.store %added_wide_e5m2, %results[16, %lane] : i16, view<20x65xi16>
  %minimum_bits_e5m2 = scalar.bitcast %minimum_e5m2 : f8E5M2 to i8
  %minimum_wide_e5m2 = scalar.extui %minimum_bits_e5m2 : i8 to i16
  view.store %minimum_wide_e5m2, %results[17, %lane] : i16, view<20x65xi16>
  %maximum_bits_e5m2 = scalar.bitcast %maximum_e5m2 : f8E5M2 to i8
  %maximum_wide_e5m2 = scalar.extui %maximum_bits_e5m2 : i8 to i16
  view.store %maximum_wide_e5m2, %results[18, %lane] : i16, view<20x65xi16>
  %final_bits_e5m2 = scalar.bitcast %final_e5m2 : f8E5M2 to i8
  %final_wide_e5m2 = scalar.extui %final_bits_e5m2 : i8 to i16
  view.store %final_wide_e5m2, %results[19, %lane] : i16, view<20x65xi16>
  kernel.return
}

// The oracle models the sequential value transitions in integer carriers. It
// leaves the guard elements untouched and writes every observed result lane.
func.def @narrow_float_updates_oracle(%half: buffer, %brain: buffer, %e4m3: buffer, %e5m2: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %wide_offset = index.constant 2 : offset
  %narrow_offset = index.constant 1 : offset
  %half_cells = buffer.view %half[%wide_offset] : buffer -> view<65xi16>
  %brain_cells = buffer.view %brain[%wide_offset] : buffer -> view<65xi16>
  %e4m3_cells = buffer.view %e4m3[%narrow_offset] : buffer -> view<65xi8>
  %e5m2_cells = buffer.view %e5m2[%narrow_offset] : buffer -> view<65xi8>
  %results = buffer.view %output[%origin] : buffer -> view<20x65xi16>
  %begin = index.constant 0 : index
  %end = index.constant 65 : index
  %step = index.constant 1 : index
  %c0_i8 = scalar.constant 0 : i8
  %c0_i16 = scalar.constant 0 : i16
  %c1 = scalar.constant 1 : i16
  %c3 = scalar.constant 3 : i16
  %wide_negative_zero_bits = scalar.constant -32768 : i16
  %half_nan = scalar.constant 31745 : i16
  %brain_nan = scalar.constant 32641 : i16
  %e4m3_nan = scalar.constant 255 : i16
  %e5m2_nan = scalar.constant 125 : i16
  %narrow_negative_zero = scalar.constant 128 : i16
  scf.for %lane = [%begin to %end step %step] {
    view.store %c0_i16, %half_cells[%lane] : i16, view<65xi16>
    view.store %c0_i16, %brain_cells[%lane] : i16, view<65xi16>
    view.store %c0_i8, %e4m3_cells[%lane] : i8, view<65xi8>
    view.store %c0_i8, %e5m2_cells[%lane] : i8, view<65xi8>
    view.store %half_nan, %results[0, %lane] : i16, view<20x65xi16>
    view.store %c1, %results[1, %lane] : i16, view<20x65xi16>
    view.store %c3, %results[2, %lane] : i16, view<20x65xi16>
    view.store %wide_negative_zero_bits, %results[3, %lane] : i16, view<20x65xi16>
    view.store %c0_i16, %results[4, %lane] : i16, view<20x65xi16>
    view.store %brain_nan, %results[5, %lane] : i16, view<20x65xi16>
    view.store %c1, %results[6, %lane] : i16, view<20x65xi16>
    view.store %c3, %results[7, %lane] : i16, view<20x65xi16>
    view.store %wide_negative_zero_bits, %results[8, %lane] : i16, view<20x65xi16>
    view.store %c0_i16, %results[9, %lane] : i16, view<20x65xi16>
    view.store %e4m3_nan, %results[10, %lane] : i16, view<20x65xi16>
    view.store %c1, %results[11, %lane] : i16, view<20x65xi16>
    view.store %c3, %results[12, %lane] : i16, view<20x65xi16>
    view.store %narrow_negative_zero, %results[13, %lane] : i16, view<20x65xi16>
    view.store %c0_i16, %results[14, %lane] : i16, view<20x65xi16>
    view.store %e5m2_nan, %results[15, %lane] : i16, view<20x65xi16>
    view.store %c1, %results[16, %lane] : i16, view<20x65xi16>
    view.store %c3, %results[17, %lane] : i16, view<20x65xi16>
    view.store %narrow_negative_zero, %results[18, %lane] : i16, view<20x65xi16>
    view.store %c0_i16, %results[19, %lane] : i16, view<20x65xi16>
  }
  func.return
}

check.scenario @narrow_float_payloads {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %half = check.generate.fill value(77) : tensor<67xi16>
    %brain = check.generate.fill value(77) : tensor<67xi16>
    %e4m3 = check.generate.fill value(77) : tensor<67xi8>
    %e5m2 = check.generate.fill value(77) : tensor<67xi8>
    %output = check.generate.fill value(-1) : tensor<20x65xi16>
    check.compare<@narrow_float_updates, @narrow_float_updates_oracle>(%half, %brain, %e4m3, %e5m2, %output) : (tensor<67xi16>, tensor<67xi16>, tensor<67xi8>, tensor<67xi8>, tensor<20x65xi16>) -> () {
      check.expect.bitwise actual(%half) expected(%half) : tensor<67xi16>
      check.expect.bitwise actual(%brain) expected(%brain) : tensor<67xi16>
      check.expect.bitwise actual(%e4m3) expected(%e4m3) : tensor<67xi8>
      check.expect.bitwise actual(%e5m2) expected(%e5m2) : tensor<67xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<20x65xi16>
    }
  }
  check.return
}
