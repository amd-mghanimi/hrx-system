load("//loom/build_tools/bazel:defs.bzl", "loom_module")

package(
    default_visibility = ["//visibility:public"],
    features = ["layering_check"],
    licenses = ["notice"],  # Apache 2.0
)

_NON_EXECUTION_EXAMPLES = [
    "lane_distribution.loom",
    "packed_field_contracts.loom",
    "q8_hip_shaped_unroll_unresolved.loom",
]

_PORTABLE_CASES = glob(
    ["*.loom"],
    exclude = _NON_EXECUTION_EXAMPLES,
)

exports_files(glob(["*.loom"]))

loom_module(
    name = "portable_cases",
    srcs = _PORTABLE_CASES,
    output_format = "bc",
)
