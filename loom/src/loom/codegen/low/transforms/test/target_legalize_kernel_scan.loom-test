  %46 = scf.select %45, %4, %41 : i32
  %47 = scalar.cmpi ult, %5, %46 : i32
  %48 = scalar.andi %45, %47 : i1
  %49 = scf.select %48, %5, %40 : i32
  %50 = kernel.subgroup.lane.id : index
  %51 = index.cast %50 : index to i32
  %52 = scalar.divui %51, %46 : i32
  %54 = scalar.subi %51, %49 : i32
  %55 = scalar.divui %54, %46 : i32
