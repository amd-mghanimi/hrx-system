// RUN: pass vector-memory-footprint

// The final complete block is safe even when the view has a partial tail.
// The packet offset is independent of the block/extent relation.
func.def @complete_block_packets(%input: buffer, %extent_input: index, %block_input: index, %packet_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %block = index.assume %block_input [range(%block_input, 0, 63)] : index
  %packet = index.assume %packet_input [range(%packet_input, 0, 3)] : index
  %block_width = index.constant 16 : index
  %packet_width = index.constant 4 : index
  %base = index.constant 0 : offset
  %count = index.div %extent, %block_width : index
  %in_bounds = index.cmp slt, %block, %count : index
  scf.if %in_bounds {
    %packet_offset = index.mul %packet, %packet_width : index
    %origin = index.madd %block, %block_width, %packet_offset : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

// ----
func.def @complete_block_packets(%input: buffer, %extent_input: index, %block_input: index, %packet_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %block = index.assume %block_input [range(%block_input, 0, 63)] : index
  %packet = index.assume %packet_input [range(%packet_input, 0, 3)] : index
  %block_width = index.constant 16 : index
  %packet_width = index.constant 4 : index
  %base = index.constant 0 : offset
  %count = index.div %extent, %block_width : index
  %in_bounds = index.cmp slt, %block, %count : index
  scf.if %in_bounds {
    %packet_offset = index.mul %packet, %packet_width : index
    %origin = index.madd %block, %block_width, %packet_offset : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

// ====
// RUN: pass canonicalize,scf-to-cfg,vector-memory-footprint

// Source cleanup turns division into a shift; CFG lowering retains the guard.
func.def @counted_blocks_after_cfg(%input: buffer, %extent_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %block_width = index.constant 16 : index
  %packet_offset = index.constant 12 : index
  %base = index.constant 0 : offset
  %count = index.div %extent, %block_width : index
  %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
  scf.for %block = [%c0 to %count step %c1] {
    %origin = index.madd %block, %block_width, %packet_offset : index
    %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
    test.use %value : vector<4xi32>
  }
  func.return
}

// ----
func.def @counted_blocks_after_cfg(%input: buffer, %extent_input: index) {
  %extent = index.assume %extent_input [range(%extent_input, 16, 1023)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %block_width = index.constant 16 : index
  %packet_offset = index.constant 12 : index
  %base = index.constant 0 : offset
  %13 = index.constant 4 : index
  %count = index.shrui %extent, %13 : index
  %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
  cfg.br ^_bb1(%c0: index)
^_bb1(%15: index):
  %17 = index.cmp slt, %15, %count : index
  cfg.cond_br %17, ^_bb2, ^_bb3
^_bb2:
  %block = index.assume %15 [range(%15, 0, 62), lt(%15, %count)] : index
  %origin = index.madd %block, %block_width, %packet_offset : index
  %value = vector.load %view[%origin] : view<[%extent]xi32> -> vector<4xi32>
  test.use %value : vector<4xi32>
  %18 = index.add %block, %c1 : index
  cfg.br ^_bb1(%18: index)
^_bb3:
  func.return
}

