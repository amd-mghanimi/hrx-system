diff --git a/cc/private/toolchain/windows_cc_toolchain_config.bzl b/cc/private/toolchain/windows_cc_toolchain_config.bzl
--- a/cc/private/toolchain/windows_cc_toolchain_config.bzl
+++ b/cc/private/toolchain/windows_cc_toolchain_config.bzl
@@ -106,6 +106,18 @@
     return ctx.attr.cpu in ["x64_windows", "arm64_windows"] and (ctx.attr.compiler == "msvc-cl" or ctx.attr.compiler == "clang-cl")

 def _impl(ctx):
+    if "thin_lto_link" in ctx.features and ctx.attr.compiler != "clang-cl":
+        fail("The optimized ThinLTO profile requires clang-cl on Windows. Select windows-clang-cl, or use -c opt for the selected compiler without ThinLTO.")
+
+    # The optimized profile names intent; each driver owns its spelling.
+    speed_optimization_feature = feature(
+        name = "optimize_for_speed",
+        flag_sets = [flag_set(
+            actions = all_compile_actions,
+            flag_groups = [flag_group(flags = ["/clang:-O3"] if ctx.attr.compiler == "clang-cl" else (["/O2"] if _use_msvc_toolchain(ctx) else ["-O3"]))],
+        )],
+    )
+
     profile_correction_flags = get_profile_correction_flags(ctx)

     if _use_msvc_toolchain(ctx):
@@ -1420,6 +1432,7 @@
             smaller_binary_feature,
             remove_unreferenced_code_feature,
             ignore_noisy_warnings_feature,
+            speed_optimization_feature,
             user_compile_flags_feature,
             sysroot_feature,
             unfiltered_compile_flags_feature,
@@ -1703,6 +1716,7 @@
                 supports_dynamic_linker_feature,
                 dbg_feature,
                 opt_feature,
+                speed_optimization_feature,
                 user_compile_flags_feature,
                 treat_warnings_as_errors_feature,
                 sysroot_feature,
@@ -1766,6 +1780,17 @@
         enabled = True,
     )
     features.extend([cpp_modules_feature, cpp_module_modmap_file_feature, cpp20_module_compile_flags_feature])
+
+    if ctx.attr.compiler == "clang-cl":
+        # COFF ThinLTO is owned by the link action. The index-only interface
+        # omits unused archive members required by Bazel's split backend graph.
+        features.append(feature(
+            name = "thin_lto_link",
+            flag_sets = [flag_set(
+                actions = [ACTION_NAMES.c_compile, ACTION_NAMES.cpp_compile],
+                flag_groups = [flag_group(flags = ["/clang:-flto=thin"])],
+            )],
+        ))

     extra_rules_based_features = depset(ctx.attr.extra_enabled_features + ctx.attr.extra_known_features)
     features.extend([convert_feature(extra_feature[FeatureInfo], enabled = extra_feature in ctx.attr.extra_enabled_features) for extra_feature in extra_rules_based_features.to_list()])
