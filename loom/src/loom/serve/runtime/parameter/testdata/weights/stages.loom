command.program.def public @many_domains() launch(%root0: buffer, %root1: buffer, %root2: buffer, %root3: buffer, %root4: buffer, %root5: buffer, %root6: buffer, %root7: buffer, %root8: buffer, %output: buffer) {
  %p0 = command.parameter %root0, "raw" : view<8xi32>
  %p1 = command.parameter %root1, "raw" : view<8xi32>
  %p2 = command.parameter %root2, "raw" : view<8xi32>
  %p3 = command.parameter %root3, "raw" : view<8xi32>
  %p4 = command.parameter %root4, "raw" : view<8xi32>
  %p5 = command.parameter %root5, "raw" : view<8xi32>
  %p6 = command.parameter %root6, "raw" : view<8xi32>
  %p7 = command.parameter %root7, "raw" : view<8xi32>
  %p8 = command.parameter %root8, "raw" : view<8xi32>
  kernel.launch @consume(%p0, %p1, %p2, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  kernel.launch @consume(%p3, %p4, %p5, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  kernel.launch @consume(%p6, %p7, %p8, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

