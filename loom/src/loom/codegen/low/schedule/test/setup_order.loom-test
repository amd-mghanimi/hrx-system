// ====

// An aliasing store also prevents extending a chain through an earlier load.
// RUN: emit low-schedule-query @store_inside_setup_chain kind=order consumer=0,1 per-user-placement-values=%loaded,%intermediate

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @store_inside_setup_chain(%address: reg<test.ptr>, %value: reg<test.i32 x4>) -> (reg<test.i32 x4>) asm {
  %loaded = test.load.v4i32 %address
  %intermediate = test.add.v4i32 %loaded, %value
  test.store.v4i32 %address, %value
  %dependency = test.load.v4i32 %address
  %result = test.add.v4i32 %intermediate, %dependency
  return %result
}

