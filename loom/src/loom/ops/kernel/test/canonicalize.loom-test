// ====

// Exact facts fold consumers while the convergent execution remains observable.
kernel.def @exact_broadcast_keeps_execution() {
  %unit_extent = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%workgroup_size, %unit_extent, %unit_extent) : index
} launch() {
  %input = scalar.constant 5 : i32
  %unit = scalar.constant 1 : i32
  %observed = kernel.subgroup.broadcast.first %input : i32
  %result = scalar.addi %observed, %unit : i32
  test.use %result : i32
  kernel.return
}

// ----
kernel.def @exact_broadcast_keeps_execution() {
  %unit_extent = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%workgroup_size, %unit_extent, %unit_extent) : index
} launch() {
  %input = scalar.constant 5 : i32
  %observed = kernel.subgroup.broadcast.first %input : i32
  %result = scalar.constant 6 : i32
  test.use %result : i32
  kernel.return
}

// ====

// An unused exact broadcast retains the original control predicate and region.
kernel.def @exact_broadcast_keeps_conditional() {
  %unit_extent = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%workgroup_size, %unit_extent, %unit_extent) : index
} launch(%condition: i1) {
  %input = scalar.constant 5 : i32
  %unit = scalar.constant 1 : i32
  scf.if %condition {
    %observed = kernel.subgroup.broadcast.first %input : i32
    %result = scalar.addi %observed, %unit : i32
    test.use %result : i32
  }
  kernel.return
}

// ----
kernel.def @exact_broadcast_keeps_conditional() {
  %unit_extent = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%workgroup_size, %unit_extent, %unit_extent) : index
} launch(%condition: i1) {
  %input = scalar.constant 5 : i32
  scf.if %condition {
    %observed = kernel.subgroup.broadcast.first %input : i32
    %result = scalar.constant 6 : i32
    test.use %result : i32
  }
  kernel.return
}

// ====

// Resultless regions with only a convergent operation are not dead regions.
kernel.def @unused_exact_broadcast_keeps_conditional() {
  %unit_extent = index.constant 1 : index
  %workgroup_size = index.constant 64 : index
  kernel.launch.config workgroups(%unit_extent, %unit_extent, %unit_extent) workgroup_size(%workgroup_size, %unit_extent, %unit_extent) : index
} launch(%condition: i1) {
  %input = scalar.constant 5 : i32
  scf.if %condition {
    %observed = kernel.subgroup.broadcast.first %input : i32
  }
  kernel.return
}

// ====

// Unit axes preserve the identity even with dynamic dispatch dimensions.
kernel.def @unit_dispatch_coordinates(%x: index, %y: index, %z: index) {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%x, %y, %z) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  %x = kernel.workitem.dispatch.id<x> : index
  %y = kernel.workitem.dispatch.id<y> : index
  %z = kernel.workitem.dispatch.id<z> : index
  test.use %x, %y, %z : index, index, index
  kernel.return
}

// ----
kernel.def @unit_dispatch_coordinates(%x: index, %y: index, %z: index) {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%x, %y, %z) workgroup_size(%unit, %unit, %unit) : index
} launch() {
  %x = kernel.workgroup.id<x> : index
  %y = kernel.workgroup.id<y> : index
  %z = kernel.workgroup.id<z> : index
  test.use %x, %y, %z : index, index, index
  kernel.return
}

// ====

// Other axes do not prevent a unit axis from becoming a workgroup coordinate.
// Neither a non-unit axis nor an unknown axis has that identity.
kernel.def @mixed_dispatch_coordinates(%groups: index, %size: index) {
  %unit = index.constant 1 : index
  %wide_axis = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %groups, %groups) workgroup_size(%unit, %wide_axis, %size) : index
} launch() {
  %x = kernel.workitem.dispatch.id<x> : index
  %y = kernel.workitem.dispatch.id<y> : index
  %z = kernel.workitem.dispatch.id<z> : index
  test.use %x, %y, %z : index, index, index
  kernel.return
}

// ----
kernel.def @mixed_dispatch_coordinates(%groups: index, %size: index) {
  %unit = index.constant 1 : index
  %wide_axis = index.constant 4 : index
  kernel.launch.config workgroups(%groups, %groups, %groups) workgroup_size(%unit, %wide_axis, %size) : index
} launch() {
  %x = kernel.workgroup.id<x> : index
  %y = kernel.workitem.dispatch.id<y> : index
  %z = kernel.workitem.dispatch.id<z> : index
  test.use %x, %y, %z : index, index, index
  kernel.return
}
