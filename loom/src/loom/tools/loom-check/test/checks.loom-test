// RUN: with-checks pass cse

func.def @constant() -> (index) {
  %first = index.constant 5 : index
  %second = index.constant 5 : index
  func.return %second : index
}

// ----
CHECK-COUNT-1: * = index.constant 5 : index
CHECK: func.return * : index

