// RUN: emit source-low target=amd.xdna.aie2p:core output=low

// The exact reciprocal path selects the native scalar instruction. General
// reciprocal multiplication is tracked in the expansion report.
func.def @scalar_f32_reciprocal(%input: f32) -> (f32) {
  %numerator = scalar.constant 1.0 : f32
  %result = scalar.divf<arcp> %numerator, %input : f32
  func.return %result : f32
}

// ----
low.func.def target<amd.xdna.aie2p.core> abi(object_function) @scalar_f32_reciprocal(%input: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %result = inv.f32 %input
  return %result
}
