func.def @continue_reference(%count: i32, %choose: i32) -> (i32, i32, i32, i32, i32, i32, i32, i32) {
  %begin = index.constant 0 : index
  %inner_end = index.constant 5 : index
  %step = index.constant 1 : index
  %count_unbounded = index.cast %count : i32 to index
  %count_index = index.assume %count_unbounded [range(%count_unbounded, 0, 34)] : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c7 = scalar.constant 7 : i32
  %c9 = scalar.constant 9 : i32
  %c11 = scalar.constant 11 : i32
  %c23 = scalar.constant 23 : i32
  %c39 = scalar.constant 39 : i32
  %c57 = scalar.constant 57 : i32
  %c100 = scalar.constant 100 : i32
  %c250 = scalar.constant 250 : i32
  %c257 = scalar.constant 257 : i32
  %c65537 = scalar.constant 65537 : i32
  %c65794 = scalar.constant 65794 : i32
  %branch_total, %post_selected_sum, %selected_sum, %selected_count, %nested_total, %scoped_local_sum, %scoped_count, %all_sum = scf.for %iteration = [%begin to %count_index step %step](%branch = %c0 : i32, %post_sum = %c0 : i32, %selected_index_sum = %c0 : i32, %selected_indices = %c0 : i32, %nested = %c0 : i32, %scope_sum = %c0 : i32, %scope_count = %c0 : i32, %index_sum = %c0 : i32) -> (i32, i32, i32, i32, i32, i32, i32, i32) {
    %index = index.cast %iteration : index to i32
    %masked = scalar.andi %index, %choose : i32
    %chosen = scalar.cmpi ne, %masked, %c0 : i32
    %selected = scalar.cmpi eq, %masked, %c0 : i32
    %chosen_skip_bits = scalar.andi %index, %c2 : i32
    %chosen_skips = scalar.cmpi ne, %chosen_skip_bits, %c0 : i32
    %chosen_full = scalar.addi %index, %c39 : i32
    %chosen_delta = scf.select %chosen_skips, %c3, %chosen_full : i32
    %unchosen_skip_bits = scalar.andi %index, %c4 : i32
    %unchosen_skips = scalar.cmpi ne, %unchosen_skip_bits, %c0 : i32
    %unchosen_full = scalar.addi %index, %c57 : i32
    %unchosen_delta = scf.select %unchosen_skips, %c9, %unchosen_full : i32
    %branch_delta = scf.select %chosen, %chosen_delta, %unchosen_delta : i32
    %next_branch = scalar.addi %branch, %branch_delta : i32
    %post_index = scalar.addi %index, %c1 : i32
    %post_masked = scalar.andi %post_index, %choose : i32
    %post_selected = scalar.cmpi eq, %post_masked, %c0 : i32
    %post_value = scf.select %post_selected, %post_index, %c0 : i32
    %next_post_sum = scalar.addi %post_sum, %post_value : i32
    %selected_value = scf.select %selected, %index, %c0 : i32
    %selected_increment = scf.select %selected, %c1, %c0 : i32
    %next_selected_sum = scalar.addi %selected_index_sum, %selected_value : i32
    %next_selected_count = scalar.addi %selected_indices, %selected_increment : i32
    %outer_times_seven = scalar.muli %index, %c7 : i32
    %inner_sum = scf.for %inner = [%begin to %inner_end step %step](%partial = %c0 : i32) -> (i32) {
      %inner_i32 = index.cast %inner : index to i32
      %combined = scalar.addi %index, %inner_i32 : i32
      %parity = scalar.andi %combined, %c1 : i32
      %even = scalar.cmpi eq, %parity, %c0 : i32
      %term = scalar.addi %outer_times_seven, %inner_i32 : i32
      %contribution = scf.select %even, %term, %c0 : i32
      %next = scalar.addi %partial, %contribution : i32
      scf.yield %next : i32
    }
    %nested_bonus = scf.select %selected, %c100, %c0 : i32
    %nested_increment = scalar.addi %inner_sum, %nested_bonus : i32
    %next_nested = scalar.addi %nested, %nested_increment : i32
    %chosen_local = scalar.addi %index, %c11 : i32
    %unchosen_local = scalar.addi %index, %c23 : i32
    %local = scf.select %chosen, %chosen_local, %unchosen_local : i32
    %chosen_local_bits = scalar.andi %local, %c1 : i32
    %unchosen_local_bits = scalar.andi %local, %c2 : i32
    %chosen_accepts = scalar.cmpi eq, %chosen_local_bits, %c0 : i32
    %unchosen_accepts = scalar.cmpi eq, %unchosen_local_bits, %c0 : i32
    %scope_accepts = scf.select %chosen, %chosen_accepts, %unchosen_accepts : i1
    %scope_value = scf.select %scope_accepts, %local, %c0 : i32
    %scope_increment = scf.select %scope_accepts, %c1, %c0 : i32
    %next_scope_sum = scalar.addi %scope_sum, %scope_value : i32
    %next_scope_count = scalar.addi %scope_count, %scope_increment : i32
    %next_index_sum = scalar.addi %index_sum, %index : i32
    scf.yield %next_branch, %next_post_sum, %next_selected_sum, %next_selected_count, %next_nested, %next_scope_sum, %next_scope_count, %next_index_sum : i32, i32, i32, i32, i32, i32, i32, i32
  }
  %count_nonzero = scalar.cmpi ugt, %count, %c0 : i32
  %effective_do_count = scf.select %count_nonzero, %count, %c1 : i32
  %count_plus_one = scalar.addi %count, %c1 : i32
  %count_plus_two = scalar.addi %count, %c2 : i32
  %for_step_offset = scalar.muli %count, %c257 : i32
  %for_index_offset = scalar.muli %count_plus_one, %c65537 : i32
  %for_partial = scalar.addi %post_selected_sum, %for_step_offset : i32
  %for_result = scalar.addi %for_partial, %for_index_offset : i32
  %while_offset = scalar.muli %count_plus_one, %c257 : i32
  %while_result = scalar.addi %post_selected_sum, %while_offset : i32
  %do_offset = scalar.muli %effective_do_count, %c65794 : i32
  %do_result = scalar.addi %selected_sum, %do_offset : i32
  %all_offset = scalar.muli %count_plus_two, %c257 : i32
  %all_result = scalar.addi %all_sum, %all_offset : i32
  %scope_count_plus_one = scalar.addi %scoped_count, %c1 : i32
  %scope_pair_product = scalar.muli %scoped_count, %scope_count_plus_one : i32
  %scope_triangle = scalar.divui %scope_pair_product, %c2 : i32
  %scope_value = scalar.addi %scoped_local_sum, %scope_triangle : i32
  %scope_offset = scalar.muli %scope_count_plus_one, %c257 : i32
  %scope_result = scalar.addi %scope_value, %scope_offset : i32
  %selected_sevens = scalar.muli %selected_count, %c7 : i32
  %byte_partial = scalar.addi %c250, %count : i32
  %byte_wide = scalar.addi %byte_partial, %selected_sevens : i32
  %byte_narrow = scalar.trunci %byte_wide : i32 to i8
  %byte_result = scalar.extui %byte_narrow : i8 to i32
  func.return %branch_total, %for_result, %while_result, %do_result, %nested_total, %all_result, %scope_result, %byte_result : i32, i32, i32, i32, i32, i32, i32, i32
}

func.def @continue_function_observations(%count: i32, %choose: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %branches = func.call @continue_branches(%count, %choose) : (i32, i32) -> (i32)
  %for_step = func.call @continue_for_step(%count, %choose) : (i32, i32) -> (i32)
  %while = func.call @continue_while(%count, %choose) : (i32, i32) -> (i32)
  %do = func.call @continue_do(%count, %choose) : (i32, i32) -> (i32)
  %nested = func.call @continue_nested(%count, %choose) : (i32, i32) -> (i32)
  %all = func.call @continue_all(%count) : (i32) -> (i32)
  %scopes = func.call @continue_scopes(%count, %choose) : (i32, i32) -> (i32)
  %byte = func.call @continue_byte(%count, %choose) : (i32, i32) -> (i32)
  %results = buffer.view %output[%origin] : buffer -> view<8xi32>
  view.store %branches, %results[0] : i32, view<8xi32>
  view.store %for_step, %results[1] : i32, view<8xi32>
  view.store %while, %results[2] : i32, view<8xi32>
  view.store %do, %results[3] : i32, view<8xi32>
  view.store %nested, %results[4] : i32, view<8xi32>
  view.store %all, %results[5] : i32, view<8xi32>
  view.store %scopes, %results[6] : i32, view<8xi32>
  view.store %byte, %results[7] : i32, view<8xi32>
  func.return
}

