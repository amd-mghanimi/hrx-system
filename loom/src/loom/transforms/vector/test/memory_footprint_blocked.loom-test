// Inclusive quotient guards include every element of the final block.
func.def @inclusive_coordinate_quotient(%input: buffer, %coordinate_input: index, %last_block_input: index) {
  %coordinate = index.assume %coordinate_input [range(%coordinate_input, 0, 1023)] : index
  %last_block = index.assume %last_block_input [range(%last_block_input, 0, 63)] : index
  %block_width = index.constant 16 : index
  %c1 = index.constant 1 : index
  %base = index.constant 0 : offset
  %block = index.div %coordinate, %block_width : index
  %in_bounds = index.cmp sle, %block, %last_block : index
  scf.if %in_bounds {
    %count = index.add %last_block, %c1 : index
    %extent = index.mul %count, %block_width : index
    %view = buffer.view %input[%base] : buffer -> view<[%extent]xi32>
    %value = vector.load %view[%coordinate] : view<[%extent]xi32> -> vector<1xi32>
    test.use %value : vector<1xi32>
  }
  func.return
}

// ----
