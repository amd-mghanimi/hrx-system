// A loop's offset induction carrier passes through i32 and unsigned i64 before
// a pointer helper consumes it. Bounds refine the value without moving storage.
func.def device inline @advance_address(%base: offset, %count: i64) -> (offset) {
  %c0 = scalar.constant 0 : i64
  %empty = scalar.cmpi eq, %count, %c0 : i64
  %result = scf.if %empty -> (offset) {
    scf.yield %base : offset
  } else {
    %shift = scalar.constant 2 : i64
    %bytes = scalar.shli %count, %shift : i64
    %base_integer = index.cast %base : offset to i64
    %address_integer = scalar.addi %base_integer, %bytes : i64
    %address = index.cast %address_integer : i64 to offset
    scf.yield %address : offset
  }
  func.return %result : offset
}

func.def device inline @compute_address_carrier_loop(%input: buffer, %counts: buffer, %lane: index) -> (i32) {
  %base = index.constant 0 : offset
  %counts_view = buffer.view %counts[%base] : buffer -> view<64xi32>
  %count = view.load %counts_view[%lane] : view<64xi32> -> i32
  %end = index.cast %count : i32 to offset
  %step = index.constant 1 : offset
  %c0 = scalar.constant 0 : i32
  %last = scf.for %iteration = [%base to %end step %step](%previous = %c0 : i32) -> (i32) {
    %word = index.cast %iteration : offset to i32
    %wide = scalar.extui %word : i32 to i64
    %address = func.call pure @advance_address(%base, %wide) : (offset, i64) -> (offset)
    %input_view = buffer.view %input[%address] : buffer -> view<1xi32>
    %value = view.load %input_view[0] : view<1xi32> -> i32
    scf.yield %value : i32
  }
  func.return %last : i32
}

kernel.def @address_carrier_loop() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %counts: buffer, %output: buffer, %length: i32) {
  %lane = kernel.workitem.id<x> : index
  %lane_integer = index.cast %lane : index to i32
  %active = scalar.cmpi ult, %lane_integer, %length : i32
  scf.if %active {
    %last = func.call @compute_address_carrier_loop(%input, %counts, %lane) : (buffer, buffer, index) -> (i32)
    %base = index.constant 0 : offset
    %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
    view.store %last, %output_view[%lane] : i32, view<64xi32>
  }
  kernel.return
}

func.def @address_carrier_loop_oracle(%input: buffer, %counts: buffer, %output: buffer, %length: i32) {
  %base = index.constant 0 : offset
  %output_view = buffer.view %output[%base] : buffer -> view<64xi32>
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %lane_integer = index.cast %lane : index to i32
    %active = scalar.cmpi ult, %lane_integer, %length : i32
    scf.if %active {
      %last = func.call @compute_address_carrier_loop(%input, %counts, %lane) : (buffer, buffer, index) -> (i32)
      view.store %last, %output_view[%lane] : i32, view<64xi32>
    }
  }
  func.return
}

check.scenario @address_carrier_loop_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1) step(1) : tensor<63xi32>
    %counts = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-123) : tensor<96xi32>
    %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %length = check.literal value(0) : i32
    check.compare<@address_carrier_loop, @address_carrier_loop_oracle>(%input, %counts, %output, %length) : (tensor<63xi32>, tensor<64xi32>, tensor<64xi32>, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<63xi32>
      check.expect.bitwise actual(%counts) expected(%counts) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1) step(1) : tensor<63xi32>
    %counts = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-123) : tensor<96xi32>
    %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %length = check.literal value(37) : i32
    check.compare<@address_carrier_loop, @address_carrier_loop_oracle>(%input, %counts, %output, %length) : (tensor<63xi32>, tensor<64xi32>, tensor<64xi32>, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<63xi32>
      check.expect.bitwise actual(%counts) expected(%counts) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(1) step(1) : tensor<63xi32>
    %counts = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-123) : tensor<96xi32>
    %output = check.tensor.view %storage offset(64) : tensor<96xi32> -> tensor<64xi32>
    %length = check.literal value(64) : i32
    check.compare<@address_carrier_loop, @address_carrier_loop_oracle>(%input, %counts, %output, %length) : (tensor<63xi32>, tensor<64xi32>, tensor<64xi32>, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<63xi32>
      check.expect.bitwise actual(%counts) expected(%counts) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<96xi32>
    }
  }
  check.return
}
