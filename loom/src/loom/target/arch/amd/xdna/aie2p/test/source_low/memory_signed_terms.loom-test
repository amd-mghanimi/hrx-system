func.def @signed_wide_source(%input: i64, %table: buffer) -> (i32) {
  %signed = scalar.assume %input [range(%input, -128, 127)] : i64
  %bias = scalar.constant 128 : i64
  %ordinal = scalar.addi %signed, %bias : i64
  %position = index.cast %ordinal : i64 to index
  %base = index.constant 0 : offset
  %view = buffer.view %table[%base] : buffer -> view<256xi32>
  %value = view.load %view[%position] : view<256xi32> -> i32
  func.return %value : i32
}

