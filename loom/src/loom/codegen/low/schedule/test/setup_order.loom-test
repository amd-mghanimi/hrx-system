// ====

// Input-free target packets remain in one retained setup chain ending at an
// unmarked structural result. That result may have several users, so the chain
// carries no downstream consumer prerequisite.
// RUN: emit low-schedule-query @retained_structural_setup kind=order consumer=1,2,3,4,5 per-user-placement-values=%lane0,%lane1,%lane2,%lane3 required-register-values=%lane0,%lane1,%lane2,%lane3

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @retained_structural_setup(%lhs: reg<test.i32 x4>, %rhs: reg<test.i32 x4>) -> (reg<test.i32 x4>, reg<test.i32 x4>, reg<test.i32 x4>) asm {
  %dependency = test.add.v4i32 %lhs, %rhs
  %lane0 = test.const.i32 0
  %lane1 = test.const.i32 1
  %lane2 = test.const.i32 2
  %lane3 = test.const.i32 3
  %packed = concat(%lane0, %lane1, %lane2, %lane3) : (reg<test.i32>, reg<test.i32>, reg<test.i32>, reg<test.i32>) -> reg<test.i32 x4>
  %result = test.add.v4i32 %packed, %dependency
  %second_result = test.add.v4i32 %packed, %rhs
  %unrelated = test.add.v4i32 %lhs, %rhs
  return %result, %second_result, %unrelated
}

