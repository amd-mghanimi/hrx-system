kernel.def target(@target) @wide_forward_inclusive() {
  %c1 = index.constant 1 : index
  %c64 = index.constant 64 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%value: i32) {
  %4 = scalar.constant 4 : i32
  %5 = scalar.constant 1 : i32
  %40 = scalar.constant 0 : i32
  %41 = scalar.constant 1 : i32
  %42 = scalar.constant 64 : i32
  %43 = scalar.cmpi ne, %4, %40 : i32
  %44 = scalar.cmpi ule, %4, %42 : i32
