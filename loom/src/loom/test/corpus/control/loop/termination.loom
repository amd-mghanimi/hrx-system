    %output = check.tensor.view %storage offset(16) : tensor<13xi32> -> tensor<5xi32>
    check.compare<@loop_boundary_table_sum, @loop_boundary_table_sum_oracle>(%begin, %end, %repeat, %input, %output) : (index, index, index, tensor<32xi32>, tensor<5xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<32xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<13xi32>
    }
  }
  check.return
}

