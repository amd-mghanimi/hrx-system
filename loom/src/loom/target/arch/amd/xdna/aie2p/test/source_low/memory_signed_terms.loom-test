low.func.def target<amd.xdna.aie2p.core> abi(object_function) @dynamic_stride_static_bias(%position: reg<aie2p.er>, %stride: reg<aie2p.er>) -> (reg<aie2p.er>) asm {
  %view = resource<native_pointer> {index = 0, source_type = buffer} : reg<aie2p.ep>
  %14 = mov.static-byte-offset 128
  %15 = mac %14, %position, %stride
  %16 = mov.address-index %15
  %value = lda.i8.index %view, %16
  return %value
}

