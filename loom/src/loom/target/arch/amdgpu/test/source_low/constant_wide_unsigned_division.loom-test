// ====

amdgpu.target<gfx942> @target

// A divisor above one word guarantees a one-word unsigned quotient, including
// numerators with the sign bit set.
func.def target(@target) @narrow_quotient_wide_divisor(%values: vector<2xi64>) -> (i64) {
  %value = vector.extract %values[0] : vector<2xi64> -> i64
  %divisor = scalar.constant 4294967297 : i64
  %result = scalar.remui %value, %divisor : i64
  func.return %result : i64
}

