func.def @continue_values_oracle(%output: buffer, %count: i32, %choose: i32) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 64 : index
  %step = index.constant 1 : index
  %c3 = scalar.constant 3 : i32
  %c7 = scalar.constant 7 : i32
  %results = buffer.view %output[%origin] : buffer -> view<64x8xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %lane_length = scalar.andi %lane_i32, %c3 : i32
    %length = scalar.addi %count, %lane_length : i32
    %lane_mask = scalar.andi %lane_i32, %c7 : i32
    %mask = scalar.xori %choose, %lane_mask : i32
    %branches, %for_step, %while, %do, %nested, %all, %scopes, %byte = func.call @continue_reference(%length, %mask) : (i32, i32) -> (i32, i32, i32, i32, i32, i32, i32, i32)
    view.store %branches, %results[%lane, 0] : i32, view<64x8xi32>
    view.store %for_step, %results[%lane, 1] : i32, view<64x8xi32>
    view.store %while, %results[%lane, 2] : i32, view<64x8xi32>
    view.store %do, %results[%lane, 3] : i32, view<64x8xi32>
    view.store %nested, %results[%lane, 4] : i32, view<64x8xi32>
    view.store %all, %results[%lane, 5] : i32, view<64x8xi32>
    view.store %scopes, %results[%lane, 6] : i32, view<64x8xi32>
    view.store %byte, %results[%lane, 7] : i32, view<64x8xi32>
  }
  func.return
