kernel.decl @array_records_kernel() launch(%input: buffer, %output: buffer)

check.case @copies {
  %input = check.generate.fill value(37) : tensor<4xi32>
  %output = check.generate.fill value(97) : tensor<4xi32>
  kernel.launch @array_records_kernel(%input, %output) : (tensor<4xi32>, tensor<4xi32>)
  %original = check.generate.fill value(37) : tensor<4xi32>
  check.expect.bitwise actual(%input) expected(%original) : tensor<4xi32>
  %saved_first = check.tensor.view %output offset(0) : tensor<4xi32> -> tensor<1xi32>
  %saved_second = check.tensor.view %output offset(4) : tensor<4xi32> -> tensor<1xi32>
  %helper_result = check.tensor.view %output offset(8) : tensor<4xi32> -> tensor<1xi32>
  %source_second = check.tensor.view %output offset(12) : tensor<4xi32> -> tensor<1xi32>
  %unchanged = check.generate.fill value(37) : tensor<1xi32>
  %returned = check.generate.fill value(40) : tensor<1xi32>
  %copied = check.generate.fill value(42) : tensor<1xi32>
  check.expect.bitwise actual(%saved_first) expected(%copied) : tensor<1xi32>
  check.expect.bitwise actual(%saved_second) expected(%unchanged) : tensor<1xi32>
  check.expect.bitwise actual(%helper_result) expected(%returned) : tensor<1xi32>
  check.expect.bitwise actual(%source_second) expected(%unchanged) : tensor<1xi32>
  check.return
}
