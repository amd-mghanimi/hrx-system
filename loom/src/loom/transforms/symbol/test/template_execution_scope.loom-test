// Each application selects for the execution environment in which it runs.
// Capturing a construction result does not retarget that computation.
// RUN: pass select-templates{rewrite=inline},canonicalize
test.target<low_core> @construction {subgroup_size = 64}

test.target<low_core> @worker {subgroup_size = 32}

template.decl @width_value() -> (i32)

template.def<@width_value> requires [#target.subgroup.size<64>] @width64() -> (i32) {
  %value = scalar.constant 64 : i32
  template.return %value : i32
}

template.def<@width_value> requires [#target.subgroup.size<32>] @width32() -> (i32) {
  %value = scalar.constant 32 : i32
  template.return %value : i32
}

pipeline.def public target(@construction) @publish_widths() run(%first: channel<tile<2xi32>>, %second: channel<tile<2xi32>>) {
  %construction_value = template.apply<@width_value>() : () -> (i32)
  pipeline.strand target(@worker) workers([0], [1], [1]) {
    %write, %record = channel.reserve %first : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
    %value = template.apply<@width_value>() : () -> (i32)
    view.store %construction_value, %record[0] : i32, view<2xi32>
    view.store %value, %record[1] : i32, view<2xi32>
    channel.publish %write : write<tile<2xi32>>
  }
  pipeline.strand target(@construction) workers([1], [1], [1]) {
    %write, %record = channel.reserve %second : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
    %value = template.apply<@width_value>() : () -> (i32)
    view.store %construction_value, %record[0] : i32, view<2xi32>
    view.store %value, %record[1] : i32, view<2xi32>
    channel.publish %write : write<tile<2xi32>>
  }
}

