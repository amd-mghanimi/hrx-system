    %lane_i32 = index.cast %lane : index to i32
    %byte = func.call @vector_signed_byte(%input, %divisor, %lane_i32) : (i32, i32, i32) -> (i32)
    %short = func.call @vector_signed_short(%input, %divisor, %lane_i32) : (i32, i32, i32) -> (i32)
    %short_index = index.add %short_base, %lane : index
    view.store %byte, %results[%lane] : i32, view<8xi32>
    view.store %short, %results[%short_index] : i32, view<8xi32>
  }
  func.return
}

func.def @vector_signed_reference(%input: i32, %divisor: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %short_base = index.constant 4 : index
  %c0_i32 = scalar.constant 0 : i32
  %c1_i32 = scalar.constant 1 : i32
  %c2_i32 = scalar.constant 2 : i32
  %c1_i8 = scalar.constant 1 : i8
  %byte_second = scalar.constant -127 : i8
  %byte_third = scalar.constant -1 : i8
  %byte_fourth = scalar.constant 127 : i8
  %byte_positive_divisor = scalar.constant 3 : i8
  %byte_negative_divisor = scalar.constant -3 : i8
  %c1_i16 = scalar.constant 1 : i16
  %short_second = scalar.constant -127 : i16
  %short_third = scalar.constant -1 : i16
  %short_fourth = scalar.constant 127 : i16
  %short_positive_divisor = scalar.constant 3 : i16
  %short_negative_divisor = scalar.constant -3 : i16
  %byte_input = scalar.trunci %input : i32 to i8
  %byte_divisor = scalar.trunci %divisor : i32 to i8
  %short_input = scalar.trunci %input : i32 to i16
  %short_divisor = scalar.trunci %divisor : i32 to i16
  %results = buffer.view %output[%origin] : buffer -> view<8xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0_i32 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1_i32 : i32
    %is_third = scalar.cmpi eq, %lane_i32, %c2_i32 : i32
    %byte_tail0 = scf.select %is_third, %byte_third, %byte_fourth : i8
    %byte_tail1 = scf.select %is_second, %byte_second, %byte_tail0 : i8
    %byte_value = scf.select %is_first, %byte_input, %byte_tail1 : i8
    %byte_divisor_tail0 = scf.select %is_third, %byte_negative_divisor, %byte_positive_divisor : i8
    %selected_byte_divisor = scf.select %is_first, %byte_divisor, %byte_divisor_tail0 : i8
    %byte_quotient = scalar.divsi %byte_value, %selected_byte_divisor : i8
    %byte_remainder = scalar.remsi %byte_value, %selected_byte_divisor : i8
    %byte_half = scalar.shrsi %byte_quotient, %c1_i8 : i8
    %byte_result = scalar.addi %byte_half, %byte_remainder : i8
    %byte_wide = scalar.extsi %byte_result : i8 to i32
    %short_tail0 = scf.select %is_third, %short_third, %short_fourth : i16
    %short_tail1 = scf.select %is_second, %short_second, %short_tail0 : i16
    %short_value = scf.select %is_first, %short_input, %short_tail1 : i16
    %short_divisor_tail0 = scf.select %is_third, %short_negative_divisor, %short_positive_divisor : i16
    %selected_short_divisor = scf.select %is_first, %short_divisor, %short_divisor_tail0 : i16
    %short_quotient = scalar.divsi %short_value, %selected_short_divisor : i16
    %short_remainder = scalar.remsi %short_value, %selected_short_divisor : i16
    %short_half = scalar.shrsi %short_quotient, %c1_i16 : i16
    %short_result = scalar.addi %short_half, %short_remainder : i16
    %short_wide = scalar.extsi %short_result : i16 to i32
    %short_index = index.add %short_base, %lane : index
    view.store %byte_wide, %results[%lane] : i32, view<8xi32>
    view.store %short_wide, %results[%short_index] : i32, view<8xi32>
  }
  func.return
}

func.def @vector_pair_observations(%first: i32, %second: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %bitcast_base = index.constant 4 : index
  %float_base = index.constant 8 : index
  %results = buffer.view %output[%origin] : buffer -> view<12xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %mask = func.call @vector_mask(%first, %second, %lane_i32) : (i32, i32, i32) -> (i32)
    %bitcast = func.call @vector_bitcast(%first, %second, %lane_i32) : (i32, i32, i32) -> (i32)
    %float = func.call @vector_float_ne(%first, %second, %lane_i32) : (i32, i32, i32) -> (i32)
    %bitcast_index = index.add %bitcast_base, %lane : index
    %float_index = index.add %float_base, %lane : index
    view.store %mask, %results[%lane] : i32, view<12xi32>
    view.store %bitcast, %results[%bitcast_index] : i32, view<12xi32>
    view.store %float, %results[%float_index] : i32, view<12xi32>
  }
  func.return
}

func.def @vector_pair_reference(%first: i32, %second: i32, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %bitcast_base = index.constant 4 : index
  %float_base = index.constant 8 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %word_high_bit = scalar.constant -2147483648 : i32
  %word_maximum = scalar.constant -1 : i32
  %signed_maximum = scalar.constant 2147483647 : i32
  %float_one_bits = scalar.constant 1065353216 : i32
  %quiet_nan_bits = scalar.constant 2143289344 : i32
  %results = buffer.view %output[%origin] : buffer -> view<12xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1 : i32
    %is_third = scalar.cmpi eq, %lane_i32, %c2 : i32
    %mask_first_tail0 = scf.select %is_third, %c0, %word_high_bit : i32
    %mask_first_tail1 = scf.select %is_second, %word_maximum, %mask_first_tail0 : i32
    %mask_first = scf.select %is_first, %first, %mask_first_tail1 : i32
    %mask_second_tail = scf.select %is_third, %c0, %signed_maximum : i32
    %mask_second_tail1 = scf.select %is_second, %c0, %mask_second_tail : i32
    %mask_second = scf.select %is_first, %second, %mask_second_tail1 : i32
    %mask_predicate = scalar.cmpi ugt, %mask_first, %mask_second : i32
    %mask = scalar.extsi %mask_predicate : i1 to i32
    %bitcast_tail0 = scf.select %is_third, %float_one_bits, %word_high_bit : i32
    %bitcast_tail1 = scf.select %is_second, %second, %bitcast_tail0 : i32
    %bitcast_bits = scf.select %is_first, %first, %bitcast_tail1 : i32
    %bitcast = scalar.xori %bitcast_bits, %word_high_bit : i32
    %float_first_tail0 = scf.select %is_third, %c0, %word_high_bit : i32
    %float_first_tail1 = scf.select %is_second, %quiet_nan_bits, %float_first_tail0 : i32
    %float_first_bits = scf.select %is_first, %first, %float_first_tail1 : i32
    %float_second_tail0 = scf.select %is_third, %word_high_bit, %c0 : i32
    %float_second_tail1 = scf.select %is_second, %float_one_bits, %float_second_tail0 : i32
    %float_second_bits = scf.select %is_first, %second, %float_second_tail1 : i32
    %float_first = scalar.bitcast %float_first_bits : i32 to f32
    %float_second = scalar.bitcast %float_second_bits : i32 to f32
    %float_predicate = scalar.cmpf une, %float_first, %float_second : f32
    %float = scalar.extsi %float_predicate : i1 to i32
    %bitcast_index = index.add %bitcast_base, %lane : index
    %float_index = index.add %float_base, %lane : index
    view.store %mask, %results[%lane] : i32, view<12xi32>
    view.store %bitcast, %results[%bitcast_index] : i32, view<12xi32>
    view.store %float, %results[%float_index] : i32, view<12xi32>
  }
  func.return
}

func.def @vector_control_oracle(%output: buffer, %input: i32, %count: i32) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c4 = scalar.constant 4 : i32
  %word_maximum = scalar.constant -1 : i32
  %invert = scalar.cmpi ugt, %count, %c2 : i32
  %offset = scalar.muli %count, %c4 : i32
  %results = buffer.view %output[%origin] : buffer -> view<4xi32>
  scf.for %lane = [%begin to %end step %step] {
    %lane_i32 = index.cast %lane : index to i32
    %is_first = scalar.cmpi eq, %lane_i32, %c0 : i32
    %is_second = scalar.cmpi eq, %lane_i32, %c1 : i32
    %tail = scf.select %is_second, %c1, %c0 : i32
    %initial = scf.select %is_first, %input, %tail : i32
    %advanced = scalar.addi %initial, %offset : i32
    %inverted = scalar.xori %advanced, %word_maximum : i32
    %value = scf.select %invert, %inverted, %advanced : i32
    view.store %value, %results[%lane] : i32, view<4xi32>
  }
  func.return
}

func.def @vector_masks_oracle(%input: buffer, %output: buffer) {
  %origin = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  %right_base = index.constant 4 : index
  %equal_base = index.constant 4 : index
  %zero_base = index.constant 8 : index
  %signed_base = index.constant 12 : index
  %float_base = index.constant 16 : index
  %c0 = scalar.constant 0 : i32
  %inputs = buffer.view %input[%origin] : buffer -> view<8xi32>
  %results = buffer.view %output[%origin] : buffer -> view<20xi32>
  scf.for %lane = [%begin to %end step %step] {
    %right_index = index.add %right_base, %lane : index
    %left = view.load %inputs[%lane] : view<8xi32> -> i32
    %right = view.load %inputs[%right_index] : view<8xi32> -> i32
    %unsigned_predicate = scalar.cmpi ult, %left, %right : i32
    %equal_predicate = scalar.cmpi eq, %left, %right : i32
    %zero_predicate = scalar.cmpi eq, %left, %c0 : i32
    %signed_predicate = scalar.cmpi slt, %left, %right : i32
    %left_float = scalar.bitcast %left : i32 to f32
    %right_float = scalar.bitcast %right : i32 to f32
    %float_predicate = scalar.cmpf une, %left_float, %right_float : f32
    %unsigned_result = scalar.extsi %unsigned_predicate : i1 to i32
    %equal_result = scalar.extsi %equal_predicate : i1 to i32
    %zero_result = scalar.extsi %zero_predicate : i1 to i32
    %signed_result = scalar.extsi %signed_predicate : i1 to i32
    %float_result = scalar.extsi %float_predicate : i1 to i32
    %equal_index = index.add %equal_base, %lane : index
    %zero_index = index.add %zero_base, %lane : index
    %signed_index = index.add %signed_base, %lane : index
    %float_index = index.add %float_base, %lane : index
    view.store %unsigned_result, %results[%lane] : i32, view<20xi32>
    view.store %equal_result, %results[%equal_index] : i32, view<20xi32>
    view.store %zero_result, %results[%zero_index] : i32, view<20xi32>
    view.store %signed_result, %results[%signed_index] : i32, view<20xi32>
    view.store %float_result, %results[%float_index] : i32, view<20xi32>
  }
  func.return
}

check.scenario @vector_values_functions {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %input = check.generate<@vector_unary_input>(%trial) : (index) -> (i32)
    %output = check.generate.fill value(-123) : tensor<32xi32>
    check.compare<@vector_unary_observations, @vector_unary_reference>(%input, %output) : (i32, tensor<32xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<32xi32>
    }
  }
  check.trial[10](%trial: index, %entropy: check.entropy) {
    %first, %second = check.generate<@vector_pair_input>(%trial) : (index) -> (i32, i32)
    %output = check.generate.fill value(-123) : tensor<12xi32>
    check.compare<@vector_pair_observations, @vector_pair_reference>(%first, %second, %output) : (i32, i32, tensor<12xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<12xi32>
    }
  }
  check.return
}

check.scenario @vector_values_signed_functions {
  check.trial[16](%trial: index, %entropy: check.entropy) {
    %input, %divisor = check.generate<@vector_signed_input>(%trial) : (index) -> (i32, i32)
    %output = check.generate.fill value(-123) : tensor<8xi32>
    check.compare<@vector_signed_observations, @vector_signed_reference>(%input, %divisor, %output) : (i32, i32, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi32>
    }
  }
  check.return
}

check.scenario @vector_value_kernels {
  check.trial[12](%trial: index, %entropy: check.entropy) {
    %input, %count = check.generate<@vector_control_config>(%trial) : (index) -> (i32, i32)
    %storage = check.generate.fill value(-123) : tensor<36xi32>
    %output = check.tensor.view %storage offset(64) : tensor<36xi32> -> tensor<4xi32>
    check.compare<@vector_control_kernel, @vector_control_oracle>(%output, %input, %count) : (tensor<4xi32>, i32, i32) -> () {
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<36xi32>
    }
  }
  check.trial[3](%trial: index, %entropy: check.entropy) {
    %input = check.generate.fill value(0) : tensor<8xi32>
    check.generate<@vector_mask_input>(%trial, %input) : (index, tensor<8xi32>) -> ()
    %storage = check.generate.fill value(-123) : tensor<52xi32>
    %output = check.tensor.view %storage offset(64) : tensor<52xi32> -> tensor<20xi32>
    check.compare<@vector_masks, @vector_masks_oracle>(%input, %output) : (tensor<8xi32>, tensor<20xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<52xi32>
    }
  }
  check.return
}
