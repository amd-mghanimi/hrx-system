// Vector widening consumes both halves of every packed source register. The
// scalar oracle loads each lane independently, so it cannot share the packed
// high-half selection used by the subject.
kernel.def @widen_packed_f16_lanes() {
  %unit = index.constant 1 : index
  %groups = index.constant 256 : index
  %threads = index.constant 32 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%threads, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %group = kernel.workgroup.id<x> : index
  %lane = kernel.workitem.id<x> : index
  %threads = index.constant 32 : index
  %packet_width = index.constant 8 : index
  %thread = index.madd %group, %threads, %lane : index
  %position = index.mul %thread, %packet_width : index
  %source = buffer.view %input[%base] : buffer -> view<65536xf16>
  %destination = buffer.view %output[%base] : buffer -> view<65536xf32>
  %packed = vector.load %source[%position] : view<65536xf16> -> vector<8xf16>
  %wide = vector.extf %packed : vector<8xf16> to vector<8xf32>
  vector.store %wide, %destination[%position] : vector<8xf32>, view<65536xf32>
  kernel.return
}

func.def @widen_f16_lanes_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 65536 : index
  %step = index.constant 1 : index
  %source = buffer.view %input[%base] : buffer -> view<65536xf16>
  %destination = buffer.view %output[%base] : buffer -> view<65536xf32>
  scf.for %i = [%begin to %end step %step] {
    %narrow = view.load %source[%i] : view<65536xf16> -> f16
    %wide = scalar.extf %narrow : f16 to f32
    view.store %wide, %destination[%i] : f32, view<65536xf32>
  }
  func.return
}

check.scenario @packed_f16_widening_all_bits {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-32768) step(1) : tensor<65536xi16>
    %output = check.generate.fill value(-123.5) : tensor<65536xf32>
    check.compare<@widen_packed_f16_lanes, @widen_f16_lanes_oracle>(%input, %output) : (tensor<65536xi16>, tensor<65536xf32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<65536xi16>
      // Widening is exact for every numeric value. NaN sign and payload
      // canonicalization are not part of the floating conversion contract.
      check.expect.close actual(%output) expected(%output) atol(0.0) rtol(0.0) nan(same) : tensor<65536xf32>
    }
  }
  check.return
}
