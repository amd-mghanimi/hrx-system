// Observe byte offsets as full-width integers without dereferencing a large
// allocation. Element addition wraps at 32 bits before signed and unsigned
// interpretations widen for byte scaling.
func.def device inline @evaluate_scaled_offsets(%base: i32, %stride: offset, %output: buffer, %lane: index) {
  %lane_bits = index.cast %lane : index to i32
  %wrapped = scalar.addi %base, %lane_bits : i32
  %unsigned = index.cast %wrapped : i32 to offset
  %element = index.cast %unsigned : offset to index
  %bytes = index.scale %element, %stride : index, offset -> offset
  %value = index.cast %bytes : offset to i64
  %signed_element = index.cast %wrapped : i32 to index
  %signed_bytes = index.scale %signed_element, %stride : index, offset -> offset
  %signed_value = index.cast %signed_bytes : offset to i64
  %buffer_base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 8} : buffer
  %view = buffer.view %aligned[%buffer_base] : buffer -> view<2x4xi64>
  view.store %value, %view[0, %lane] : i64, view<2x4xi64>
  view.store %signed_value, %view[1, %lane] : i64, view<2x4xi64>
  func.return
}

kernel.def @scale_unsigned_offsets() {
  %unit = index.constant 1 : index
  %lanes = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%base: i32, %stride: offset, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_scaled_offsets(%base, %stride, %output, %lane) : (i32, offset, buffer, index)
  kernel.return
}

func.def @scale_unsigned_offsets_oracle(%base: i32, %stride: offset, %output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_scaled_offsets(%base, %stride, %output, %lane) : (i32, offset, buffer, index)
  }
  func.return
}

check.scenario @scaled_offset_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %base = check.literal value(1073741823) : i32
    %stride = check.literal value(4) : offset
    %output = check.generate.fill value(-1) : tensor<8xi64>
    check.compare<@scale_unsigned_offsets, @scale_unsigned_offsets_oracle>(%base, %stride, %output) : (i32, offset, tensor<8xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %base = check.literal value(-2) : i32
    %stride = check.literal value(12) : offset
    %output = check.generate.fill value(-1) : tensor<8xi64>
    check.compare<@scale_unsigned_offsets, @scale_unsigned_offsets_oracle>(%base, %stride, %output) : (i32, offset, tensor<8xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %base = check.literal value(1) : i32
    %stride = check.literal value(4294967300) : offset
    %output = check.generate.fill value(-1) : tensor<8xi64>
    check.compare<@scale_unsigned_offsets, @scale_unsigned_offsets_oracle>(%base, %stride, %output) : (i32, offset, tensor<8xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %base = check.literal value(2147483646) : i32
    %stride = check.literal value(4) : offset
    %output = check.generate.fill value(-1) : tensor<8xi64>
    check.compare<@scale_unsigned_offsets, @scale_unsigned_offsets_oracle>(%base, %stride, %output) : (i32, offset, tensor<8xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<8xi64>
    }
  }
  check.return
}

// A bounded coordinate keeps its narrow carrier while constant byte strides
// produce full-width offsets. The packed load also exercises lane extraction.
func.def device inline @evaluate_bounded_scaled_offsets(%input: buffer, %output: buffer, %lane: index) {
  %base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %input {minimum_alignment = 16} : buffer
  %source = buffer.view %aligned[%base] : buffer -> view<4xi32>
  %packed = vector.load %source[0] : view<4xi32> -> vector<4xi32>
  %raw = vector.extract %packed[%lane] : vector<4xi32> -> i32
  %mask = scalar.constant 1023 : i32
  %low = scalar.andi %raw, %mask : i32
  %coordinate = index.cast %low : i32 to index
  %bounded = index.assume %coordinate [range(%coordinate, 0, 1023)] : index
  %word = index.constant 4 : offset
  %wide = index.constant 4294967296 : offset
  %small_bytes = index.scale %bounded, %word : index, offset -> offset
  %large_bytes = index.scale %bounded, %wide : index, offset -> offset
  %small_value = index.cast %small_bytes : offset to i64
  %large_value = index.cast %large_bytes : offset to i64
  %destination_base = index.constant 32 : offset
  %destination = buffer.view %output[%destination_base] : buffer -> view<2x4xi64>
  view.store %small_value, %destination[0, %lane] : i64, view<2x4xi64>
  view.store %large_value, %destination[1, %lane] : i64, view<2x4xi64>
  func.return
}

kernel.def @scale_bounded_offsets() {
  %unit = index.constant 1 : index
  %lanes = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_bounded_scaled_offsets(%input, %output, %lane) : (buffer, buffer, index)
  kernel.return
}

func.def @scale_bounded_offsets_oracle(%input: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_bounded_scaled_offsets(%input, %output, %lane) : (buffer, buffer, index)
  }
  func.return
}

check.scenario @bounded_scaled_offset_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-4) step(1) : tensor<4xi32>
    %output = check.generate.fill value(-123) : tensor<16xi64>
    check.compare<@scale_bounded_offsets, @scale_bounded_offsets_oracle>(%input, %output) : (tensor<4xi32>, tensor<16xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<4xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xi64>
    }
  }
  check.return
}

// Uniform wide scaling joins a narrow lane value before a loop transports and
// updates the complete pair. A final subtraction exercises low-word borrow.
func.def device inline @evaluate_walked_scaled_offset(%start_input: index, %stride: offset, %count: index, %choice: i32, %output: buffer, %lane: index) {
  %start = index.assume %start_input [range(%start_input, 0, 2147483647)] : index
  %wide = index.scale %start, %stride : index, offset -> offset
  %narrow = index.cast %lane : index to offset
  %inactive = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %inactive : i32
  %initial = scf.if %condition -> (offset) {
    scf.yield %wide : offset
  } else {
    scf.yield %narrow : offset
  }
  %begin = index.constant 0 : index
  %step = index.constant 1 : index
  %final = scf.for %iteration = [%begin to %count step %step](%current = %initial : offset) -> (offset) {
    %next = index.add %current, %stride : offset
    scf.yield %next : offset
  }
  %word = index.constant 4 : offset
  %adjusted = index.sub %final, %word : offset
  %value = index.cast %adjusted : offset to i64
  %buffer_base = index.constant 0 : offset
  %aligned = buffer.assume.alignment %output {minimum_alignment = 8} : buffer
  %view = buffer.view %aligned[%buffer_base] : buffer -> view<4xi64>
  view.store %value, %view[%lane] : i64, view<4xi64>
  func.return
}

kernel.def @walk_scaled_offsets() {
  %unit = index.constant 1 : index
  %lanes = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%lanes, %unit, %unit) : index
} launch(%start: index, %stride: offset, %count: index, %choice: i32, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_walked_scaled_offset(%start, %stride, %count, %choice, %output, %lane) : (index, offset, index, i32, buffer, index)
  kernel.return
}

func.def @walk_scaled_offsets_oracle(%start: index, %stride: offset, %count: index, %choice: i32, %output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_walked_scaled_offset(%start, %stride, %count, %choice, %output, %lane) : (index, offset, index, i32, buffer, index)
  }
  func.return
}

check.scenario @walked_scaled_offset_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(2) : index
    %stride = check.literal value(4294967300) : offset
    %count = check.literal value(0) : index
    %choice = check.literal value(1) : i32
    %output = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@walk_scaled_offsets, @walk_scaled_offsets_oracle>(%start, %stride, %count, %choice, %output) : (index, offset, index, i32, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(1073741823) : index
    %stride = check.literal value(4) : offset
    %count = check.literal value(2) : index
    %choice = check.literal value(1) : i32
    %output = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@walk_scaled_offsets, @walk_scaled_offsets_oracle>(%start, %stride, %count, %choice, %output) : (index, offset, index, i32, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %start = check.literal value(1) : index
    %stride = check.literal value(4294967296) : offset
    %count = check.literal value(3) : index
    %choice = check.literal value(0) : i32
    %output = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@walk_scaled_offsets, @walk_scaled_offsets_oracle>(%start, %stride, %count, %choice, %output) : (index, offset, index, i32, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi64>
    }
  }
  check.return
}

// A wide positive sum still needs the negative narrow operand sign-extended.
func.def device inline @evaluate_signed_wide_sum(%input: buffer, %output: buffer, %lane: index) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<256xi32>
  %destination = buffer.view %output[%base] : buffer -> view<256xi64>
  %raw = view.load %source[%lane] : view<256xi32> -> i32
  %signed = scalar.assume %raw [range(%raw, -128, 127)] : i32
  %coordinate = index.cast %signed : i32 to index
  %bias = index.constant 4294967296 : index
  %sum = index.add %coordinate, %bias : index
  %value = index.cast %sum : index to i64
  view.store %value, %destination[%lane] : i64, view<256xi64>
  func.return
}

kernel.def @signed_wide_sum() {
  %unit = index.constant 1 : index
  %width = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_signed_wide_sum(%input, %output, %lane) : (buffer, buffer, index)
  kernel.return
}

func.def @signed_wide_sum_oracle(%input: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_signed_wide_sum(%input, %output, %lane) : (buffer, buffer, index)
  }
  func.return
}

check.scenario @signed_wide_sum_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi32>
    %output = check.generate.fill value(-1) : tensor<256xi64>
    check.compare<@signed_wide_sum, @signed_wide_sum_oracle>(%input, %output) : (tensor<256xi32>, tensor<256xi64>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<256xi64>
    }
  }
  check.return
}
