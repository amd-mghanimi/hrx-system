config.decl @delta : i32

kernel.def @add() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch(%storage: buffer, %delta: i32) {
  %c0 = index.constant 0 : offset
  %element = kernel.workitem.id<x> : index
  %view = buffer.view %storage[%c0] : buffer -> view<8xi32>
  %value = view.load %view[%element] : view<8xi32> -> i32
  %next = scalar.addi %value, %delta : i32
  view.store %next, %view[%element] : i32, view<8xi32>
  kernel.return
}

command.program.def public @add_configured() launch(%storage: buffer) {
  %delta = config.get @delta : i32
  kernel.launch @add(%storage, %delta) : (buffer, i32)
  command.return
}

kernel.def @consume() {
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c8, %c1, %c1) : index
} launch(%a: view<8xi32>, %b: view<8xi32>, %raw: view<8xi32>, %output: buffer) {
  %c0 = index.constant 0 : offset
  %element = kernel.workitem.id<x> : index
  %output_view = buffer.view %output[%c0] : buffer -> view<8xi32>
  %av = view.load %a[%element] : view<8xi32> -> i32
  // An authored check requires device feedback without sanitizer insertion.
  %c0_i32 = scalar.constant 0 : i32
  %nonnegative = scalar.cmpi sge, %av, %c0_i32 : i32
  kernel.assert %nonnegative "prepared parameter must be nonnegative" : i1
  %bv = view.load %b[%element] : view<8xi32> -> i32
  %rv = view.load %raw[%element] : view<8xi32> -> i32
  %ab = scalar.addi %av, %bv : i32
  %sum = scalar.addi %ab, %rv : i32
  view.store %sum, %output_view[%element] : i32, view<8xi32>
  kernel.return
}

command.program.def public @target() launch(%weights: buffer, %output: buffer) {
  %a = command.parameter %weights, "a" : view<8xi32>
  %b = command.parameter %weights, "b" : view<8xi32>
  %raw = command.parameter %weights, "raw" : view<8xi32>
  kernel.launch @consume(%a, %b, %raw, %output) : (view<8xi32>, view<8xi32>, view<8xi32>, buffer)
  command.return
}

