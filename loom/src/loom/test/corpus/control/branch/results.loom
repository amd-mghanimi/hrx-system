// Nested guards share a value-forwarding path while restoring each parent mask.
kernel.def @conditional_results() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %length: index, %lower: i32, %upper: i32) {
  %lane = kernel.workitem.id<x> : index
  %stride = index.constant 4 : offset
  %offset = index.scale %lane, %stride : index, offset -> offset
  %out = buffer.view %output[%offset] : buffer -> view<129xi32>
  %completed = scalar.constant 1 : i32
  %active = index.cmp ult, %lane, %length : index
  cfg.cond_br %active, ^guard, ^after
^guard:
  %in = buffer.view %input[%offset] : buffer -> view<1xi32>
  %value = view.load %in[0] : view<1xi32> -> i32
  %complement_base = scalar.constant -3 : i32
  %other = scalar.subi %complement_base, %value : i32
  %state = vector.from_elements %value, %other : vector<2xi32>
  %after_lower = scalar.cmpi sge, %value, %lower : i32
  %before_upper = scalar.cmpi slt, %value, %upper : i32
  cfg.cond_br %after_lower, ^inner, ^fallback
^inner:
  cfg.cond_br %before_upper, ^inside, ^fallback
^inside:
  %inside_value = scalar.addi %value, %upper : i32
  %updated = vector.insert %inside_value into %state[0] : i32, vector<2xi32>
  cfg.br ^join(%updated: vector<2xi32>)
^fallback:
  cfg.br ^join(%state: vector<2xi32>)
^join(%result: vector<2xi32>):
  %first = vector.extract %result[0] : vector<2xi32> -> i32
  %second = vector.extract %result[1] : vector<2xi32> -> i32
  view.store %first, %out[0] : i32, view<129xi32>
  view.store %second, %out[64] : i32, view<129xi32>
  cfg.br ^after
^after:
  view.store %completed, %out[128] : i32, view<129xi32>
  kernel.return
}

func.def @conditional_results_oracle(%input: buffer, %output: buffer, %length: index, %lower: i32, %upper: i32) {
  %begin = index.constant 0 : index
  %width = index.constant 64 : index
  %step = index.constant 1 : index
  %stride = index.constant 4 : offset
  %completed = scalar.constant 1 : i32
  scf.for %lane = [%begin to %width step %step] {
    %offset = index.scale %lane, %stride : index, offset -> offset
    %out = buffer.view %output[%offset] : buffer -> view<129xi32>
    %active = index.cmp ult, %lane, %length : index
    scf.if %active {
      %in = buffer.view %input[%offset] : buffer -> view<1xi32>
      %value = view.load %in[0] : view<1xi32> -> i32
      %complement_base = scalar.constant -3 : i32
      %other = scalar.subi %complement_base, %value : i32
      %after_lower = scalar.cmpi sge, %value, %lower : i32
      %before_upper = scalar.cmpi slt, %value, %upper : i32
      %inside = scalar.andi %after_lower, %before_upper : i1
      %inside_value = scalar.addi %value, %upper : i32
      %first = scf.select %inside, %inside_value, %value : i32
      view.store %first, %out[0] : i32, view<129xi32>
      view.store %other, %out[64] : i32, view<129xi32>
    }
    view.store %completed, %out[128] : i32, view<129xi32>
  }
  func.return
}

check.scenario @conditional_result_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(0) : index
    %lower = check.literal value(16) : i32
    %upper = check.literal value(48) : i32
    %input = check.generate.iota offset(0) step(1) : tensor<1xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@conditional_results, @conditional_results_oracle>(%input, %output, %length, %lower, %upper) : (tensor<1xi32>, tensor<192xi32>, index, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(1) : index
    %lower = check.literal value(0) : i32
    %upper = check.literal value(1) : i32
    %input = check.generate.iota offset(0) step(1) : tensor<1xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@conditional_results, @conditional_results_oracle>(%input, %output, %length, %lower, %upper) : (tensor<1xi32>, tensor<192xi32>, index, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(37) : index
    %lower = check.literal value(16) : i32
    %upper = check.literal value(35) : i32
    %input = check.generate.iota offset(0) step(1) : tensor<37xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@conditional_results, @conditional_results_oracle>(%input, %output, %length, %lower, %upper) : (tensor<37xi32>, tensor<192xi32>, index, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<37xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(64) : index
    %lower = check.literal value(16) : i32
    %upper = check.literal value(48) : i32
    %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@conditional_results, @conditional_results_oracle>(%input, %output, %length, %lower, %upper) : (tensor<64xi32>, tensor<192xi32>, index, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(64) : index
    %lower = check.literal value(64) : i32
    %upper = check.literal value(80) : i32
    %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@conditional_results, @conditional_results_oracle>(%input, %output, %length, %lower, %upper) : (tensor<64xi32>, tensor<192xi32>, index, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(64) : index
    %lower = check.literal value(0) : i32
    %upper = check.literal value(0) : i32
    %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@conditional_results, @conditional_results_oracle>(%input, %output, %length, %lower, %upper) : (tensor<64xi32>, tensor<192xi32>, index, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(64) : index
    %lower = check.literal value(0) : i32
    %upper = check.literal value(64) : i32
    %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@conditional_results, @conditional_results_oracle>(%input, %output, %length, %lower, %upper) : (tensor<64xi32>, tensor<192xi32>, index, i32, i32) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.return
}
