// Short-circuit effects and scalar live-ins share convergence.

kernel.def @short_circuit_and_or() {
  %unit = index.constant 1 : index
  %width = index.constant 64 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer, %length: index) {
  %lane = kernel.workitem.id<x> : index
  %stride = index.constant 4 : offset
  %offset = index.scale %lane, %stride : index, offset -> offset
  %out = buffer.view %output[%offset] : buffer -> view<129xi32>
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %c10 = scalar.constant 10 : i32
  %active = index.cmp ult, %lane, %length : index
  cfg.cond_br %active, ^a, ^after
^a:
  %in = buffer.view %input[%offset] : buffer -> view<1xi32>
  %value = view.load %in[0] : view<1xi32> -> i32
  view.store %c1, %out[0] : i32, view<129xi32>
  %pattern = scalar.shrui %value, %c3 : i32
  %a_bit = scalar.andi %pattern, %c1 : i32
  %a = scalar.cmpi ne, %a_bit, %c0 : i32
  cfg.cond_br %a, ^b, ^c
^b:
  %trace_b = view.load %out[0] : view<129xi32> -> i32
  %scaled_b = scalar.muli %trace_b, %c10 : i32
  %record_b = scalar.addi %scaled_b, %c2 : i32
  view.store %record_b, %out[0] : i32, view<129xi32>
  %b_bit = scalar.andi %pattern, %c2 : i32
  %b = scalar.cmpi ne, %b_bit, %c0 : i32
  cfg.cond_br %b, ^short, ^c
^short:
  %short_result = scalar.constant true : i1
  cfg.br ^merge(%short_result: i1)
^c:
  %trace_c = view.load %out[0] : view<129xi32> -> i32
  %scaled_c = scalar.muli %trace_c, %c10 : i32
  %record_c = scalar.addi %scaled_c, %c3 : i32
  view.store %record_c, %out[0] : i32, view<129xi32>
  %c_value = view.load %in[0] : view<1xi32> -> i32
  %last_pattern = scalar.shrui %c_value, %c3 : i32
  %c_bit = scalar.andi %last_pattern, %c4 : i32
  %c = scalar.cmpi ne, %c_bit, %c0 : i32
  cfg.br ^merge(%c: i1)
^merge(%result: i1):
  %result_integer = scf.select %result, %c1, %c0 : i32
  view.store %result_integer, %out[64] : i32, view<129xi32>
  cfg.br ^after
^after:
  view.store %c1, %out[128] : i32, view<129xi32>
  kernel.return
}

func.def inline @short_circuit_and_or_lane_oracle(%value: i32) -> (i32, i32) {
  %c0 = scalar.constant 0 : i32
  %c1 = scalar.constant 1 : i32
  %c2 = scalar.constant 2 : i32
  %c3 = scalar.constant 3 : i32
  %c4 = scalar.constant 4 : i32
  %pattern = scalar.shrui %value, %c3 : i32
  %a_bit = scalar.andi %pattern, %c1 : i32
  %a = scalar.cmpi ne, %a_bit, %c0 : i32
  %trace, %result = scf.if %a -> (i32, i32) {
    %b_bit = scalar.andi %pattern, %c2 : i32
    %b = scalar.cmpi ne, %b_bit, %c0 : i32
    %inner_trace, %inner_result = scf.if %b -> (i32, i32) {
      %short_trace = scalar.constant 12 : i32
      scf.yield %short_trace, %c1 : i32, i32
    } else {
      %c_bit = scalar.andi %pattern, %c4 : i32
      %c = scalar.cmpi ne, %c_bit, %c0 : i32
      %continued_trace = scalar.constant 123 : i32
      %continued_result = scf.select %c, %c1, %c0 : i32
      scf.yield %continued_trace, %continued_result : i32, i32
    }
    scf.yield %inner_trace, %inner_result : i32, i32
  } else {
    %c_bit = scalar.andi %pattern, %c4 : i32
    %c = scalar.cmpi ne, %c_bit, %c0 : i32
    %fallback_trace = scalar.constant 13 : i32
    %fallback_result = scf.select %c, %c1, %c0 : i32
    scf.yield %fallback_trace, %fallback_result : i32, i32
  }
  func.return %trace, %result : i32, i32
}

func.def @short_circuit_and_or_oracle(%input: buffer, %output: buffer, %length: index) {
  %begin = index.constant 0 : index
  %width = index.constant 64 : index
  %step = index.constant 1 : index
  %stride = index.constant 4 : offset
  %completed = scalar.constant 1 : i32
  scf.for %lane = [%begin to %width step %step] {
    %offset = index.scale %lane, %stride : index, offset -> offset
    %out = buffer.view %output[%offset] : buffer -> view<129xi32>
    %active = index.cmp ult, %lane, %length : index
    scf.if %active {
      %in = buffer.view %input[%offset] : buffer -> view<1xi32>
      %value = view.load %in[0] : view<1xi32> -> i32
      %trace, %result = func.call @short_circuit_and_or_lane_oracle(%value) : (i32) -> (i32, i32)
      view.store %trace, %out[0] : i32, view<129xi32>
      view.store %result, %out[64] : i32, view<129xi32>
    }
    view.store %completed, %out[128] : i32, view<129xi32>
  }
  func.return
}

check.scenario @short_circuit_and_or_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(0) : index
    %input = check.generate.iota offset(0) step(1) : tensor<1xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@short_circuit_and_or, @short_circuit_and_or_oracle>(%input, %output, %length) : (tensor<1xi32>, tensor<192xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(1) : index
    %input = check.generate.iota offset(0) step(1) : tensor<1xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@short_circuit_and_or, @short_circuit_and_or_oracle>(%input, %output, %length) : (tensor<1xi32>, tensor<192xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<1xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(31) : index
    %input = check.generate.iota offset(0) step(1) : tensor<31xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@short_circuit_and_or, @short_circuit_and_or_oracle>(%input, %output, %length) : (tensor<31xi32>, tensor<192xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<31xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(37) : index
    %input = check.generate.iota offset(0) step(1) : tensor<37xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@short_circuit_and_or, @short_circuit_and_or_oracle>(%input, %output, %length) : (tensor<37xi32>, tensor<192xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<37xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %length = check.literal value(64) : index
    %input = check.generate.iota offset(0) step(1) : tensor<64xi32>
    %storage = check.generate.fill value(-99) : tensor<224xi32>
    %output = check.tensor.view %storage offset(64) : tensor<224xi32> -> tensor<192xi32>
    check.compare<@short_circuit_and_or, @short_circuit_and_or_oracle>(%input, %output, %length) : (tensor<64xi32>, tensor<192xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<64xi32>
      check.expect.bitwise actual(%storage) expected(%storage) : tensor<224xi32>
    }
  }
  check.return
}

