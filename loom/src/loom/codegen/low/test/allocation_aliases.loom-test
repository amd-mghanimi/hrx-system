// Non-writing identities share their original storage even when every name
// remains live. Each name is published without acquiring another register bank.
// RUN: emit low-allocation-query @live_identity_chain values=%source,%first_identity,%second_identity

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @live_identity_chain(%source: reg<test.i32 x4>) -> (reg<test.i32 x4>, reg<test.i32 x4>, reg<test.i32 x4>) asm {
  %first_identity = low.assume %source [range(%source, 0, 1024)] : reg<test.i32 x4>
  %second_identity = low.assume %first_identity [range(%first_identity, 0, 1024)] : reg<test.i32 x4>
  return %source, %first_identity, %second_identity
}

// ----
value %source: test.i32 -> target_id[0:4]
value %first_identity: test.i32 -> target_id[0:4]
value %second_identity: test.i32 -> target_id[0:4]

// ====

// RUN: emit low-allocation-query @copy_input_at_early_tie values=%source,%copy,%result copies=%copy

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @copy_input_at_early_tie(%source: reg<test.i32 x8>) -> (reg<test.i32 x8>) asm {
  %copy = copy %source : reg<test.i32 x8> -> reg<test.i32 x8>
  %result = test.accumulate.v8i32 %source, %source, %copy
  return %result
}

// ----
value %source: test.i32 -> target_id[0:8]
value %copy: test.i32 -> target_id[8:8]
value %result: test.i32 -> target_id[8:8]
copy %source -> %copy: materialized

// ====

// RUN: emit low-allocation-query @copied_fact_alias_at_early_tie values=%source,%copy,%alias,%result copies=%copy

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @copied_fact_alias_at_early_tie(%source: reg<test.i32 x8>) -> (reg<test.i32 x8>) asm {
  %copy = copy %source : reg<test.i32 x8> -> reg<test.i32 x8>
  %alias = low.assume %copy [range(%copy, 0, 1024)] : reg<test.i32 x8>
  %result = test.accumulate.v8i32 %source, %source, %alias
  return %result
}

// ----
value %source: test.i32 -> target_id[0:8]
value %copy: test.i32 -> target_id[8:8]
value %alias: test.i32 -> target_id[8:8]
value %result: test.i32 -> target_id[8:8]
copy %source -> %copy: materialized

// ====

// RUN: emit low-allocation-query @fact_aliased_input_at_early_tie values=%source,%alias,%copy,%result copies=%copy

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @fact_aliased_input_at_early_tie(%source: reg<test.i32 x8>) -> (reg<test.i32 x8>) asm {
  %alias = low.assume %source [range(%source, 0, 1024)] : reg<test.i32 x8>
  %copy = copy %alias : reg<test.i32 x8> -> reg<test.i32 x8>
  %result = test.accumulate.v8i32 %source, %alias, %copy
  return %result
}

// ----
value %source: test.i32 -> target_id[0:8]
value %alias: test.i32 -> target_id[0:8]
value %copy: test.i32 -> target_id[8:8]
value %result: test.i32 -> target_id[8:8]
copy %alias -> %copy: materialized

// ====

// A slice establishes an alias without reading the producer. Retain the
// producer's storage and defer the loop-state handoff to the backedge.
// RUN: emit low-allocation-query @slice_keeps_source_before_backedge values=%state,%fresh,%part fixed=%state:target_id:0:1 fixed=%fresh:target_id:8:4

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @slice_keeps_source_before_backedge(%condition: reg<test.i32>, %initial: reg<test.i32>, %input: reg<test.i32 x4>) asm {
  low.br ^loop(%initial: reg<test.i32>)
^loop(%state: reg<test.i32>):
  %consumed = test.add.i32 %state, %condition
  %fresh = test.add.v4i32 %input, %input
  %part = slice %fresh[1] : reg<test.i32 x4> -> reg<test.i32>
  low.cond_br %condition, ^repeat, ^exit : reg<test.i32>
^repeat:
  low.br ^loop(%part: reg<test.i32>)
^exit:
  return
}

// ----
value %state: test.i32 -> target_id[0:1]
value %fresh: test.i32 -> target_id[8:4]
value %part: test.i32 -> target_id[9:1]

// ====

// RUN: emit low-allocation-query @copy_keeps_source_before_backedge values=%state,%fresh,%next copies=%next fixed=%state:target_id:0:1 fixed=%fresh:target_id:8:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @copy_keeps_source_before_backedge(%condition: reg<test.i32>, %initial: reg<test.i32>) asm {
  low.br ^loop(%initial: reg<test.i32>)
^loop(%state: reg<test.i32>):
  %fresh = test.add.i32 %state, %condition
  %next = copy %fresh : reg<test.i32> -> reg<test.i32>
  low.br ^loop(%next: reg<test.i32>)
}

// ----
value %state: test.i32 -> target_id[0:1]
value %fresh: test.i32 -> target_id[8:1]
value %next: test.i32 -> target_id[8:1]
copy %fresh -> %next: coalesced

// ====

// RUN: emit low-allocation-query @move_keeps_source_before_backedge values=%state,%fresh,%next fixed=%state:target_id:0:1 fixed=%fresh:target_id:8:1

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @move_keeps_source_before_backedge(%condition: reg<test.i32>, %initial: reg<test.i32>) asm {
  low.br ^loop(%initial: reg<test.i32>)
^loop(%state: reg<test.i32>):
  %fresh = test.add.i32 %state, %condition
  %next = move %fresh : reg<test.i32> -> reg<test.i32>
  low.br ^loop(%next: reg<test.i32>)
}

// ----
value %state: test.i32 -> target_id[0:1]
value %fresh: test.i32 -> target_id[8:1]
value %next: test.i32 -> target_id[8:1]
