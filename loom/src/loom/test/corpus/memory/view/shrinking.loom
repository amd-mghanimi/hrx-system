// Crop one row from a strided view on each iteration. Check the data loaded
// through the changing body extent and the final view, including an empty loop.
kernel.def @shrinking_view() {
  %c1 = index.constant 1 : index
  kernel.launch.config workgroups(%c1, %c1, %c1) workgroup_size(%c1, %c1, %c1) : index
} launch(%input: buffer, %output: buffer, %count: index) {
  func.call @compute_shrinking_view(%input, %output, %count) : (buffer, buffer, index)
  kernel.return
}

func.def device inline @compute_shrinking_view(%input: buffer, %output: buffer, %count: index) {
  %iterations = index.assume %count [range(%count, 0, 3)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %initial_rows = index.constant 8 : index
  %base = index.constant 4 : offset
  %input_aligned = buffer.assume.alignment %input {minimum_alignment = 4} : buffer
  %output_aligned = buffer.assume.alignment %output {minimum_alignment = 4} : buffer
  %initial_layout = encoding.layout.strided [8, 1] : encoding<layout>
  %initial_view = buffer.view %input_aligned[%base] : buffer -> view<[%initial_rows]x4xi32, %initial_layout>
  %destination = buffer.view %output_aligned[%base] : buffer -> view<2xi32>
  %c0_i32 = scalar.constant 0 : i32
  %rows, %layout, %view, %sum = scf.for %i = [%c0 to %iterations step %c1](%carried_rows = %initial_rows : index, %carried_layout = %initial_layout : encoding<layout>, %carried_view = %initial_view : view<[%initial_rows]x4xi32, %initial_layout>, %total = %c0_i32 : i32) -> (index, encoding<layout>, view<[%rows]x4xi32, %layout>, i32) {
    %has_row = index.cmp sgt, %carried_rows, %c0 : index
    %value = scf.if %has_row -> (i32) {
      %loaded = view.load %carried_view[0, 1] : view<[%carried_rows]x4xi32, %carried_layout> -> i32
      scf.yield %loaded : i32
    } else {
      scf.yield %c0_i32 : i32
    }
    %next_sum = scalar.addi %total, %value : i32
    %next_rows = index.sub %carried_rows, %c1 : index
    %next_view = view.subview %carried_view[1, 0] : view<[%carried_rows]x4xi32, %carried_layout> -> view<[%next_rows]x4xi32, %carried_layout>
    scf.yield %next_rows, %carried_layout, %next_view, %next_sum : index, encoding<layout>, view<[%next_rows]x4xi32, %carried_layout>, i32
  }
  %has_final = index.cmp sgt, %rows, %c0 : index
  %final = scf.if %has_final -> (i32) {
    %loaded = view.load %view[0, 1] : view<[%rows]x4xi32, %layout> -> i32
    scf.yield %loaded : i32
  } else {
    scf.yield %c0_i32 : i32
  }
  view.store %sum, %destination[0] : i32, view<2xi32>
  view.store %final, %destination[1] : i32, view<2xi32>
  func.return
}

func.def @shrinking_view_oracle(%input: buffer, %output: buffer, %count: index) {
  func.call @compute_shrinking_view(%input, %output, %count) : (buffer, buffer, index)
  func.return
}

check.scenario @shrinking_view_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(0) : index
    %input = check.generate.iota offset(100) step(1) : tensor<68xi32>
    %output = check.generate.fill value(-99) : tensor<4xi32>
    check.compare<@shrinking_view, @shrinking_view_oracle>(%input, %output, %count) : (tensor<68xi32>, tensor<4xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<68xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(1) : index
    %input = check.generate.iota offset(100) step(1) : tensor<68xi32>
    %output = check.generate.fill value(-99) : tensor<4xi32>
    check.compare<@shrinking_view, @shrinking_view_oracle>(%input, %output, %count) : (tensor<68xi32>, tensor<4xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<68xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %count = check.literal value(3) : index
    %input = check.generate.iota offset(100) step(1) : tensor<68xi32>
    %output = check.generate.fill value(-99) : tensor<4xi32>
    check.compare<@shrinking_view, @shrinking_view_oracle>(%input, %output, %count) : (tensor<68xi32>, tensor<4xi32>, index) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<68xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}
