// RUN: verify

// Projected region args are parser-owned clones of the function signature and
// verify without spelling a second argument list.
test.split_func @projected(%arg: i32, %other: i32) {
  test.yield
} launch {
  test.yield
}

// ====

// Moved results invalidate their source in the ordinary verifier. This is a
// core SSA lifetime rule, not an ownership-lifetime pass convention.
func.def @reject_move_source_reuse(%size: index) {
  %resource = test.resource.alloc %size : index -> pool
  %moved = test.resource.move %resource : pool -> pool
  // ERROR@+1: DOMINANCE/002 {value_name="resource"}
  test.resource.borrow %resource : pool
  test.resource.release %moved : pool
  func.return
}
