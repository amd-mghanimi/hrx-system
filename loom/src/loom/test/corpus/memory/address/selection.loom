// Both uniform and per-workitem choices retain the complete byte offset.
// The narrow alternative is proven to fit in one register; the wide alternative
// requires both words. Outputs observe the chosen numeric address directly.
func.def device inline @compute_wide_offset_selection(%wide_input: i64, %narrow_input: i64, %choice: i32, %lane: index) -> (i64, i64) {
  %wide_bits = scalar.assume %wide_input [range(%wide_input, 0, 9223372036854775807)] : i64
  %wide = index.cast %wide_bits : i64 to offset
  %narrow_bits = scalar.assume %narrow_input [range(%narrow_input, 0, 4294967295)] : i64
  %narrow = index.cast %narrow_bits : i64 to offset
  %false_selector = scalar.constant 0 : i32
  %condition = scalar.cmpi ne, %choice, %false_selector : i32
  %selected = scf.select %condition, %wide, %narrow : offset
  %uniform_value = index.cast %selected : offset to i64
  %split = index.constant 2 : index
  %lane_condition = index.cmp slt, %lane, %split : index
  %lane_offset = index.cast %lane : index to offset
  %lane_selected = scf.select %lane_condition, %wide, %lane_offset : offset
  %varying_value = index.cast %lane_selected : offset to i64
  func.return %uniform_value, %varying_value : i64, i64
}

kernel.def @select_wide_offsets() {
  %unit = index.constant 1 : index
  %width = index.constant 4 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%wide_input: i64, %narrow_input: i64, %choice: i32, %uniform_output: buffer, %varying_output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %uniform_value, %varying_value = func.call pure @compute_wide_offset_selection(%wide_input, %narrow_input, %choice, %lane) : (i64, i64, i32, index) -> (i64, i64)
  %base = index.constant 0 : offset
  %uniform_storage = buffer.assume.alignment %uniform_output {minimum_alignment = 8} : buffer
  %varying_storage = buffer.assume.alignment %varying_output {minimum_alignment = 8} : buffer
  %uniform_view = buffer.view %uniform_storage[%base] : buffer -> view<4xi64>
  %varying_view = buffer.view %varying_storage[%base] : buffer -> view<4xi64>
  view.store %uniform_value, %uniform_view[%lane] : i64, view<4xi64>
  view.store %varying_value, %varying_view[%lane] : i64, view<4xi64>
  kernel.return
}

func.def @select_wide_offsets_oracle(%wide_input: i64, %narrow_input: i64, %choice: i32, %uniform_output: buffer, %varying_output: buffer) {
  %base = index.constant 0 : offset
  %uniform_storage = buffer.assume.alignment %uniform_output {minimum_alignment = 8} : buffer
  %varying_storage = buffer.assume.alignment %varying_output {minimum_alignment = 8} : buffer
  %uniform_view = buffer.view %uniform_storage[%base] : buffer -> view<4xi64>
  %varying_view = buffer.view %varying_storage[%base] : buffer -> view<4xi64>
  %begin = index.constant 0 : index
  %end = index.constant 4 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %uniform_value, %varying_value = func.call pure @compute_wide_offset_selection(%wide_input, %narrow_input, %choice, %lane) : (i64, i64, i32, index) -> (i64, i64)
    view.store %uniform_value, %uniform_view[%lane] : i64, view<4xi64>
    view.store %varying_value, %varying_view[%lane] : i64, view<4xi64>
  }
  func.return
}

check.scenario @wide_offset_selection_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %wide = check.literal value(4294967297) : i64
    %narrow = check.literal value(0) : i64
    %choice = check.literal value(0) : i32
    %uniform = check.generate.fill value(-1) : tensor<4xi64>
    %varying = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@select_wide_offsets, @select_wide_offsets_oracle>(%wide, %narrow, %choice, %uniform, %varying) : (i64, i64, i32, tensor<4xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<4xi64>
      check.expect.bitwise actual(%varying) expected(%varying) : tensor<4xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %wide = check.literal value(4294967297) : i64
    %narrow = check.literal value(0) : i64
    %choice = check.literal value(1) : i32
    %uniform = check.generate.fill value(-1) : tensor<4xi64>
    %varying = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@select_wide_offsets, @select_wide_offsets_oracle>(%wide, %narrow, %choice, %uniform, %varying) : (i64, i64, i32, tensor<4xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<4xi64>
      check.expect.bitwise actual(%varying) expected(%varying) : tensor<4xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %wide = check.literal value(8589934591) : i64
    %narrow = check.literal value(2147483648) : i64
    %choice = check.literal value(0) : i32
    %uniform = check.generate.fill value(-1) : tensor<4xi64>
    %varying = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@select_wide_offsets, @select_wide_offsets_oracle>(%wide, %narrow, %choice, %uniform, %varying) : (i64, i64, i32, tensor<4xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<4xi64>
      check.expect.bitwise actual(%varying) expected(%varying) : tensor<4xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %wide = check.literal value(8589934591) : i64
    %narrow = check.literal value(2147483648) : i64
    %choice = check.literal value(1) : i32
    %uniform = check.generate.fill value(-1) : tensor<4xi64>
    %varying = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@select_wide_offsets, @select_wide_offsets_oracle>(%wide, %narrow, %choice, %uniform, %varying) : (i64, i64, i32, tensor<4xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<4xi64>
      check.expect.bitwise actual(%varying) expected(%varying) : tensor<4xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %wide = check.literal value(9223372032559808513) : i64
    %narrow = check.literal value(4294967295) : i64
    %choice = check.literal value(0) : i32
    %uniform = check.generate.fill value(-1) : tensor<4xi64>
    %varying = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@select_wide_offsets, @select_wide_offsets_oracle>(%wide, %narrow, %choice, %uniform, %varying) : (i64, i64, i32, tensor<4xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<4xi64>
      check.expect.bitwise actual(%varying) expected(%varying) : tensor<4xi64>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %wide = check.literal value(9223372032559808513) : i64
    %narrow = check.literal value(4294967295) : i64
    %choice = check.literal value(1) : i32
    %uniform = check.generate.fill value(-1) : tensor<4xi64>
    %varying = check.generate.fill value(-1) : tensor<4xi64>
    check.compare<@select_wide_offsets, @select_wide_offsets_oracle>(%wide, %narrow, %choice, %uniform, %varying) : (i64, i64, i32, tensor<4xi64>, tensor<4xi64>) -> () {
      check.expect.bitwise actual(%uniform) expected(%uniform) : tensor<4xi64>
      check.expect.bitwise actual(%varying) expected(%varying) : tensor<4xi64>
    }
  }
  check.return
}
