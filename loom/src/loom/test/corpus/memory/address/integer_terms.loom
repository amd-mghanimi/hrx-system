// Address decomposition preserves each integer's numeric domain before
// combining it with a constant bias.
func.def device inline @evaluate_narrow_coordinates(%bytes: buffer, %halfwords: buffer, %table: buffer, %byte_output: buffer, %halfword_output: buffer, %lane: index) {
  %base = index.constant 0 : offset
  %byte_source = buffer.view %bytes[%base] : buffer -> view<256xi8>
  %halfword_source = buffer.view %halfwords[%base] : buffer -> view<256xi16>
  %lookup = buffer.view %table[%base] : buffer -> view<65536xi32>
  %byte_destination = buffer.view %byte_output[%base] : buffer -> view<256xi32>
  %halfword_destination = buffer.view %halfword_output[%base] : buffer -> view<256xi32>
  %byte = view.load %byte_source[%lane] : view<256xi8> -> i8
  %halfword = view.load %halfword_source[%lane] : view<256xi16> -> i16
  %byte_coordinate = index.cast %byte : i8 to index
  %halfword_coordinate = index.cast %halfword : i16 to index
  %byte_bias = index.constant 128 : index
  %halfword_bias = index.constant 32768 : index
  %byte_position = index.add %byte_coordinate, %byte_bias : index
  %halfword_position = index.add %halfword_coordinate, %halfword_bias : index
  %byte_value = view.load %lookup[%byte_position] : view<65536xi32> -> i32
  %halfword_value = view.load %lookup[%halfword_position] : view<65536xi32> -> i32
  view.store %byte_value, %byte_destination[%lane] : i32, view<256xi32>
  view.store %halfword_value, %halfword_destination[%lane] : i32, view<256xi32>
  func.return
}

kernel.def @narrow_coordinates() {
  %unit = index.constant 1 : index
  %width = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%bytes: buffer, %halfwords: buffer, %table: buffer, %byte_output: buffer, %halfword_output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_narrow_coordinates(%bytes, %halfwords, %table, %byte_output, %halfword_output, %lane) : (buffer, buffer, buffer, buffer, buffer, index)
  kernel.return
}

func.def @narrow_coordinates_oracle(%bytes: buffer, %halfwords: buffer, %table: buffer, %byte_output: buffer, %halfword_output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_narrow_coordinates(%bytes, %halfwords, %table, %byte_output, %halfword_output, %lane) : (buffer, buffer, buffer, buffer, buffer, index)
  }
  func.return
}

check.scenario @signed_narrow_domain_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %bytes = check.generate.iota offset(-128) step(1) : tensor<256xi8>
    %halfwords = check.generate.iota offset(-32768) step(257) : tensor<256xi16>
    %table = check.generate.iota offset(11) step(7) : tensor<65536xi32>
    %byte_output = check.generate.fill value(-1) : tensor<256xi32>
    %halfword_output = check.generate.fill value(-1) : tensor<256xi32>
    check.compare<@narrow_coordinates, @narrow_coordinates_oracle>(%bytes, %halfwords, %table, %byte_output, %halfword_output) : (tensor<256xi8>, tensor<256xi16>, tensor<65536xi32>, tensor<256xi32>, tensor<256xi32>) -> () {
      check.expect.bitwise actual(%bytes) expected(%bytes) : tensor<256xi8>
      check.expect.bitwise actual(%halfwords) expected(%halfwords) : tensor<256xi16>
      check.expect.bitwise actual(%table) expected(%table) : tensor<65536xi32>
      check.expect.bitwise actual(%byte_output) expected(%byte_output) : tensor<256xi32>
      check.expect.bitwise actual(%halfword_output) expected(%halfword_output) : tensor<256xi32>
    }
  }
  check.return
}

func.def device inline @evaluate_predicate_coordinates(%input: buffer, %table: buffer, %output: buffer, %lane: index) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<2xi32>
  %lookup = buffer.view %table[%base] : buffer -> view<3xi32>
  %destination = buffer.view %output[%base] : buffer -> view<2xi32>
  %value = view.load %source[%lane] : view<2xi32> -> i32
  %sign_boundary = scalar.constant 0 : i32
  %negative = scalar.cmpi slt, %value, %sign_boundary : i32
  %coordinate = index.cast %negative : i1 to index
  %bias = index.constant 1 : index
  %position = index.add %coordinate, %bias : index
  %loaded = view.load %lookup[%position] : view<3xi32> -> i32
  view.store %loaded, %destination[%lane] : i32, view<2xi32>
  func.return
}

kernel.def @predicate_coordinates() {
  %unit = index.constant 1 : index
  %width = index.constant 2 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_predicate_coordinates(%input, %table, %output, %lane) : (buffer, buffer, buffer, index)
  kernel.return
}

func.def @predicate_coordinates_oracle(%input: buffer, %table: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 2 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_predicate_coordinates(%input, %table, %output, %lane) : (buffer, buffer, buffer, index)
  }
  func.return
}

check.scenario @predicate_coordinate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-1) step(2) : tensor<2xi32>
    %table = check.generate.iota offset(11) step(7) : tensor<3xi32>
    %output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@predicate_coordinates, @predicate_coordinates_oracle>(%input, %table, %output) : (tensor<2xi32>, tensor<3xi32>, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<2xi32>
      check.expect.bitwise actual(%table) expected(%table) : tensor<3xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}

func.def device inline @evaluate_negative_bias_coordinates(%input: buffer, %table: buffer, %output: buffer, %lane: index) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<128xi32>
  %lookup = buffer.view %table[%base] : buffer -> view<128xi32>
  %destination = buffer.view %output[%base] : buffer -> view<128xi32>
  %raw = view.load %source[%lane] : view<128xi32> -> i32
  %bounded = scalar.assume %raw [range(%raw, 128, 255)] : i32
  %coordinate = index.cast %bounded : i32 to index
  %bias = index.constant -128 : index
  %position = index.add %coordinate, %bias : index
  %loaded = view.load %lookup[%position] : view<128xi32> -> i32
  view.store %loaded, %destination[%lane] : i32, view<128xi32>
  func.return
}

kernel.def @negative_bias_coordinates() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %table: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_negative_bias_coordinates(%input, %table, %output, %lane) : (buffer, buffer, buffer, index)
  kernel.return
}

func.def @negative_bias_coordinates_oracle(%input: buffer, %table: buffer, %output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_negative_bias_coordinates(%input, %table, %output, %lane) : (buffer, buffer, buffer, index)
  }
  func.return
}

check.scenario @negative_bias_coordinate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(128) step(1) : tensor<128xi32>
    %table = check.generate.iota offset(11) step(7) : tensor<128xi32>
    %output = check.generate.fill value(-1) : tensor<128xi32>
    check.compare<@negative_bias_coordinates, @negative_bias_coordinates_oracle>(%input, %table, %output) : (tensor<128xi32>, tensor<128xi32>, tensor<128xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi32>
      check.expect.bitwise actual(%table) expected(%table) : tensor<128xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<128xi32>
    }
  }
  check.return
}

kernel.def @workgroup_wide_coordinates() {
  %unit = index.constant 1 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<128xi64>
  %destination = buffer.view %output[%base] : buffer -> view<128xi32>
  %length = index.constant 512 : offset
  %scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<128xi32>
  %raw = view.load %source[%lane] : view<128xi64> -> i64
  %bounded = scalar.assume %raw [range(%raw, -4294967296, -4294967169)] : i64
  %bias = scalar.constant 4294967296 : i64
  %ordinal = scalar.addi %bounded, %bias : i64
  %position = index.cast %ordinal : i64 to index
  %value = index.cast %lane : index to i32
  view.store %value, %scratch_view[%position] : i32, view<128xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %loaded = view.load %scratch_view[%lane] : view<128xi32> -> i32
  view.store %loaded, %destination[%lane] : i32, view<128xi32>
  kernel.return
}

func.def @workgroup_wide_coordinates_oracle(%input: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<128xi64>
  %destination = buffer.view %output[%base] : buffer -> view<128xi32>
  %begin = index.constant 0 : index
  %end = index.constant 128 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %raw = view.load %source[%lane] : view<128xi64> -> i64
    %bounded = scalar.assume %raw [range(%raw, -4294967296, -4294967169)] : i64
    %bias = scalar.constant 4294967296 : i64
    %ordinal = scalar.addi %bounded, %bias : i64
    %position = index.cast %ordinal : i64 to index
    %value = index.cast %lane : index to i32
    view.store %value, %destination[%position] : i32, view<128xi32>
  }
  func.return
}

check.scenario @wide_term_coordinate_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-4294967296) step(1) : tensor<128xi64>
    %output = check.generate.fill value(-1) : tensor<128xi32>
    check.compare<@workgroup_wide_coordinates, @workgroup_wide_coordinates_oracle>(%input, %output) : (tensor<128xi64>, tensor<128xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<128xi64>
      check.expect.bitwise actual(%output) expected(%output) : tensor<128xi32>
    }
  }
  check.return
}

// The write uses a signed narrow coordinate while the read uses the independent
// lane ordinal, so a shared address error cannot cancel between them.
kernel.def @workgroup_narrow_coordinates() {
  %unit = index.constant 1 : index
  %width = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %byte_output: buffer, %halfword_output: buffer) {
  %lane = kernel.workitem.id<x> : index
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<256xi32>
  %byte_destination = buffer.view %byte_output[%base] : buffer -> view<256xi32>
  %halfword_destination = buffer.view %halfword_output[%base] : buffer -> view<256xi32>
  %length = index.constant 1024 : offset
  %byte_scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %halfword_scratch = buffer.alloca<workgroup> align(4) %length : buffer
  %byte_view = buffer.view %byte_scratch[%base] : buffer -> view<256xi32>
  %halfword_view = buffer.view %halfword_scratch[%base] : buffer -> view<256xi32>
  %raw = view.load %source[%lane] : view<256xi32> -> i32
  %byte = scalar.trunci %raw : i32 to i8
  %halfword = scalar.extsi %byte : i8 to i16
  %byte_coordinate = index.cast %byte : i8 to index
  %halfword_coordinate = index.cast %halfword : i16 to index
  %bias = index.constant 128 : index
  %byte_position = index.add %byte_coordinate, %bias : index
  %halfword_position = index.add %halfword_coordinate, %bias : index
  view.store %raw, %byte_view[%byte_position] : i32, view<256xi32>
  view.store %raw, %halfword_view[%halfword_position] : i32, view<256xi32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %byte_value = view.load %byte_view[%lane] : view<256xi32> -> i32
  %halfword_value = view.load %halfword_view[%lane] : view<256xi32> -> i32
  view.store %byte_value, %byte_destination[%lane] : i32, view<256xi32>
  view.store %halfword_value, %halfword_destination[%lane] : i32, view<256xi32>
  kernel.return
}

func.def @workgroup_narrow_coordinates_oracle(%input: buffer, %byte_output: buffer, %halfword_output: buffer) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<256xi32>
  %byte_destination = buffer.view %byte_output[%base] : buffer -> view<256xi32>
  %halfword_destination = buffer.view %halfword_output[%base] : buffer -> view<256xi32>
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    %raw = view.load %source[%lane] : view<256xi32> -> i32
    %byte = scalar.trunci %raw : i32 to i8
    %halfword = scalar.extsi %byte : i8 to i16
    %byte_coordinate = index.cast %byte : i8 to index
    %halfword_coordinate = index.cast %halfword : i16 to index
    %bias = index.constant 128 : index
    %byte_position = index.add %byte_coordinate, %bias : index
    %halfword_position = index.add %halfword_coordinate, %bias : index
    view.store %raw, %byte_destination[%byte_position] : i32, view<256xi32>
    view.store %raw, %halfword_destination[%halfword_position] : i32, view<256xi32>
  }
  func.return
}

check.scenario @workgroup_narrow_domain_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-128) step(1) : tensor<256xi32>
    %byte_output = check.generate.fill value(999) : tensor<256xi32>
    %halfword_output = check.generate.fill value(999) : tensor<256xi32>
    check.compare<@workgroup_narrow_coordinates, @workgroup_narrow_coordinates_oracle>(%input, %byte_output, %halfword_output) : (tensor<256xi32>, tensor<256xi32>, tensor<256xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xi32>
      check.expect.bitwise actual(%byte_output) expected(%byte_output) : tensor<256xi32>
      check.expect.bitwise actual(%halfword_output) expected(%halfword_output) : tensor<256xi32>
    }
  }
  check.return
}

func.def device inline @evaluate_uniform_narrow_coordinates(%byte: i8, %halfword: i16, %table: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lookup = buffer.view %table[%base] : buffer -> view<65536xi32>
  %destination = buffer.view %output[%base] : buffer -> view<4xi32>
  %byte_coordinate = index.cast %byte : i8 to index
  %halfword_coordinate = index.cast %halfword : i16 to index
  %byte_bias = index.constant 128 : index
  %halfword_bias = index.constant 32768 : index
  %byte_position = index.add %byte_coordinate, %byte_bias : index
  %halfword_position = index.add %halfword_coordinate, %halfword_bias : index
  %byte_value = view.load %lookup[%byte_position] : view<65536xi32> -> i32
  %halfword_value = view.load %lookup[%halfword_position] : view<65536xi32> -> i32
  %byte_offset = index.cast %byte : i8 to offset
  %halfword_offset = index.cast %halfword : i16 to offset
  %unsigned_byte = index.cast %byte_offset : offset to i32
  %unsigned_halfword = index.cast %halfword_offset : offset to i32
  view.store %byte_value, %destination[0] : i32, view<4xi32>
  view.store %halfword_value, %destination[1] : i32, view<4xi32>
  view.store %unsigned_byte, %destination[2] : i32, view<4xi32>
  view.store %unsigned_halfword, %destination[3] : i32, view<4xi32>
  func.return
}

kernel.def @uniform_narrow_coordinates() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%byte: i8, %halfword: i16, %table: buffer, %output: buffer) {
  func.call @evaluate_uniform_narrow_coordinates(%byte, %halfword, %table, %output) : (i8, i16, buffer, buffer)
  kernel.return
}

func.def @uniform_narrow_coordinates_oracle(%byte: i8, %halfword: i16, %table: buffer, %output: buffer) {
  func.call @evaluate_uniform_narrow_coordinates(%byte, %halfword, %table, %output) : (i8, i16, buffer, buffer)
  func.return
}

check.scenario @uniform_narrow_abi_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %byte = check.literal value(-128) : i8
    %halfword = check.literal value(-32768) : i16
    %table = check.generate.iota offset(11) step(7) : tensor<65536xi32>
    %output = check.generate.fill value(-1) : tensor<4xi32>
    check.compare<@uniform_narrow_coordinates, @uniform_narrow_coordinates_oracle>(%byte, %halfword, %table, %output) : (i8, i16, tensor<65536xi32>, tensor<4xi32>) -> () {
      check.expect.bitwise actual(%table) expected(%table) : tensor<65536xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<4xi32>
    }
  }
  check.return
}
