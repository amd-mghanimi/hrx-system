// Narrowing keeps the declared low bits, signed widening preserves their sign,
// and an explicit offset cast interprets those same bits as unsigned.
func.def device inline @evaluate_varying_narrow_casts(%input: buffer, %signed_bytes: buffer, %unsigned_bytes: buffer, %signed_halfwords: buffer, %unsigned_halfwords: buffer, %lane: index) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<256xi32>
  %signed_byte_output = buffer.view %signed_bytes[%base] : buffer -> view<256xi32>
  %unsigned_byte_output = buffer.view %unsigned_bytes[%base] : buffer -> view<256xi32>
  %signed_halfword_output = buffer.view %signed_halfwords[%base] : buffer -> view<256xi32>
  %unsigned_halfword_output = buffer.view %unsigned_halfwords[%base] : buffer -> view<256xi32>
  %raw = view.load %source[%lane] : view<256xi32> -> i32
  %byte = scalar.trunci %raw : i32 to i8
  %byte_coordinate = index.cast %byte : i8 to index
  %signed_byte = index.cast %byte_coordinate : index to i32
  %byte_offset = index.cast %byte : i8 to offset
  %unsigned_byte = index.cast %byte_offset : offset to i32
  %halfword_bias = scalar.constant 32640 : i32
  %halfword_bits = scalar.addi %raw, %halfword_bias : i32
  %halfword_offset = index.cast %halfword_bits : i32 to offset
  %high_bits = index.constant 4294967296 : offset
  %wide_offset = index.add %halfword_offset, %high_bits : offset
  %halfword = index.cast %wide_offset : offset to i16
  %signed_halfword = scalar.extsi %halfword : i16 to i32
  %unsigned_halfword_offset = index.cast %halfword : i16 to offset
  %unsigned_halfword = index.cast %unsigned_halfword_offset : offset to i32
  view.store %signed_byte, %signed_byte_output[%lane] : i32, view<256xi32>
  view.store %unsigned_byte, %unsigned_byte_output[%lane] : i32, view<256xi32>
  view.store %signed_halfword, %signed_halfword_output[%lane] : i32, view<256xi32>
  view.store %unsigned_halfword, %unsigned_halfword_output[%lane] : i32, view<256xi32>
  func.return
}

kernel.def @varying_narrow_casts() {
  %unit = index.constant 1 : index
  %width = index.constant 256 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %signed_bytes: buffer, %unsigned_bytes: buffer, %signed_halfwords: buffer, %unsigned_halfwords: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_varying_narrow_casts(%input, %signed_bytes, %unsigned_bytes, %signed_halfwords, %unsigned_halfwords, %lane) : (buffer, buffer, buffer, buffer, buffer, index)
  kernel.return
}

func.def @varying_narrow_casts_oracle(%input: buffer, %signed_bytes: buffer, %unsigned_bytes: buffer, %signed_halfwords: buffer, %unsigned_halfwords: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 256 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_varying_narrow_casts(%input, %signed_bytes, %unsigned_bytes, %signed_halfwords, %unsigned_halfwords, %lane) : (buffer, buffer, buffer, buffer, buffer, index)
  }
  func.return
}

check.scenario @varying_narrow_cast_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(128) step(1) : tensor<256xi32>
    %signed_bytes = check.generate.fill value(999) : tensor<256xi32>
    %unsigned_bytes = check.generate.fill value(-1) : tensor<256xi32>
    %signed_halfwords = check.generate.fill value(999) : tensor<256xi32>
    %unsigned_halfwords = check.generate.fill value(-1) : tensor<256xi32>
    check.compare<@varying_narrow_casts, @varying_narrow_casts_oracle>(%input, %signed_bytes, %unsigned_bytes, %signed_halfwords, %unsigned_halfwords) : (tensor<256xi32>, tensor<256xi32>, tensor<256xi32>, tensor<256xi32>, tensor<256xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<256xi32>
      check.expect.bitwise actual(%signed_bytes) expected(%signed_bytes) : tensor<256xi32>
      check.expect.bitwise actual(%unsigned_bytes) expected(%unsigned_bytes) : tensor<256xi32>
      check.expect.bitwise actual(%signed_halfwords) expected(%signed_halfwords) : tensor<256xi32>
      check.expect.bitwise actual(%unsigned_halfwords) expected(%unsigned_halfwords) : tensor<256xi32>
    }
  }
  check.return
}

// Even nonzero integers distinguish low-bit truncation from truth testing.
func.def device inline @evaluate_varying_boolean_casts(%input: buffer, %index_output: buffer, %offset_output: buffer, %lane: index) {
  %base = index.constant 0 : offset
  %source = buffer.view %input[%base] : buffer -> view<8xi32>
  %index_destination = buffer.view %index_output[%base] : buffer -> view<8xi32>
  %offset_destination = buffer.view %offset_output[%base] : buffer -> view<8xi32>
  %raw = view.load %source[%lane] : view<8xi32> -> i32
  %coordinate = index.cast %raw : i32 to index
  %coordinate_bit = index.cast %coordinate : index to i1
  %bit_coordinate = index.cast %coordinate_bit : i1 to index
  %coordinate_result = index.cast %bit_coordinate : index to i32
  %byte_offset = index.cast %raw : i32 to offset
  %high_bits = index.constant 4294967296 : offset
  %wide_offset = index.add %byte_offset, %high_bits : offset
  %offset_bit = index.cast %wide_offset : offset to i1
  %bit_offset = index.cast %offset_bit : i1 to offset
  %offset_result = index.cast %bit_offset : offset to i32
  view.store %coordinate_result, %index_destination[%lane] : i32, view<8xi32>
  view.store %offset_result, %offset_destination[%lane] : i32, view<8xi32>
  func.return
}

kernel.def @varying_boolean_casts() {
  %unit = index.constant 1 : index
  %width = index.constant 8 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%input: buffer, %index_output: buffer, %offset_output: buffer) {
  %lane = kernel.workitem.id<x> : index
  func.call @evaluate_varying_boolean_casts(%input, %index_output, %offset_output, %lane) : (buffer, buffer, buffer, index)
  kernel.return
}

func.def @varying_boolean_casts_oracle(%input: buffer, %index_output: buffer, %offset_output: buffer) {
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  scf.for %lane = [%begin to %end step %step] {
    func.call @evaluate_varying_boolean_casts(%input, %index_output, %offset_output, %lane) : (buffer, buffer, buffer, index)
  }
  func.return
}

check.scenario @varying_boolean_cast_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %input = check.generate.iota offset(-2) step(1) : tensor<8xi32>
    %index_output = check.generate.fill value(-1) : tensor<8xi32>
    %offset_output = check.generate.fill value(-1) : tensor<8xi32>
    check.compare<@varying_boolean_casts, @varying_boolean_casts_oracle>(%input, %index_output, %offset_output) : (tensor<8xi32>, tensor<8xi32>, tensor<8xi32>) -> () {
      check.expect.bitwise actual(%input) expected(%input) : tensor<8xi32>
      check.expect.bitwise actual(%index_output) expected(%index_output) : tensor<8xi32>
      check.expect.bitwise actual(%offset_output) expected(%offset_output) : tensor<8xi32>
    }
  }
  check.return
}

func.def device inline @evaluate_uniform_boolean_casts(%coordinate: index, %byte_offset: offset, %output: buffer) {
  %coordinate_bit = index.cast %coordinate : index to i1
  %offset_bit = index.cast %byte_offset : offset to i1
  %bit_coordinate = index.cast %coordinate_bit : i1 to index
  %bit_offset = index.cast %offset_bit : i1 to offset
  %coordinate_result = index.cast %bit_coordinate : index to i32
  %offset_result = index.cast %bit_offset : offset to i32
  %base = index.constant 0 : offset
  %destination = buffer.view %output[%base] : buffer -> view<2xi32>
  view.store %coordinate_result, %destination[0] : i32, view<2xi32>
  view.store %offset_result, %destination[1] : i32, view<2xi32>
  func.return
}

kernel.def @uniform_boolean_casts() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%coordinate: index, %byte_offset: offset, %output: buffer) {
  func.call @evaluate_uniform_boolean_casts(%coordinate, %byte_offset, %output) : (index, offset, buffer)
  kernel.return
}

func.def @uniform_boolean_casts_oracle(%coordinate: index, %byte_offset: offset, %output: buffer) {
  func.call @evaluate_uniform_boolean_casts(%coordinate, %byte_offset, %output) : (index, offset, buffer)
  func.return
}

check.scenario @uniform_boolean_cast_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %coordinate = check.literal value(-2) : index
    %byte_offset = check.literal value(4294967298) : offset
    %output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@uniform_boolean_casts, @uniform_boolean_casts_oracle>(%coordinate, %byte_offset, %output) : (index, offset, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %coordinate = check.literal value(-1) : index
    %byte_offset = check.literal value(4294967299) : offset
    %output = check.generate.fill value(-1) : tensor<2xi32>
    check.compare<@uniform_boolean_casts, @uniform_boolean_casts_oracle>(%coordinate, %byte_offset, %output) : (index, offset, tensor<2xi32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<2xi32>
    }
  }
  check.return
}
