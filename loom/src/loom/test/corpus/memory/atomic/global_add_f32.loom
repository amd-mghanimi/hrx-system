// Device-global FP32 atomic add must remain correct under contention. Targets
// with a native instruction retain the source operation, while targets without
// one legalize it to a bitwise compare-exchange loop.
kernel.def @global_atomic_reduce_add_f32() {
  %unit = index.constant 1 : index
  %workgroup_count = index.constant 2 : index
  %workgroup_size = index.constant 4 : index
  kernel.launch.config workgroups(%workgroup_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%output: buffer) {
  %base = index.constant 0 : offset
  %output_index = index.constant 0 : index
  %output_global = buffer.assume.memory_space<global> %output : buffer
  %output_aligned = buffer.assume.alignment %output_global {minimum_alignment = 4} : buffer
  %output_view = buffer.view %output_aligned[%base] : buffer -> view<1xf32>
  %atomic_increment = scalar.constant 1.0 : f32
  view.atomic.reduce<addf> %atomic_increment, %output_view[%output_index] {ordering = relaxed, scope = device} : f32, view<1xf32>
  kernel.return
}

// The old values returned by eight unit increments of an accumulator initialized
// to one are a permutation of [1, 2, ..., 8], whose sum is always 36.
kernel.def @global_atomic_rmw_add_f32() {
  %unit = index.constant 1 : index
  %workgroup_count = index.constant 2 : index
  %workgroup_size = index.constant 4 : index
  kernel.launch.config workgroups(%workgroup_count, %unit, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%accumulator: buffer, %old_sum: buffer) {
  %base = index.constant 0 : offset
  %result_index = index.constant 0 : index
  %accumulator_global = buffer.assume.memory_space<global> %accumulator : buffer
  %old_sum_global = buffer.assume.memory_space<global> %old_sum : buffer
  %accumulator_aligned = buffer.assume.alignment %accumulator_global {minimum_alignment = 4} : buffer
  %old_sum_aligned = buffer.assume.alignment %old_sum_global {minimum_alignment = 4} : buffer
  %accumulator_view = buffer.view %accumulator_aligned[%base] : buffer -> view<1xf32>
  %old_sum_view = buffer.view %old_sum_aligned[%base] : buffer -> view<1xf32>
  %atomic_increment = scalar.constant 1.0 : f32
  %old = view.atomic.rmw<addf> %atomic_increment, %accumulator_view[%result_index] {ordering = relaxed, scope = device} : f32, view<1xf32> -> f32
  view.atomic.reduce<addf> %old, %old_sum_view[%result_index] {ordering = relaxed, scope = device} : f32, view<1xf32>
  kernel.return
}

// A 64-bit compare-exchange packet packs replacement into its low half and
// expected into its high half. Checking both memory and the returned old value
// makes that physical operand order observable.
kernel.def @global_atomic_cmpxchg_i64() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%value: buffer, %old_value: buffer) {
  %base = index.constant 0 : offset
  %value_index = index.constant 0 : index
  %value_global = buffer.assume.memory_space<global> %value : buffer
  %old_value_global = buffer.assume.memory_space<global> %old_value : buffer
  %value_aligned = buffer.assume.alignment %value_global {minimum_alignment = 8} : buffer
  %old_value_aligned = buffer.assume.alignment %old_value_global {minimum_alignment = 8} : buffer
  %value_view = buffer.view %value_aligned[%base] : buffer -> view<1xi64>
  %old_value_view = buffer.view %old_value_aligned[%base] : buffer -> view<1xi64>
  %expected = scalar.constant 7 : i64
  %replacement = scalar.constant 9 : i64
  %old = view.atomic.cmpxchg %expected, %replacement, %value_view[%value_index] {failure_ordering = relaxed, scope = device, success_ordering = relaxed} : i64, view<1xi64> -> i64
  view.store %old, %old_value_view[%value_index] : i64, view<1xi64>
  kernel.return
}

// Contention has one deterministic final sum, independent of invocation order.
func.def @global_atomic_reduce_add_f32_oracle(%output: buffer) {
  %base = index.constant 0 : offset
  %result = buffer.view %output[%base] : buffer -> view<1xf32>
  %final_value = scalar.constant 9.0 : f32
  view.store %final_value, %result[0] : f32, view<1xf32>
  func.return
}

// The returned tickets are a permutation with a deterministic sum.
func.def @global_atomic_rmw_add_f32_oracle(%accumulator: buffer, %old_sum: buffer) {
  %base = index.constant 0 : offset
  %accumulator_view = buffer.view %accumulator[%base] : buffer -> view<1xf32>
  %old_sum_view = buffer.view %old_sum[%base] : buffer -> view<1xf32>
  %final_value = scalar.constant 9.0 : f32
  %ticket_sum = scalar.constant 36.0 : f32
  view.store %final_value, %accumulator_view[0] : f32, view<1xf32>
  view.store %ticket_sum, %old_sum_view[0] : f32, view<1xf32>
  func.return
}

// The scalar oracle models a successful compare-exchange without atomics.
func.def @global_atomic_cmpxchg_i64_oracle(%value: buffer, %old_value: buffer) {
  %base = index.constant 0 : offset
  %value_view = buffer.view %value[%base] : buffer -> view<1xi64>
  %old_value_view = buffer.view %old_value[%base] : buffer -> view<1xi64>
  %expected = scalar.constant 7 : i64
  %replacement = scalar.constant 9 : i64
  %current = view.load %value_view[0] : view<1xi64> -> i64
  %matches = scalar.cmpi eq, %current, %expected : i64
  %next = scf.select %matches, %replacement, %current : i64
  view.store %next, %value_view[0] : i64, view<1xi64>
  view.store %current, %old_value_view[0] : i64, view<1xi64>
  func.return
}

check.scenario @global_atomic_values {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %output = check.generate.fill value(1.0) : tensor<1xf32>
    check.compare<@global_atomic_reduce_add_f32, @global_atomic_reduce_add_f32_oracle>(%output) : (tensor<1xf32>) -> () {
      check.expect.bitwise actual(%output) expected(%output) : tensor<1xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %accumulator = check.generate.fill value(1.0) : tensor<1xf32>
    %old_sum = check.generate.fill value(0.0) : tensor<1xf32>
    check.compare<@global_atomic_rmw_add_f32, @global_atomic_rmw_add_f32_oracle>(%accumulator, %old_sum) : (tensor<1xf32>, tensor<1xf32>) -> () {
      check.expect.bitwise actual(%accumulator) expected(%accumulator) : tensor<1xf32>
      check.expect.bitwise actual(%old_sum) expected(%old_sum) : tensor<1xf32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %value = check.generate.fill value(7) : tensor<1xi64>
    %old_value = check.generate.fill value(0) : tensor<1xi64>
    check.compare<@global_atomic_cmpxchg_i64, @global_atomic_cmpxchg_i64_oracle>(%value, %old_value) : (tensor<1xi64>, tensor<1xi64>) -> () {
      check.expect.bitwise actual(%value) expected(%value) : tensor<1xi64>
      check.expect.bitwise actual(%old_value) expected(%old_value) : tensor<1xi64>
    }
  }
  check.return
}
