// Two adjacent byte counters share one physical CAS word. Their independent
// ticket streams cross byte wraparound under divergent, cross-wave contention.
func.def inline @claim_byte_ticket(%cells: view<2xi8>, %cell: index) -> (i32) {
  %increment = scalar.constant 1 : i8
  %initial = scalar.constant -32 : i8
  %old = view.atomic.rmw<addi> %increment, %cells[%cell] {ordering = relaxed, scope = device} : i8, view<2xi8> -> i8
  %distance = scalar.subi %old, %initial : i8
  %ticket = scalar.extui %distance : i8 to i32
  func.return %ticket : i32
}

kernel.def @contended_byte_counters() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %width = index.constant 128 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%width, %unit, %unit) : index
} launch(%global_storage: buffer, %generic_storage: buffer, %output: buffer, %local_output: buffer, %summary: buffer) {
  %origin = index.constant 0 : offset
  %interior = index.constant 1 : offset
  %bytes = index.constant 4 : offset
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %generic = buffer.assume.memory_space<generic> %generic_storage : buffer
  %scratch = buffer.alloca<workgroup> align(1) %bytes : buffer
  %global_cells = buffer.view %global[%interior] : buffer -> view<2xi8>
  %generic_cells = buffer.view %generic[%interior] : buffer -> view<2xi8>
  %local_cells = buffer.view %scratch[%interior] : buffer -> view<2xi8>
  %local_storage = buffer.view %scratch[%origin] : buffer -> view<4xi8>
  %tickets = buffer.view %output[%origin] : buffer -> view<2x2x66xi32>
  %local_tickets = buffer.view %local_output[%origin] : buffer -> view<2x2x33xi32>
  %summaries = buffer.view %summary[%origin] : buffer -> view<2x4xi8>
  %first_lane = index.constant 0 : index
  %leader = index.cmp eq, %lane, %first_lane : index
  %initial = scalar.constant -32 : i8
  %guard = scalar.constant 77 : i8
  scf.if %leader {
    view.store %guard, %local_storage[0] : i8, view<4xi8>
    view.store %initial, %local_cells[0] : i8, view<2xi8>
    view.store %initial, %local_cells[1] : i8, view<2xi8>
    view.store %guard, %local_storage[3] : i8, view<4xi8>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %active_count = index.constant 65 : index
  %active = index.cmp ult, %lane, %active_count : index
  scf.if %active {
    %pair_size = index.constant 2 : index
    %cell = index.rem %lane, %pair_size : index
    %global_ticket = func.call @claim_byte_ticket(%global_cells, %cell) : (view<2xi8>, index) -> (i32)
    %generic_ticket = func.call @claim_byte_ticket(%generic_cells, %cell) : (view<2xi8>, index) -> (i32)
    %local_ticket = func.call @claim_byte_ticket(%local_cells, %cell) : (view<2xi8>, index) -> (i32)
    // Each stream assigns at most 66 global or 33 workgroup-local tickets.
    %global_bounded = scalar.assume %global_ticket [range(%global_ticket, 0, 65)] : i32
    %generic_bounded = scalar.assume %generic_ticket [range(%generic_ticket, 0, 65)] : i32
    %local_bounded = scalar.assume %local_ticket [range(%local_ticket, 0, 32)] : i32
    %global_slot = index.cast %global_bounded : i32 to index
    %generic_slot = index.cast %generic_bounded : i32 to index
    %local_slot = index.cast %local_bounded : i32 to index
    view.store %global_ticket, %tickets[0, %cell, %global_slot] : i32, view<2x2x66xi32>
    view.store %generic_ticket, %tickets[1, %cell, %generic_slot] : i32, view<2x2x66xi32>
    view.store %local_ticket, %local_tickets[%group, %cell, %local_slot] : i32, view<2x2x33xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %leader {
    %prefix = view.load %local_storage[0] : view<4xi8> -> i8
    %first = view.load %local_cells[0] : view<2xi8> -> i8
    %second = view.load %local_cells[1] : view<2xi8> -> i8
    %suffix = view.load %local_storage[3] : view<4xi8> -> i8
    view.store %prefix, %summaries[%group, 0] : i8, view<2x4xi8>
    view.store %first, %summaries[%group, 1] : i8, view<2x4xi8>
    view.store %second, %summaries[%group, 2] : i8, view<2x4xi8>
    view.store %suffix, %summaries[%group, 3] : i8, view<2x4xi8>
  }
  kernel.return
}

// The oracle materializes each deterministic ticket set and final counter with
// ordinary integer operations. It does not share the packed atomic words.
func.def @contended_byte_counters_oracle(%global_storage: buffer, %generic_storage: buffer, %output: buffer, %local_output: buffer, %summary: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %group_end = index.constant 2 : index
  %global_first_end = index.constant 66 : index
  %global_second_end = index.constant 64 : index
  %local_first_end = index.constant 33 : index
  %local_second_end = index.constant 32 : index
  %step = index.constant 1 : index
  %global = buffer.view %global_storage[%base] : buffer -> view<4xi8>
  %generic = buffer.view %generic_storage[%base] : buffer -> view<4xi8>
  %tickets = buffer.view %output[%base] : buffer -> view<2x2x66xi32>
  %local_tickets = buffer.view %local_output[%base] : buffer -> view<2x2x33xi32>
  %summaries = buffer.view %summary[%base] : buffer -> view<2x4xi8>
  %first_final = scalar.constant 34 : i8
  %second_final = scalar.constant 32 : i8
  %guard = scalar.constant 77 : i8
  %local_first_final = scalar.constant 1 : i8
  %local_second_final = scalar.constant 0 : i8
  view.store %first_final, %global[1] : i8, view<4xi8>
  view.store %second_final, %global[2] : i8, view<4xi8>
  view.store %first_final, %generic[1] : i8, view<4xi8>
  view.store %second_final, %generic[2] : i8, view<4xi8>
  scf.for %position = [%begin to %global_first_end step %step] {
    %ticket = index.cast %position : index to i32
    view.store %ticket, %tickets[0, 0, %position] : i32, view<2x2x66xi32>
    view.store %ticket, %tickets[1, 0, %position] : i32, view<2x2x66xi32>
  }
  scf.for %position = [%begin to %global_second_end step %step] {
    %ticket = index.cast %position : index to i32
    view.store %ticket, %tickets[0, 1, %position] : i32, view<2x2x66xi32>
    view.store %ticket, %tickets[1, 1, %position] : i32, view<2x2x66xi32>
  }
  scf.for %position = [%begin to %local_first_end step %step] {
    %ticket = index.cast %position : index to i32
    view.store %ticket, %local_tickets[0, 0, %position] : i32, view<2x2x33xi32>
    view.store %ticket, %local_tickets[1, 0, %position] : i32, view<2x2x33xi32>
  }
  scf.for %position = [%begin to %local_second_end step %step] {
    %ticket = index.cast %position : index to i32
    view.store %ticket, %local_tickets[0, 1, %position] : i32, view<2x2x33xi32>
    view.store %ticket, %local_tickets[1, 1, %position] : i32, view<2x2x33xi32>
  }
  scf.for %group = [%begin to %group_end step %step] {
    view.store %guard, %summaries[%group, 0] : i8, view<2x4xi8>
    view.store %local_first_final, %summaries[%group, 1] : i8, view<2x4xi8>
    view.store %local_second_final, %summaries[%group, 2] : i8, view<2x4xi8>
    view.store %guard, %summaries[%group, 3] : i8, view<2x4xi8>
  }
  func.return
}

check.scenario @contended_byte_tickets {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %global = check.generate.fill value(-32) : tensor<4xi8>
    %generic = check.generate.fill value(-32) : tensor<4xi8>
    %output = check.generate.fill value(-1) : tensor<2x2x66xi32>
    %local_output = check.generate.fill value(-1) : tensor<2x2x33xi32>
    %summary = check.generate.fill value(-1) : tensor<2x4xi8>
    check.compare<@contended_byte_counters, @contended_byte_counters_oracle>(%global, %generic, %output, %local_output, %summary) : (tensor<4xi8>, tensor<4xi8>, tensor<2x2x66xi32>, tensor<2x2x33xi32>, tensor<2x4xi8>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<4xi8>
      check.expect.bitwise actual(%generic) expected(%generic) : tensor<4xi8>
      check.expect.bitwise actual(%output) expected(%output) : tensor<2x2x66xi32>
      check.expect.bitwise actual(%local_output) expected(%local_output) : tensor<2x2x33xi32>
      check.expect.bitwise actual(%summary) expected(%summary) : tensor<2x4xi8>
    }
  }
  check.return
}
