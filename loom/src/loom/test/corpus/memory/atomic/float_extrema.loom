// Arithmetic NaNs have implementation-selected payloads. Canonicalizing only
// those final results keeps returned old values and signed zeros bit-exact.
func.def inline @extrema_f32_result_bits(%value: f32) -> (i32) {
  %bits = scalar.bitcast %value : f32 to i32
  %absolute_mask = scalar.constant 2147483647 : i32
  %infinity_bits = scalar.constant 2139095040 : i32
  %absolute = scalar.andi %bits, %absolute_mask : i32
  %nan = scalar.cmpi ugt, %absolute, %infinity_bits : i32
  %nan_bits = scalar.constant 2143289344 : i32
  %result = scf.select %nan, %nan_bits, %bits : i32
  func.return %result : i32
}

// Workgroup extrema remain an independent compile root on targets that cannot
// lower the corresponding global atomics.
func.def inline @workgroup_atomic_extrema_f32_cells(%lhs: f32, %rhs: f32, %output: buffer, %output_base: offset) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %final_base = index.constant 4 : index
  %bytes = index.constant 32 : offset
  %workgroup = buffer.alloca<workgroup> align(4) %bytes : buffer
  %values = buffer.view %workgroup[%base] : buffer -> view<8xf32>
  %results = buffer.view %output[%output_base] : buffer -> view<12xi32>
  scf.for %cell = [%begin to %end step %step] {
    view.store %lhs, %values[%cell] : f32, view<8xf32>
  }
  %old_minimumf = view.atomic.rmw<minimumf> %rhs, %values[0] {ordering = acq_rel, scope = workgroup} : f32, view<8xf32> -> f32
  view.atomic.reduce<minimumf> %rhs, %values[1] {ordering = release, scope = workgroup} : f32, view<8xf32>
  %old_minimumf_bits = scalar.bitcast %old_minimumf : f32 to i32
  view.store %old_minimumf_bits, %results[0] : i32, view<12xi32>
  %old_maximumf = view.atomic.rmw<maximumf> %rhs, %values[2] {ordering = acq_rel, scope = workgroup} : f32, view<8xf32> -> f32
  view.atomic.reduce<maximumf> %rhs, %values[3] {ordering = release, scope = workgroup} : f32, view<8xf32>
  %old_maximumf_bits = scalar.bitcast %old_maximumf : f32 to i32
  view.store %old_maximumf_bits, %results[1] : i32, view<12xi32>
  %old_minnumf = view.atomic.rmw<minnumf> %rhs, %values[4] {ordering = acq_rel, scope = workgroup} : f32, view<8xf32> -> f32
  view.atomic.reduce<minnumf> %rhs, %values[5] {ordering = release, scope = workgroup} : f32, view<8xf32>
  %old_minnumf_bits = scalar.bitcast %old_minnumf : f32 to i32
  view.store %old_minnumf_bits, %results[2] : i32, view<12xi32>
  %old_maxnumf = view.atomic.rmw<maxnumf> %rhs, %values[6] {ordering = acq_rel, scope = workgroup} : f32, view<8xf32> -> f32
  view.atomic.reduce<maxnumf> %rhs, %values[7] {ordering = release, scope = workgroup} : f32, view<8xf32>
  %old_maxnumf_bits = scalar.bitcast %old_maxnumf : f32 to i32
  view.store %old_maxnumf_bits, %results[3] : i32, view<12xi32>
  scf.for %cell = [%begin to %end step %step] {
    %value = view.load %values[%cell] : view<8xf32> -> f32
    %value_bits = func.call @extrema_f32_result_bits(%value) : (f32) -> (i32)
    %result_index = index.add %cell, %final_base : index
    view.store %value_bits, %results[%result_index] : i32, view<12xi32>
  }
  func.return
}

// One workitem applies the same extrema matrix to global and workgroup
// storage. RMW and reduction forms occupy independent cells.
kernel.def @atomic_extrema_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs_bits_wide: i64, %rhs_bits_wide: i64, %global_storage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %lhs_bits = scalar.trunci %lhs_bits_wide : i64 to i32
  %rhs_bits = scalar.trunci %rhs_bits_wide : i64 to i32
  %lhs = scalar.bitcast %lhs_bits : i32 to f32
  %rhs = scalar.bitcast %rhs_bits : i32 to f32
  %global = buffer.assume.memory_space<global> %global_storage : buffer
  %global_values = buffer.view %global[%base] : buffer -> view<8xf32>
  %global_bits = buffer.view %global[%base] : buffer -> view<8xi32>
  %results = buffer.view %output[%base] : buffer -> view<16xi32>
  scf.for %cell = [%begin to %end step %step] {
    view.store %lhs, %global_values[%cell] : f32, view<8xf32>
  }
  %global_old_minimumf = view.atomic.rmw<minimumf> %rhs, %global_values[0] {ordering = acq_rel, scope = device} : f32, view<8xf32> -> f32
  view.atomic.reduce<minimumf> %rhs, %global_values[1] {ordering = release, scope = device} : f32, view<8xf32>
  %global_old_minimumf_bits = scalar.bitcast %global_old_minimumf : f32 to i32
  view.store %global_old_minimumf_bits, %results[0] : i32, view<16xi32>
  %global_old_maximumf = view.atomic.rmw<maximumf> %rhs, %global_values[2] {ordering = acq_rel, scope = device} : f32, view<8xf32> -> f32
  view.atomic.reduce<maximumf> %rhs, %global_values[3] {ordering = release, scope = device} : f32, view<8xf32>
  %global_old_maximumf_bits = scalar.bitcast %global_old_maximumf : f32 to i32
  view.store %global_old_maximumf_bits, %results[1] : i32, view<16xi32>
  %global_old_minnumf = view.atomic.rmw<minnumf> %rhs, %global_values[4] {ordering = acq_rel, scope = device} : f32, view<8xf32> -> f32
  view.atomic.reduce<minnumf> %rhs, %global_values[5] {ordering = release, scope = device} : f32, view<8xf32>
  %global_old_minnumf_bits = scalar.bitcast %global_old_minnumf : f32 to i32
  view.store %global_old_minnumf_bits, %results[2] : i32, view<16xi32>
  %global_old_maxnumf = view.atomic.rmw<maxnumf> %rhs, %global_values[6] {ordering = acq_rel, scope = device} : f32, view<8xf32> -> f32
  view.atomic.reduce<maxnumf> %rhs, %global_values[7] {ordering = release, scope = device} : f32, view<8xf32>
  %global_old_maxnumf_bits = scalar.bitcast %global_old_maxnumf : f32 to i32
  view.store %global_old_maxnumf_bits, %results[3] : i32, view<16xi32>
  scf.for %cell = [%begin to %end step %step] {
    %global_result = view.load %global_values[%cell] : view<8xf32> -> f32
    %global_result_bits = func.call @extrema_f32_result_bits(%global_result) : (f32) -> (i32)
    view.store %global_result_bits, %global_bits[%cell] : i32, view<8xi32>
  }
  %workgroup_output_base = index.constant 16 : offset
  func.call @workgroup_atomic_extrema_f32_cells(%lhs, %rhs, %output, %workgroup_output_base) : (f32, f32, buffer, offset)
  kernel.return
}

kernel.def @workgroup_atomic_extrema_f32() {
  %unit = index.constant 1 : index
  kernel.launch.config workgroups(%unit, %unit, %unit) workgroup_size(%unit, %unit, %unit) : index
} launch(%lhs_bits_wide: i64, %rhs_bits_wide: i64, %global_storage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %begin = index.constant 0 : index
  %end = index.constant 8 : index
  %step = index.constant 1 : index
  %workgroup_output_base = index.constant 16 : offset
  %lhs_bits = scalar.trunci %lhs_bits_wide : i64 to i32
  %rhs_bits = scalar.trunci %rhs_bits_wide : i64 to i32
  %lhs = scalar.bitcast %lhs_bits : i32 to f32
  %rhs = scalar.bitcast %rhs_bits : i32 to f32
  %global = buffer.view %global_storage[%base] : buffer -> view<8xi32>
  %results = buffer.view %output[%base] : buffer -> view<16xi32>
  view.store %lhs_bits, %results[0] : i32, view<16xi32>
  view.store %lhs_bits, %results[1] : i32, view<16xi32>
  view.store %lhs_bits, %results[2] : i32, view<16xi32>
  view.store %lhs_bits, %results[3] : i32, view<16xi32>
  func.call @workgroup_atomic_extrema_f32_cells(%lhs, %rhs, %output, %workgroup_output_base) : (f32, f32, buffer, offset)
  scf.for %cell = [%begin to %end step %step] {
    %result_cell = index.add %cell, %end : index
    %value = view.load %results[%result_cell] : view<16xi32> -> i32
    view.store %value, %global[%cell] : i32, view<8xi32>
  }
  kernel.return
}

// The oracle evaluates ordinary scalar extrema and canonicalizes only NaN
// results. It shares no atomic state with the target invocation.
func.def @atomic_extrema_f32_oracle(%lhs_bits_wide: i64, %rhs_bits_wide: i64, %global_storage: buffer, %output: buffer) {
  %base = index.constant 0 : offset
  %lhs_bits = scalar.trunci %lhs_bits_wide : i64 to i32
  %rhs_bits = scalar.trunci %rhs_bits_wide : i64 to i32
  %lhs = scalar.bitcast %lhs_bits : i32 to f32
  %rhs = scalar.bitcast %rhs_bits : i32 to f32
  %global = buffer.view %global_storage[%base] : buffer -> view<8xi32>
  %results = buffer.view %output[%base] : buffer -> view<16xi32>
  view.store %lhs_bits, %results[0] : i32, view<16xi32>
  view.store %lhs_bits, %results[1] : i32, view<16xi32>
  view.store %lhs_bits, %results[2] : i32, view<16xi32>
  view.store %lhs_bits, %results[3] : i32, view<16xi32>
  view.store %lhs_bits, %results[4] : i32, view<16xi32>
  view.store %lhs_bits, %results[5] : i32, view<16xi32>
  view.store %lhs_bits, %results[6] : i32, view<16xi32>
  view.store %lhs_bits, %results[7] : i32, view<16xi32>
  %minimumf = scalar.minimumf %lhs, %rhs : f32
  %minimumf_bits = func.call @extrema_f32_result_bits(%minimumf) : (f32) -> (i32)
  view.store %minimumf_bits, %global[0] : i32, view<8xi32>
  view.store %minimumf_bits, %global[1] : i32, view<8xi32>
  view.store %minimumf_bits, %results[8] : i32, view<16xi32>
  view.store %minimumf_bits, %results[9] : i32, view<16xi32>
  %maximumf = scalar.maximumf %lhs, %rhs : f32
  %maximumf_bits = func.call @extrema_f32_result_bits(%maximumf) : (f32) -> (i32)
  view.store %maximumf_bits, %global[2] : i32, view<8xi32>
  view.store %maximumf_bits, %global[3] : i32, view<8xi32>
  view.store %maximumf_bits, %results[10] : i32, view<16xi32>
  view.store %maximumf_bits, %results[11] : i32, view<16xi32>
  %minnumf = scalar.minnumf %lhs, %rhs : f32
  %minnumf_bits = func.call @extrema_f32_result_bits(%minnumf) : (f32) -> (i32)
  view.store %minnumf_bits, %global[4] : i32, view<8xi32>
  view.store %minnumf_bits, %global[5] : i32, view<8xi32>
  view.store %minnumf_bits, %results[12] : i32, view<16xi32>
  view.store %minnumf_bits, %results[13] : i32, view<16xi32>
  %maxnumf = scalar.maxnumf %lhs, %rhs : f32
  %maxnumf_bits = func.call @extrema_f32_result_bits(%maxnumf) : (f32) -> (i32)
  view.store %maxnumf_bits, %global[6] : i32, view<8xi32>
  view.store %maxnumf_bits, %global[7] : i32, view<8xi32>
  view.store %maxnumf_bits, %results[14] : i32, view<16xi32>
  view.store %maxnumf_bits, %results[15] : i32, view<16xi32>
  func.return
}

kernel.def @contended_atomic_extrema_f32() {
  %unit = index.constant 1 : index
  %groups = index.constant 2 : index
  %size = index.constant 64 : index
  kernel.launch.config workgroups(%groups, %unit, %unit) workgroup_size(%size, %unit, %unit) : index
} launch(%accumulator: buffer, %initial_returns: buffer) {
  %base = index.constant 0 : offset
  %global = buffer.assume.memory_space<global> %accumulator : buffer
  %view = buffer.view %global[%base] : buffer -> view<4xf32>
  %counts_global = buffer.assume.memory_space<global> %initial_returns : buffer
  %counts = buffer.view %counts_global[%base] : buffer -> view<4xi32>
  %lower = scalar.constant -1.0 : f32
  %upper = scalar.constant 2.0 : f32
  %initial_bits = scalar.constant 1065353216 : i32
  %increment = scalar.constant 1 : i32
  %no_increment = scalar.constant 0 : i32
  %old_minimumf = view.atomic.rmw<minimumf> %lower, %view[0] {ordering = relaxed, scope = device} : f32, view<4xf32> -> f32
  %bits_minimumf = scalar.bitcast %old_minimumf : f32 to i32
  %first_minimumf = scalar.cmpi eq, %bits_minimumf, %initial_bits : i32
  %count_minimumf = scf.select %first_minimumf, %increment, %no_increment : i32
  view.atomic.reduce<addi> %count_minimumf, %counts[0] {ordering = relaxed, scope = device} : i32, view<4xi32>
  %old_maximumf = view.atomic.rmw<maximumf> %upper, %view[1] {ordering = relaxed, scope = device} : f32, view<4xf32> -> f32
  %bits_maximumf = scalar.bitcast %old_maximumf : f32 to i32
  %first_maximumf = scalar.cmpi eq, %bits_maximumf, %initial_bits : i32
  %count_maximumf = scf.select %first_maximumf, %increment, %no_increment : i32
  view.atomic.reduce<addi> %count_maximumf, %counts[1] {ordering = relaxed, scope = device} : i32, view<4xi32>
  %old_minnumf = view.atomic.rmw<minnumf> %lower, %view[2] {ordering = relaxed, scope = device} : f32, view<4xf32> -> f32
  %bits_minnumf = scalar.bitcast %old_minnumf : f32 to i32
  %first_minnumf = scalar.cmpi eq, %bits_minnumf, %initial_bits : i32
  %count_minnumf = scf.select %first_minnumf, %increment, %no_increment : i32
  view.atomic.reduce<addi> %count_minnumf, %counts[2] {ordering = relaxed, scope = device} : i32, view<4xi32>
  %old_maxnumf = view.atomic.rmw<maxnumf> %upper, %view[3] {ordering = relaxed, scope = device} : f32, view<4xf32> -> f32
  %bits_maxnumf = scalar.bitcast %old_maxnumf : f32 to i32
  %first_maxnumf = scalar.cmpi eq, %bits_maxnumf, %initial_bits : i32
  %count_maxnumf = scf.select %first_maxnumf, %increment, %no_increment : i32
  view.atomic.reduce<addi> %count_maxnumf, %counts[3] {ordering = relaxed, scope = device} : i32, view<4xi32>
  kernel.return
}

// Contention changes each cell exactly once, so one invocation may return the
// initial value for each destination and every later invocation sees an extrema.
func.def @contended_atomic_extrema_f32_oracle(%accumulator: buffer, %initial_returns: buffer) {
  %base = index.constant 0 : offset
  %values = buffer.view %accumulator[%base] : buffer -> view<4xf32>
  %counts = buffer.view %initial_returns[%base] : buffer -> view<4xi32>
  %lower = scalar.constant -1.0 : f32
  %upper = scalar.constant 2.0 : f32
  %c1 = scalar.constant 1 : i32
  view.store %lower, %values[0] : f32, view<4xf32>
  view.store %upper, %values[1] : f32, view<4xf32>
  view.store %lower, %values[2] : f32, view<4xf32>
  view.store %upper, %values[3] : f32, view<4xf32>
  view.store %c1, %counts[0] : i32, view<4xi32>
  view.store %c1, %counts[1] : i32, view<4xi32>
  view.store %c1, %counts[2] : i32, view<4xi32>
  view.store %c1, %counts[3] : i32, view<4xi32>
  func.return
}

check.scenario @atomic_extrema_f32_values {
  check.trial[128](%trial: index, %entropy: check.entropy) {
    %lhs = check.entropy.read %entropy[0] : check.entropy -> i64
    %rhs = check.entropy.read %entropy[1] : check.entropy -> i64
    %global = check.generate.fill value(77) : tensor<8xi32>
    %output = check.generate.fill value(-1) : tensor<16xi32>
    check.compare<@atomic_extrema_f32, @atomic_extrema_f32_oracle>(%lhs, %rhs, %global, %output) : (i64, i64, tensor<8xi32>, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<8xi32>
      check.expect.bitwise actual(%output) expected(%output) : tensor<16xi32>
    }
  }
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %lhs = check.literal value(-1082130432) : i64
    %rhs = check.literal value(1073741824) : i64
    %global = check.generate.fill value(77) : tensor<8xi32>
    %output = check.generate.fill value(-1) : tensor<16xi32>
    check.compare<@atomic_extrema_f32, @atomic_extrema_f32_oracle>(%lhs, %rhs, %global, %output) : (i64, i64, tensor<8xi32>, tensor<16xi32>) -> () {
      check.expect.bitwise actual(%global) expected(%global) : tensor<8xi32>
