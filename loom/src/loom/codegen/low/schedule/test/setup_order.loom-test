// ====

// Delaying a private destination can keep its captured input live in another
// bank while that bank constructs an independent tuple.
// RUN: emit low-schedule-query @captured_input strategy=resource-stall test.i64=2 required-register-values=%source,%private,%first,%second order=* scheduled-pressure=test.i64

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @captured_input(%source: reg<test.i64>) -> (reg<test.i32 x3>) asm {
  %private = copy %source : reg<test.i64> -> reg<test.i32>
  %first_source = test.const.i32 1
  %second_source = test.const.i32 2
  %first = copy %first_source : reg<test.i32> -> reg<test.i64>
  %second = copy %second_source : reg<test.i32> -> reg<test.i64>
  %wide = concat(%first, %second) : (reg<test.i64>, reg<test.i64>) -> reg<test.i64 x2>
  %dependency = copy %wide : reg<test.i64 x2> -> reg<test.i32 x2>
  %result = concat(%private, %dependency) : (reg<test.i32>, reg<test.i32 x2>) -> reg<test.i32 x3>
  return %result
}

