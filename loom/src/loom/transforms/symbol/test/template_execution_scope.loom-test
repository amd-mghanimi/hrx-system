test.target<low_core> @worker {subgroup_size = 32}

template.decl @width_value() -> (i32)

pipeline.def public target(@construction) @publish_widths() run(%first: channel<tile<2xi32>>, %second: channel<tile<2xi32>>) {
  %value$2 = scalar.constant 64 : i32
  pipeline.strand target(@worker) workers([0], [1], [1]) {
    %write, %record = channel.reserve %first : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
    %value = scalar.constant 32 : i32
    view.store %value$2, %record[0] : i32, view<2xi32>
    view.store %value, %record[1] : i32, view<2xi32>
    channel.publish %write : write<tile<2xi32>>
  }
  pipeline.strand target(@construction) workers([1], [1], [1]) {
    %write, %record = channel.reserve %second : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
    %value = scalar.constant 64 : i32
    view.store %value$2, %record[0] : i32, view<2xi32>
    view.store %value, %record[1] : i32, view<2xi32>
    channel.publish %write : write<tile<2xi32>>
  }
}

// ====

// Applicability uses the worker target while operand facts preserve both
// construction and worker queries. Exact calls and abstract demands agree.
// RUN: pass select-templates{mode=final,rewrite=inline},canonicalize
test.target<low_core> @construction {subgroup_size = 64}

test.target<low_core> @worker {subgroup_size = 32}

template.decl @combined_width(%construction: index, %worker: index) -> (index)

template.def<@combined_width> requires [#target.subgroup.size<32>] @combine(%construction: index, %worker: index) -> (index) where [eq(%construction, 64), eq(%worker, 32)] {
  %result = index.add %construction, %worker : index
  template.return %result : index
}

pipeline.def public target(@construction) @publish_combined() run(%output: channel<tile<2xi32>>) {
  %construction_width = target.subgroup.size : index
  pipeline.strand target(@worker) workers([0], [1], [1]) {
    %write, %record = channel.reserve %output : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
    %worker_width = target.subgroup.size : index
    %exact = template.call @combine(%construction_width, %worker_width) : (index, index) -> (index)
    %selected = template.apply<@combined_width>(%construction_width, %worker_width) : (index, index) -> (index)
    %exact_value = index.cast %exact : index to i32
    %selected_value = index.cast %selected : index to i32
    view.store %exact_value, %record[0] : i32, view<2xi32>
    view.store %selected_value, %record[1] : i32, view<2xi32>
    channel.publish %write : write<tile<2xi32>>
  }
}

// ----
test.target<low_core> @construction {subgroup_size = 64}

test.target<low_core> @worker {subgroup_size = 32}

template.decl @combined_width(%construction: index, %worker: index) -> (index)

pipeline.def public target(@construction) @publish_combined() run(%output: channel<tile<2xi32>>) {
  pipeline.strand target(@worker) workers([0], [1], [1]) {
    %write, %record = channel.reserve %output : channel<tile<2xi32>> -> (write<tile<2xi32>>, view<2xi32>)
    %exact_value = scalar.constant 96 : i32
    %selected_value = scalar.constant 96 : i32
    view.store %exact_value, %record[0] : i32, view<2xi32>
    view.store %selected_value, %record[1] : i32, view<2xi32>
    channel.publish %write : write<tile<2xi32>>
  }
}

// ====

// An explicit unresolved target cannot select the construction provider.
// An omitted target inherits that provider from its enclosing environment.
// RUN: pass select-templates
test.target<low_core> @construction {subgroup_size = 64}

target.decl @worker

template.decl @width_value() -> (i32)

template.def<@width_value> requires [#target.subgroup.size<64>] @width64() -> (i32) {
  %value = scalar.constant 64 : i32
  template.return %value : i32
}

pipeline.def public target(@construction) @publish_unknown() run(%first: channel<tile<1xi32>>, %second: channel<tile<1xi32>>) {
  pipeline.strand target(@worker) workers([0], [1], [1]) {
    %write, %record = channel.reserve %first : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %value = template.apply<@width_value>() : () -> (i32)
    view.store %value, %record[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
  pipeline.strand workers([1], [1], [1]) {
    %write, %record = channel.reserve %second : channel<tile<1xi32>> -> (write<tile<1xi32>>, view<1xi32>)
    %value = template.apply<@width_value>() : () -> (i32)
    view.store %value, %record[0] : i32, view<1xi32>
    channel.publish %write : write<tile<1xi32>>
  }
}

