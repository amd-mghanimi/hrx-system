// Two broad storage roots fit in the general bank even when one root has
// several destructive SSA versions. The later narrow value retains capacity.
// RUN: emit low-allocation @broad_tied_storage entry=0:test.explicit32:physical_register:2 entry=1:test.explicit32:physical_register:3

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @broad_tied_storage(%seed: reg<test.explicit32>, %peer: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>) asm {
  %first = test.rematerialize.tied.explicit32 %seed
  %last = test.rematerialize.tied.explicit32 %first
  %restricted = test.const.packed.narrow 7
  return %last, %peer, %restricted
}

// ----
low-allocation @broad_tied_storage
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 5
remarks: 0
spills: 0
copies: coalesced=0 materialized=0
entry moves: 0
classes:
  test.explicit32: assignments=4 units=4 target_ids=0 physical=4 spill_slots=0 unassigned=0
  test.packed.narrow: assignments=1 units=1 target_ids=0 physical=1 spill_slots=0 unassigned=0

// ====

// Three broad inputs coexist with one narrow storage root. Publishing three
// identity names does not require a second narrow register.
// RUN: emit low-allocation @narrow_tied_storage entry=0:test.explicit32:physical_register:1 entry=1:test.explicit32:physical_register:2 entry=2:test.explicit32:physical_register:3

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @narrow_tied_storage(%first: reg<test.explicit32>, %second: reg<test.explicit32>, %third: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>, reg<test.packed.narrow>, reg<test.packed.narrow>) asm {
  %seed = test.const.packed.narrow 7
  %alias = low.assume %seed [range(%seed, 0, 1024)] : reg<test.packed.narrow>
  %last = low.assume %alias [range(%alias, 0, 1024)] : reg<test.packed.narrow>
  return %first, %second, %third, %seed, %alias, %last
}

// ----
low-allocation @narrow_tied_storage
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 6
remarks: 0
spills: 0
copies: coalesced=0 materialized=0
entry moves: 0
classes:
  test.explicit32: assignments=3 units=3 target_ids=0 physical=4 spill_slots=0 unassigned=0
  test.packed.narrow: assignments=3 units=3 target_ids=0 physical=1 spill_slots=0 unassigned=0

// ====

// Two independent narrow roots still occupy distinct registers, including
// when both have required identity aliases.
// RUN: emit low-allocation @independent_narrow_storage entry=0:test.explicit32:physical_register:2 entry=1:test.explicit32:physical_register:3

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @independent_narrow_storage(%first: reg<test.explicit32>, %second: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>, reg<test.packed.narrow>, reg<test.packed.narrow>, reg<test.packed.narrow>) asm {
  %left = test.const.packed.narrow 7
  %right = test.const.packed.narrow 13
  %left_alias = low.assume %left [range(%left, 0, 1024)] : reg<test.packed.narrow>
  %right_alias = low.assume %right [range(%right, 0, 1024)] : reg<test.packed.narrow>
  return %first, %second, %left, %right, %left_alias, %right_alias
}

// ----
low-allocation @independent_narrow_storage
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 6
remarks: 0
spills: 0
copies: coalesced=0 materialized=0
entry moves: 0
classes:
  test.explicit32: assignments=2 units=2 target_ids=0 physical=4 spill_slots=0 unassigned=0
  test.packed.narrow: assignments=4 units=4 target_ids=0 physical=2 spill_slots=0 unassigned=0

// ====

// An optional copy with a live source retains separate storage demand. Its
// required alias shares the copied storage, not the original source.
// RUN: emit low-allocation @optional_copy_storage entry=0:test.explicit32:physical_register:2 entry=1:test.explicit32:physical_register:3

test.target<low_core> @target

low.func.def target<test.low.core>(@target) @optional_copy_storage(%first: reg<test.explicit32>, %second: reg<test.explicit32>) -> (reg<test.explicit32>, reg<test.explicit32>, reg<test.packed.narrow>, reg<test.packed.narrow>, reg<test.packed.narrow>) asm {
  %seed = test.const.packed.narrow 7
  %copy = copy %seed : reg<test.packed.narrow> -> reg<test.packed.narrow>
  %alias = low.assume %copy [range(%copy, 0, 1024)] : reg<test.packed.narrow>
  return %first, %second, %seed, %copy, %alias
}

// ----
low-allocation @optional_copy_storage
target: target
descriptor_set: test.low.core
mode: virtual
assignments: 5
remarks: 0
spills: 0
copies: coalesced=0 materialized=1
entry moves: 0
classes:
  test.explicit32: assignments=2 units=2 target_ids=0 physical=4 spill_slots=0 unassigned=0
  test.packed.narrow: assignments=3 units=3 target_ids=0 physical=2 spill_slots=0 unassigned=0
